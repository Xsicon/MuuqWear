@using Microsoft.AspNetCore.Components.Authorization
@using MuuqWear.Web.Components.Shared
@inject NavigationManager NavigationManager

@* remove <AuthInitializer /> *@
<Router AppAssembly="typeof(Program).Assembly">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayoutComponent)">
            <NotAuthorized>
                @if (NavigationManager.Uri.Contains("/admin", StringComparison.OrdinalIgnoreCase))
                {
                    <RedirectToAdminAccessDenied />
                }
                else
                {
                    @* Public marketing pages (e.g. /affiliate) must stay readable while logged out.
                       Only [Authorize] pages hit this branch — send them to login with returnUrl. *@
                    <RedirectToLogin />
                }
            </NotAuthorized>
            <Authorizing>
                @* Keep layout chrome; avoid a blank flash while auth resolves for guests. *@
            </Authorizing>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>404 - Not Found</PageTitle>
        <LayoutView Layout="typeof(Layout.MainLayoutComponent)">
            <RedirectToNotFound />
        </LayoutView>
    </NotFound>
</Router>