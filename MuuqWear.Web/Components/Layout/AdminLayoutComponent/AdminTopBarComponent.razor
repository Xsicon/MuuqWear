@rendermode InteractiveServer
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using Microsoft.JSInterop
@using MuuqWear.Application.Services.AffiliateService
@using MuuqWear.Application.Services.CustomerService
@using MuuqWear.Application.Services.NotificationService
@using MuuqWear.Application.Services.OrderService
@using MuuqWear.Application.Shared
@using MuuqWear.Model.Customer
@using MuuqWear.Model.Messages
@using MuuqWear.Model.NotificationModel
@using MuuqWear.Model.Products
@using MuuqWear.Web.Constants
@using MuuqWear.Web.Helpers
@using MuuqWear.Web.Services
@inject INotificationService NotificationService
@inject AdminLowStockCacheService LowStockCache
@inject IOrderService OrderService
@inject IAffiliateService AffiliateService
@inject ICustomerService CustomerService
@inject IJSRuntime JS
@inject AdminProductsTabCoordinator ProductsTabCoordinator
@inject AdminCustomersTabCoordinator CustomersTabCoordinator
@inject AdminOrdersTabCoordinator OrdersTabCoordinator
@inject NavigationManager NavigationManager
@inject AuthenticationStateProvider AuthStateProvider
@implements IDisposable

<header class="at-topbar">

    <div class="at-topbar__left">
        <!-- Mobile: open drawer -->
        <button type="button"
                class="at-topbar__btn at-topbar__btn--mobile"
                aria-label="Open navigation menu"
                onclick="window.adminSidebar.toggle()">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <line x1="4" x2="20" y1="6" y2="6"></line>
                <line x1="4" x2="20" y1="12" y2="12"></line>
                <line x1="4" x2="20" y1="18" y2="18"></line>
            </svg>
        </button>

        <!-- Desktop: collapse to icon rail -->
        <button type="button"
                class="at-topbar__btn at-topbar__btn--collapse"
                aria-label="Collapse sidebar"
                onclick="window.adminSidebar.toggleCollapsed()">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                <path d="M9 3v18"></path>
            </svg>
        </button>
    </div>

    <div class="at-topbar__search">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
             viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <circle cx="11" cy="11" r="8"></circle>
            <path d="m21 21-4.3-4.3"></path>
        </svg>
        <input class="at-topbar__search-input"
               type="search"
               placeholder="Search orders, customers, products..."
               @bind="searchQuery"
               @bind:event="oninput"
               @onkeydown="HandleSearchKeyDown" />
    </div>

    <div class="at-topbar__right">

        <!-- Theme toggle -->
        <button type="button"
                class="at-topbar__btn"
                aria-label="Toggle theme"
                onclick="window.adminSidebar.toggleTheme()">
            <svg class="at-theme-icon at-theme-icon--light" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3a6 6 0 0 0 9 9 9 9 0 1 1-9-9Z"></path>
            </svg>
            <svg class="at-theme-icon at-theme-icon--dark" xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="12" cy="12" r="4"></circle>
                <path d="M12 2v2"></path>
                <path d="M12 20v2"></path>
                <path d="m4.93 4.93 1.41 1.41"></path>
                <path d="m17.66 17.66 1.41 1.41"></path>
                <path d="M2 12h2"></path>
                <path d="M20 12h2"></path>
                <path d="m6.34 17.66-1.41 1.41"></path>
                <path d="m19.07 4.93-1.41 1.41"></path>
            </svg>
        </button>

        <!-- Notifications -->
        <div class="at-topbar__icon-wrap">
            <button type="button"
                    class="at-topbar__btn"
                    aria-label="Notifications"
                    aria-expanded="@isNotificationsOpen"
                    @onclick="ToggleNotifications">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10.268 21a2 2 0 0 0 3.464 0"></path>
                    <path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"></path>
                </svg>
                @if (unreadCount > 0)
                {
                    <span class="at-topbar__badge at-topbar__badge--yellow">@unreadCount</span>
                }
            </button>

            @if (isNotificationsOpen)
            {
                <div class="at-notif-dropdown">
                    <div class="at-notif-dropdown__header">
                        <span class="at-notif-dropdown__title">Notifications</span>
                        @if (notifications.Any())
                        {
                            <button type="button" class="at-notif-dropdown__mark-read" @onclick="MarkAllRead">
                                Mark All Read
                            </button>
                        }
                    </div>

                    <div class="at-notif-dropdown__body">
                    @if (isLoadingNotifications)
                    {
                        <div class="at-notif-dropdown__empty">Loading…</div>
                    }
                    else if (!notifications.Any())
                    {
                        <div class="at-notif-dropdown__empty">No new notifications.</div>
                    }
                    else
                    {
                        @foreach (var entry in GetNotificationsWithSections())
                        {
                            @if (entry.SectionLabel is not null)
                            {
                                <p class="at-notif-dropdown__section">@entry.SectionLabel</p>
                            }

                            var notif = entry.Notification;
                            <button type="button"
                                    class="at-notif-item @(notif.IsRead ? "" : "at-notif-item--unread")"
                                    @key="@($"{notif.Type}:{notif.Id}:{notif.CustomerId}")"
                                    @onclick="() => HandleNotificationClick(notif)">
                                <div class="at-notif-item__icon @GetNotifIconClass(notif.Type)">
                                    @GetNotifIcon(notif.Type)
                                </div>
                                <div class="at-notif-item__content">
                                    <p class="at-notif-item__message">@notif.Message</p>
                                    <p class="at-notif-item__time">@GetNotificationDetail(notif)</p>
                                </div>
                            </button>
                        }

                        @if (CanSeeSection(AdminPortalSection.Orders)
                             && pendingOrderCount > AdminHeaderOperationalNotificationsBuilder.MaxPendingOrders)
                        {
                            <button type="button"
                                    class="at-notif-dropdown__view-all"
                                    @onclick="ViewAllPendingOrders">
                                View all @pendingOrderCount pending orders
                            </button>
                        }

                        @if (CanSeeSection(AdminPortalSection.Affiliates)
                             && pendingAffiliateCount > AdminHeaderOperationalNotificationsBuilder.MaxPendingAffiliates)
                        {
                            <button type="button"
                                    class="at-notif-dropdown__view-all"
                                    @onclick="ViewAllPendingAffiliates">
                                View all @pendingAffiliateCount affiliate applications
                            </button>
                        }

                        @if (CanSeeCustomerNotes()
                             && customerMessageCount > AdminHeaderOperationalNotificationsBuilder.MaxCustomerMessages
                             && CustomerNotesListLink is not null)
                        {
                            <button type="button"
                                    class="at-notif-dropdown__view-all"
                                    @onclick="ViewAllCustomerNotes">
                                View all customer notes
                            </button>
                        }

                        @if (CanSeeSection(AdminPortalSection.Products)
                             && lowStockCount > notifications.Count(n =>
                                      AdminNotificationEnricher.IsLowStockNotification(n)))
                        {
                            <button type="button"
                                    class="at-notif-dropdown__view-all"
                                    @onclick="ViewAllLowStock">
                                View all @lowStockCount low-stock products
                            </button>
                        }
                    }
                    </div>
                </div>
            }
        </div>

        <!-- Messages (customer internal notes) -->
        @if (CanSeeCustomerNotes())
        {
        <div class="at-topbar__icon-wrap">
            <button type="button"
                    class="at-topbar__btn"
                    aria-label="Messages"
                    aria-expanded="@isMessagesOpen"
                    @onclick="ToggleMessages">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <rect width="20" height="16" x="2" y="4" rx="2"></rect>
                    <path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"></path>
                </svg>
                @if (unreadMessageCount > 0)
                {
                    <span class="at-topbar__badge at-topbar__badge--dark">@unreadMessageCount</span>
                }
            </button>

            @if (isMessagesOpen)
            {
                <div class="at-notif-dropdown">
                    <div class="at-notif-dropdown__header">
                        <span class="at-notif-dropdown__title">Messages</span>
                        @if (messages.Any(m => !m.IsRead))
                        {
                            <button type="button" class="at-notif-dropdown__mark-read" @onclick="MarkAllMessagesRead">
                                Mark All Read
                            </button>
                        }
                    </div>

                    <div class="at-notif-dropdown__body">
                    @if (isLoadingMessages)
                    {
                        <div class="at-notif-dropdown__empty">Loading…</div>
                    }
                    else if (!messages.Any())
                    {
                        <div class="at-notif-dropdown__empty">No customer notes yet.</div>
                    }
                    else
                    {
                        <p class="at-notif-dropdown__section">Recent notes (@messageCount)</p>

                        @if (customersFeedTruncated)
                        {
                            <p class="at-notif-dropdown__truncation">
                                Showing the first @AdminHeaderFeedLoader.MaxRecords of @customersTotalCount customers.
                                Counts may be incomplete.
                            </p>
                        }

                        @foreach (var message in messages)
                        {
                            <button type="button"
                                    class="at-notif-item @(message.IsRead ? "" : "at-notif-item--unread")"
                                    @key="message.Id"
                                    @onclick="() => HandleMessageClick(message)">
                                <div class="at-notif-item__icon at-notif-item__icon--note">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                                </div>
                                <div class="at-notif-item__content">
                                    <p class="at-notif-item__message">@message.CustomerName</p>
                                    <p class="at-notif-item__time">@GetMessageDetail(message)</p>
                                </div>
                            </button>
                        }

                        @if (CustomerNotesListLink is not null && messageCount > messages.Count)
                        {
                            <button type="button"
                                    class="at-notif-dropdown__view-all"
                                    @onclick="ViewAllCustomerNotes">
                                View all customer notes
                            </button>
                        }
                    }
                    </div>
                </div>
            }
        </div>
        }

        <!-- User menu -->
        <div class="at-topbar__icon-wrap">
            <button type="button" class="at-topbar__user-btn" aria-label="User menu" @onclick="ToggleUserMenu">
                <div class="at-topbar__avatar">@userInitials</div>
                <svg class="at-topbar__user-chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m6 9 6 6 6-6"></path>
                </svg>
            </button>

            @if (isUserMenuOpen)
            {
                <div class="at-user-dropdown">
                    <div class="at-user-dropdown__header">
                        <p class="at-user-dropdown__name">@userName</p>
                        <p class="at-user-dropdown__role">@userRoleDisplay</p>
                    </div>
                    <button type="button" class="at-user-dropdown__logout" @onclick="HandleLogout">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                            <polyline points="16 17 21 12 16 7"></polyline>
                            <line x1="21" x2="9" y1="12" y2="12"></line>
                        </svg>
                        Sign Out
                    </button>
                </div>
            }
        </div>

    </div>
</header>

@if (isNotificationsOpen || isMessagesOpen || isUserMenuOpen)
{
    <div class="at-topbar__overlay" @onclick="CloseAllDropdowns"></div>
}

@code {

    private string searchQuery = string.Empty;
    private bool isNotificationsOpen;
    private bool isMessagesOpen;
    private bool isUserMenuOpen;
    private bool isLoadingNotifications;
    private bool isLoadingMessages;
    private List<NotificationModel> notifications = new();
    private List<AdminMessageModel> messages = new();
    private List<(CustomerModel Customer, CustomerNoteModel Note)> loadedNoteEntries = new();
    private int unreadCount;
    private int unreadMessageCount;
    private int lowStockCount;
    private int pendingOrderCount;
    private int pendingAffiliateCount;
    private int customerMessageCount;
    private int messageCount;
    private bool customersFeedTruncated;
    private int customersTotalCount;
    private readonly HashSet<Guid> lowStockProductIds = new();
    private readonly HashSet<Guid> readNotificationIds = new();
    private readonly Dictionary<Guid, DateTime> readNoteAtByCustomerId = new();
    private readonly Dictionary<Guid, DateTime> lowStockFirstSeenAt = new();
    private AdminHeaderReadStateStore? readStateStore;
    private string userName = string.Empty;
    private string userInitials = "AD";
    private string userRoleDisplay = "Staff";
    private string? userRole;
    private System.Threading.Timer? _refreshTimer;
    private const int RefreshIntervalSeconds = 120;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        (userName, userInitials, userRoleDisplay) = AdminPortalUserContext.FromClaims(user);
        userRole = AdminPortalUserContext.GetRole(user);

        var userId = user.FindFirst("UserId")?.Value ?? string.Empty;

        ProductsTabCoordinator.BadgeCountsRefreshRequested += OnProductsChanged;
        CustomersTabCoordinator.MessagesRefreshRequested += OnCustomerNotesChanged;
        OrdersTabCoordinator.BadgeCountsRefreshRequested += OnOrdersChanged;

        readStateStore = new AdminHeaderReadStateStore(JS, userId);
        await LoadPersistedReadStateAsync();

        _refreshTimer = new System.Threading.Timer(
            _ => _ = InvokeAsync(RefreshBadgeCountsAsync),
            null,
            TimeSpan.FromSeconds(RefreshIntervalSeconds),
            TimeSpan.FromSeconds(RefreshIntervalSeconds));

        await RefreshBadgeCountsAsync();
    }

    private async Task LoadPersistedReadStateAsync()
    {
        if (readStateStore == null)
            return;

        var notificationIds = await readStateStore.LoadNotificationIdsAsync();
        foreach (var id in notificationIds)
            readNotificationIds.Add(id);

        var noteReadAt = await readStateStore.LoadNoteReadAtAsync();
        foreach (var (customerId, readAt) in noteReadAt)
            readNoteAtByCustomerId[customerId] = readAt;

        var firstSeen = await readStateStore.LoadLowStockFirstSeenAsync();
        foreach (var (productId, seenAt) in firstSeen)
            lowStockFirstSeenAt[productId] = seenAt;
    }

    private Task PersistReadStateAsync() =>
        readStateStore == null
            ? Task.CompletedTask
            : Task.WhenAll(
                readStateStore.SaveNotificationIdsAsync(readNotificationIds),
                readStateStore.SaveNoteReadAtAsync(readNoteAtByCustomerId),
                readStateStore.SaveLowStockFirstSeenAsync(lowStockFirstSeenAt));

    private void OnProductsChanged()
    {
        LowStockCache.Invalidate();
        _ = InvokeAsync(async () =>
        {
            if (isNotificationsOpen)
                await LoadNotifications();
            else
                await RefreshBadgeCountsAsync();
        });
    }

    private void OnOrdersChanged()
    {
        _ = InvokeAsync(async () =>
        {
            if (isNotificationsOpen)
                await LoadNotifications();
            else
                await RefreshBadgeCountsAsync();
        });
    }

    private void OnCustomerNotesChanged()
    {
        if (!CanSeeCustomerNotes())
            return;

        _ = InvokeAsync(async () =>
        {
            if (isMessagesOpen)
                await LoadMessages();

            if (isNotificationsOpen)
                await LoadNotifications();
            else
                await RefreshBadgeCountsAsync();
        });
    }

    private async Task RefreshBadgeCountsAsync()
    {
        try
        {
            await ApplyNotificationFeedAsync(forceRefreshLowStock: false, updateDropdownList: false);
        }
        catch
        {
            // Keep the last known badge counts when the lightweight refresh fails.
        }

        StateHasChanged();
    }

    private async Task LoadMessages()
    {
        if (!CanSeeCustomerNotes())
        {
            messages.Clear();
            unreadMessageCount = 0;
            return;
        }

        isLoadingMessages = true;
        StateHasChanged();

        var customerFeed = await AdminHeaderFeedLoader.LoadCustomersAsync(CustomerService);
        customersFeedTruncated = customerFeed.IsTruncated;
        customersTotalCount = customerFeed.TotalCount;

        var customers = customerFeed.Items;
        var customersWithNotes = customers
            .Where(c => c.LatestNoteAt.HasValue && !string.IsNullOrWhiteSpace(c.LatestNotePreview))
            .OrderByDescending(c => c.LatestNoteAt)
            .Take(AdminHeaderMessagesBuilder.NoteFetchCustomerLimit)
            .ToList();

        var noteTasks = customersWithNotes.Select(async customer =>
        {
            var result = await CustomerService.GetNotes(customer.Id);
            if (!result.Success || result.Data == null)
                return Array.Empty<(CustomerModel Customer, CustomerNoteModel Note)>();

            return result.Data
                .Select(note => (Customer: customer, Note: note))
                .ToArray();
        });

        var noteGroups = await Task.WhenAll(noteTasks);
        loadedNoteEntries = AdminHeaderMessagesBuilder.CapNotesPerCustomer(
            noteGroups.SelectMany(group => group));

        messageCount = loadedNoteEntries.Count;
        messages = AdminHeaderMessagesBuilder
            .FromNotes(loadedNoteEntries, readNoteAtByCustomerId)
            .OrderBy(m => m.IsRead)
            .ThenByDescending(m => m.CreatedAt)
            .ToList();

        unreadMessageCount = AdminHeaderMessagesBuilder.CountUnreadNotes(
            loadedNoteEntries,
            readNoteAtByCustomerId);

        isLoadingMessages = false;
        StateHasChanged();
    }

    private async Task LoadNotifications()
    {
        isLoadingNotifications = true;
        StateHasChanged();

        await ApplyNotificationFeedAsync(forceRefreshLowStock: true, updateDropdownList: true);

        isLoadingNotifications = false;
        await PersistReadStateAsync();
        StateHasChanged();
    }

    private async Task ApplyNotificationFeedAsync(bool forceRefreshLowStock, bool updateDropdownList)
    {
        var feed = await AdminHeaderNotificationFeedBuilder.BuildAsync(
            NotificationService,
            LowStockCache,
            OrderService,
            AffiliateService,
            CustomerService,
            readNotificationIds,
            readNoteAtByCustomerId,
            lowStockFirstSeenAt,
            userRole,
            forceRefreshLowStock);

        unreadCount = feed.UnreadCount;
        lowStockCount = feed.LowStockCount;
        pendingOrderCount = feed.PendingOrderCount;
        pendingAffiliateCount = feed.PendingAffiliateCount;
        customerMessageCount = feed.CustomerMessageCount;
        lowStockProductIds.Clear();
        foreach (var productId in feed.LowStockProductIds)
            lowStockProductIds.Add(productId);

        if (updateDropdownList)
            notifications = feed.Notifications;
    }

    private void ToggleNotifications()
    {
        isNotificationsOpen = !isNotificationsOpen;
        isMessagesOpen = false;
        isUserMenuOpen = false;

        if (isNotificationsOpen)
            _ = LoadNotifications();
    }

    private void ToggleMessages()
    {
        isMessagesOpen = !isMessagesOpen;
        isNotificationsOpen = false;
        isUserMenuOpen = false;

        if (isMessagesOpen)
            _ = LoadMessages();
    }

    private async Task MarkAllRead()
    {
        foreach (var n in notifications.ToList())
            MarkNotificationReadLocally(n);

        notifications.Clear();
        unreadCount = 0;
        SyncUnreadMessageCountFromNotes();
        StateHasChanged();
        await NotificationService.MarkAllRead();
        await PersistReadStateAsync();
    }

    private async Task HandleNotificationClick(NotificationModel notif)
    {
        MarkNotificationReadLocally(notif);
        notifications.Remove(notif);
        unreadCount = notifications.Count;
        SyncUnreadMessageCountFromNotes();
        isNotificationsOpen = false;
        StateHasChanged();

        if (notif.Type == NotificationType.CustomerMessage && notif.CustomerId is Guid customerId)
        {
            var linkHasCustomerFocus = notif.Link?.Contains("customerId=", StringComparison.OrdinalIgnoreCase) == true;
            if (!linkHasCustomerFocus)
                CustomersTabCoordinator.NotifyCustomerFocus(customerId);
        }

        var focusProductId = AdminNotificationEnricher.ResolveProductId(notif)
                             ?? (AdminNotificationEnricher.IsLowStockNotification(notif)
                                 && lowStockProductIds.Contains(notif.Id)
                                 ? notif.Id
                                 : (Guid?)null);

        var linkHasProductFocus = notif.Link?.Contains("productId=", StringComparison.OrdinalIgnoreCase) == true;
        if (focusProductId is Guid id && !linkHasProductFocus)
            ProductsTabCoordinator.NotifyProductFocus(id);

        await PersistReadStateAsync();

        var destination = ResolveNotificationDestination(notif);
        if (destination is not null)
            NavigationManager.NavigateTo(destination);
    }

    private async Task HandleMessageClick(AdminMessageModel message)
    {
        message.IsRead = true;
        AdminHeaderMessagesBuilder.MarkCustomerNoteRead(
            readNoteAtByCustomerId,
            message.CustomerId,
            message.CreatedAt);

        unreadMessageCount = AdminHeaderMessagesBuilder.CountUnreadNotes(
            loadedNoteEntries,
            readNoteAtByCustomerId);
        isMessagesOpen = false;

        var linkHasCustomerFocus = message.Link.Contains("customerId=", StringComparison.OrdinalIgnoreCase);
        if (!linkHasCustomerFocus)
            CustomersTabCoordinator.NotifyCustomerFocus(message.CustomerId);

        await PersistReadStateAsync();

        var destination = AdminHeaderNotificationAccess.ResolveLink(userRole, message.Link);
        if (destination is not null)
            NavigationManager.NavigateTo(destination);
    }

    private async Task MarkAllMessagesRead()
    {
        AdminHeaderMessagesBuilder.MarkAllNotesRead(loadedNoteEntries, readNoteAtByCustomerId);

        foreach (var message in messages)
            message.IsRead = true;

        unreadMessageCount = 0;
        StateHasChanged();
        await PersistReadStateAsync();
    }

    private void ViewAllCustomerNotes()
    {
        var destination = CustomerNotesListLink;
        if (destination is null)
            return;

        isMessagesOpen = false;
        isNotificationsOpen = false;
        NavigationManager.NavigateTo(destination);
    }

    private static string GetMessageDetail(AdminMessageModel message)
    {
        var preview = string.IsNullOrWhiteSpace(message.Preview)
            ? "Internal note"
            : message.Preview;

        if (preview.Length > 72)
            preview = preview[..72].TrimEnd() + "…";

        return $"{message.AuthorLabel} · {preview} · {message.TimeDisplay}";
    }

    private void ViewAllLowStock()
    {
        if (!CanSeeSection(AdminPortalSection.Products))
            return;

        isNotificationsOpen = false;
        NavigationManager.NavigateTo("/admin/products?view=low-stock");
    }

    private void ViewAllPendingOrders()
    {
        if (!CanSeeSection(AdminPortalSection.Orders))
            return;

        isNotificationsOpen = false;
        NavigationManager.NavigateTo("/admin/orders?tab=orders&status=pending");
    }

    private void ViewAllPendingAffiliates()
    {
        if (!CanSeeSection(AdminPortalSection.Affiliates))
            return;

        isNotificationsOpen = false;
        NavigationManager.NavigateTo("/admin/affiliates?tab=pending");
    }

    private string? ResolveNotificationDestination(NotificationModel notif)
    {
        var linkDestination = AdminHeaderNotificationAccess.ResolveLink(userRole, notif.Link);
        if (linkDestination is not null)
            return linkDestination;

        if (AdminNotificationEnricher.IsLowStockNotification(notif)
            && CanSeeSection(AdminPortalSection.Products))
            return "/admin/products?view=low-stock";

        return null;
    }

    private bool CanSeeSection(string section) =>
        AdminPortalRoles.CanAccess(userRole, section);

    private bool CanSeeCustomerNotes() =>
        AdminHeaderNotificationAccess.CanSeeCustomerNotes(userRole);

    private string? CustomerNotesListLink =>
        AdminHeaderNotificationAccess.GetCustomerNotesListLink(userRole);

    private void MarkNotificationReadLocally(NotificationModel notif)
    {
        if (notif.Type == NotificationType.CustomerMessage && notif.CustomerId is Guid customerId)
        {
            AdminHeaderMessagesBuilder.MarkCustomerNoteRead(
                readNoteAtByCustomerId,
                customerId,
                notif.CreatedAt);
            return;
        }

        if (notif.Id != Guid.Empty)
            readNotificationIds.Add(notif.Id);

        if (notif.SizeStockId is Guid sizeStockId)
            readNotificationIds.Add(sizeStockId);

        if (notif.ProductId is Guid productId)
            readNotificationIds.Add(productId);
    }

    private void SyncUnreadMessageCountFromNotes()
    {
        if (loadedNoteEntries.Count == 0)
            return;

        unreadMessageCount = AdminHeaderMessagesBuilder.CountUnreadNotes(
            loadedNoteEntries,
            readNoteAtByCustomerId);

        foreach (var message in messages)
        {
            message.IsRead = AdminHeaderMessagesBuilder.IsNoteRead(
                new CustomerNoteModel
                {
                    CustomerId = message.CustomerId,
                    CreatedAt = message.CreatedAt
                },
                readNoteAtByCustomerId);
        }
    }

    private string GetNotificationSection(string type) => type switch
    {
        NotificationType.Order => $"Pending orders ({pendingOrderCount})",
        NotificationType.Affiliate => $"Affiliate applications ({pendingAffiliateCount})",
        NotificationType.CustomerMessage => $"Customer notes ({customerMessageCount})",
        NotificationType.LowStock or NotificationType.Stock => $"Low stock ({lowStockCount})",
        _ when type.Contains("stock", StringComparison.OrdinalIgnoreCase) => $"Low stock ({lowStockCount})",
        _ => "Other"
    };

    private IEnumerable<(string? SectionLabel, NotificationModel Notification)> GetNotificationsWithSections()
    {
        string? lastSectionLabel = null;

        foreach (var notif in notifications)
        {
            var sectionLabel = GetNotificationSection(notif.Type);
            string? header = null;

            if (!string.Equals(sectionLabel, lastSectionLabel, StringComparison.Ordinal))
            {
                lastSectionLabel = sectionLabel;
                header = sectionLabel;
            }

            yield return (header, notif);
        }
    }

    private static string GetNotificationDetail(NotificationModel notif)
    {
        if (AdminNotificationEnricher.IsLowStockNotification(notif))
        {
            if (!string.IsNullOrWhiteSpace(notif.TimeAgo))
                return notif.TimeAgo;

            if (!string.IsNullOrWhiteSpace(notif.SizeLabel))
                return $"Size {notif.SizeLabel} · tap to restock";
        }

        if (!string.IsNullOrWhiteSpace(notif.TimeAgo))
            return $"{notif.TimeAgo} · {notif.TimeDisplay}";

        return notif.TimeDisplay;
    }

    private void HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Enter" || string.IsNullOrWhiteSpace(searchQuery)) return;

        var query = searchQuery.Trim();
        var url = DetectSearchUrl(query);
        searchQuery = string.Empty;

        if (AdminPortalRouteAccess.CanAccessPath(userRole, url))
            NavigationManager.NavigateTo(url);
        else
            NavigationManager.NavigateTo("/admin/access-denied");
    }

    private static string DetectSearchUrl(string query)
    {
        if (query.StartsWith("MQ-", StringComparison.OrdinalIgnoreCase) ||
            query.StartsWith("#MQ-", StringComparison.OrdinalIgnoreCase))
            return $"/admin/orders?search={Uri.EscapeDataString(query)}";

        if (query.Contains('@'))
            return $"/admin/orders?search={Uri.EscapeDataString(query)}";

        if (query.StartsWith("TKT-", StringComparison.OrdinalIgnoreCase))
            return $"/admin/tickets?search={Uri.EscapeDataString(query)}";

        return $"/admin/products?search={Uri.EscapeDataString(query)}";
    }

    private void ToggleUserMenu()
    {
        isUserMenuOpen = !isUserMenuOpen;
        isNotificationsOpen = false;
        isMessagesOpen = false;
    }

    private void HandleLogout()
    {
        NavigationManager.NavigateTo("/auth/clear", forceLoad: true);
    }

    private void CloseAllDropdowns()
    {
        isNotificationsOpen = false;
        isMessagesOpen = false;
        isUserMenuOpen = false;
    }

