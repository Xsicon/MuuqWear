    private void NavigateToCareersTab(string tab)
    {
        var normalized = AdminCareersTabCoordinator.NormalizeTab(tab);
        NavigationManager.NavigateTo($"/admin/careers?tab={normalized}");
        CareersTabCoordinator.NotifyTabChanged(normalized);
    }

    private bool IsCareersSectionActive
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/').ToLowerInvariant();
            return path.StartsWith("admin/careers", StringComparison.Ordinal)
                || path.StartsWith("admin/jobs", StringComparison.Ordinal);
        }
    }

    private bool IsCareersTabActive(string tab)
    {
        if (!IsCareersSectionActive)
            return false;

        var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).Trim('/').ToLowerInvariant();
        if (path.Contains("/applications", StringComparison.Ordinal)
            && path.StartsWith("admin/jobs", StringComparison.Ordinal))
            return tab == "applications";

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("tab", out var value) || string.IsNullOrEmpty(value))
            return tab == "postings";

        return value.ToString().Equals(tab, StringComparison.OrdinalIgnoreCase);
    }

