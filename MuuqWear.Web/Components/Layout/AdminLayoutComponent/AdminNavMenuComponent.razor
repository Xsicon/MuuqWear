@code {
    [Parameter] public EventCallback OnLinkClicked { get; set; }

    private string userName = string.Empty;
    private string userInitials = "AD";
    private string userRoleDisplay = "Staff";
    private string? userRole;
    private int openTickets = 0;
    private int unreadLiveChatCount;
    private AdminBadgeCountsModel? counts;
    private string? navCountsWarning;
    private int lowStockCount = 0;
    private readonly Dictionary<Guid, DateTime> readChatAtBySessionId = new();
    private AdminHeaderReadStateStore? readStateStore;
    private bool salesOrdersOpen;
    private bool productsInventoryOpen;
    private bool customersOpen;
    private bool contentOpen;
    private bool affiliatesOpen;
    private bool supportOpen;
    private bool careersOpen;
    private bool systemTechOpen;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider
            .GetAuthenticationStateAsync();
        var user = authState.User;
        (userName, userInitials, userRoleDisplay) = AdminPortalUserContext.FromClaims(user);
        userRole = AdminPortalUserContext.GetRole(user);

        if (CanSeeSection(AdminPortalSection.Support))
        {
            readStateStore = new AdminHeaderReadStateStore(JS, AdminHeaderUserScope.GetUserId(user));
            foreach (var entry in await readStateStore.LoadChatReadAtAsync())
                readChatAtBySessionId[entry.Key] = entry.Value;
        }

        var loadTasks = new List<Task>();
        if (NeedsBadgeCounts)
            loadTasks.Add(RefreshBadgeCountsAsync());
        if (NeedsLowStockCount)
            loadTasks.Add(RefreshLowStockCountAsync());
        if (CanSeeSection(AdminPortalSection.Support))
            loadTasks.Add(RefreshLiveChatUnreadBadgeAsync());
        if (loadTasks.Count > 0)
            await Task.WhenAll(loadTasks);

        NavigationManager.LocationChanged += OnLocationChanged;
        OrdersTabCoordinator.BadgeCountsRefreshRequested += OnBadgeCountsRefreshRequested;
        ProductsTabCoordinator.BadgeCountsRefreshRequested += OnProductsBadgeCountsRefreshRequested;
        SupportTabCoordinator.BadgeCountsRefreshRequested += OnSupportBadgeRefreshRequested;
        SupportTabCoordinator.SessionReadRequested += OnLiveChatSessionRead;
        SyncSalesOrdersGroup();
        SyncProductsInventoryGroup();
        SyncCustomersGroup();
        SyncContentGroup();
        SyncAffiliatesGroup();
        SyncSupportGroup();
        SyncCareersGroup();
        SyncSystemTechGroup();
    }

    private void OnBadgeCountsRefreshRequested()
    {
        if (!NeedsBadgeCounts)
            return;

        _ = InvokeAsync(async () =>
        {
            BadgeCountsCache.Invalidate();
            await RefreshBadgeCountsAsync(forceRefresh: true);
            StateHasChanged();
        });
    }

    private void OnProductsBadgeCountsRefreshRequested()
    {
        if (!NeedsLowStockCount)
            return;

        _ = InvokeAsync(async () =>
        {
            LowStockCache.Invalidate();
            await RefreshLowStockCountAsync(forceRefresh: true);
            StateHasChanged();
        });
    }

    private void OnSupportBadgeRefreshRequested()
    {
        if (!CanSeeSection(AdminPortalSection.Support))
            return;

        _ = InvokeAsync(async () =>
        {
            await RefreshLiveChatUnreadBadgeAsync();
            StateHasChanged();
        });
    }

    private void OnLiveChatSessionRead(Guid sessionId, DateTime lastActivity)
    {
        if (!CanSeeSection(AdminPortalSection.Support))
            return;

        AdminHeaderLiveChatMessagesBuilder.MarkSessionRead(
            readChatAtBySessionId,
            sessionId,
            lastActivity);

        _ = InvokeAsync(async () =>
        {
            await RefreshLiveChatUnreadBadgeAsync();
            StateHasChanged();
        });
    }

    private async Task RefreshLiveChatUnreadBadgeAsync()
    {
        if (!CanSeeSection(AdminPortalSection.Support))
        {
            unreadLiveChatCount = 0;
            return;
        }

        try
        {
            var result = await ChatService.GetActiveSessions();
            if (result.Success && result.Data != null)
            {
                unreadLiveChatCount = AdminHeaderLiveChatMessagesBuilder.CountUnreadSessions(
                    result.Data,
                    readChatAtBySessionId);
            }
            else
            {
                unreadLiveChatCount = 0;
            }
        }
        catch
        {
            // Keep the last known unread count when refresh fails.
        }
    }

    private async Task RefreshBadgeCountsAsync(bool forceRefresh = false)
    {
        counts = await BadgeCountsCache.GetCountsAsync(forceRefresh);
        if (counts != null)
            openTickets = counts.OpenTickets;

        UpdateNavCountsWarning();
    }

    private async Task RefreshLowStockCountAsync(bool forceRefresh = false)
    {
        lowStockCount = await LowStockCache.GetCountAsync(forceRefresh);
        UpdateNavCountsWarning();
    }

    private void UpdateNavCountsWarning()
    {
        var warnings = new List<string>();
        if (NeedsBadgeCounts && !string.IsNullOrWhiteSpace(BadgeCountsCache.LastError))
            warnings.Add(BadgeCountsCache.LastError);
        if (NeedsLowStockCount && !string.IsNullOrWhiteSpace(LowStockCache.LastError))
            warnings.Add(LowStockCache.LastError);

        navCountsWarning = warnings.Count == 0 ? null : string.Join(" ", warnings.Distinct());
    }

    private bool CanSeeSection(string section) =>
        AdminPortalRoles.CanAccess(userRole, section);

    private bool NeedsBadgeCounts =>
        CanSeeSection(AdminPortalSection.Orders)
        || CanSeeSection(AdminPortalSection.Customers)
        || CanSeeSection(AdminPortalSection.Affiliates)
        || CanSeeSection(AdminPortalSection.Support);

    private bool NeedsLowStockCount =>
        CanSeeSection(AdminPortalSection.Products);

