@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.WebUtilities
@using MuuqWear.Application.Services.AdminBadgeService
@using MuuqWear.Application.Services.ProductService
@using MuuqWear.Application.Shared
@using MuuqWear.Model.AdminBadgeCount
@using MuuqWear.Model.Products
@using MuuqWear.Web.Services
@inject AuthenticationStateProvider AuthStateProvider
@inject AdminBadgeCountsCacheService BadgeCountsCache
@inject AdminLowStockCacheService LowStockCache
@inject NavigationManager NavigationManager
@inject AdminOrdersTabCoordinator OrdersTabCoordinator
@inject AdminProductsTabCoordinator ProductsTabCoordinator
@inject AdminCustomersTabCoordinator CustomersTabCoordinator
@inject AdminContentTabCoordinator ContentTabCoordinator
@inject AdminAffiliatesTabCoordinator AffiliatesTabCoordinator
@rendermode InteractiveServer
@implements IDisposable

<!-- ─── BRAND ──────────────────────────────────────────── -->
<div class="an-brand">
    <div class="an-brand__mark" aria-hidden="true">M</div>
    <div class="an-brand__full">
        <p class="an-brand__name">Muuqwear</p>
        <p class="an-brand__sub">Internal Dashboard</p>
    </div>
</div>

<!-- ─── USER ───────────────────────────────────────────── -->
<div class="an-user">
    <div class="an-user__avatar">@userInitials</div>
    <div class="an-user__info">
        <p class="an-user__name">@userName</p>
        <p class="an-user__role">Admin</p>
    </div>
</div>

<!-- ─── NAV ────────────────────────────────────────────── -->
<nav class="an-nav">

    <NavLink href="/admin"
             class="an-nav__item"
             Match="NavLinkMatch.All"
             title="Overview"
             onclick="window.adminSidebar.close()">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
             viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 3v16a2 2 0 0 0 2 2h16"></path>
            <path d="M18 17V9"></path>
            <path d="M13 17V5"></path>
            <path d="M8 17v-3"></path>
        </svg>
        <span class="an-nav__label">Overview</span>
    </NavLink>

    <!-- Sales & Orders (expandable) -->
    <div class="an-nav-group @(salesOrdersOpen ? "an-nav-group--open" : "")">
        <button type="button"
                class="an-nav-group__header @(IsSalesOrdersSectionActive ? "an-nav-group__header--active" : "")"
                aria-expanded="@salesOrdersOpen"
                @onclick="ToggleSalesOrders">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="8" cy="21" r="1"></circle>
                <circle cx="19" cy="21" r="1"></circle>
                <path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path>
            </svg>
            <span class="an-nav__label">Sales &amp; Orders</span>
            @if (counts is not null && counts.PendingOrders > 0)
            {
                <span class="an-nav__badge an-nav__badge--red">@counts.PendingOrders</span>
            }
            <svg class="an-nav-group__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </button>
        @if (salesOrdersOpen)
        {
            <div class="an-nav-group__children">
                <button type="button"
                        class="an-nav__subitem @(IsOrdersTabActive("orders") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToOrdersTab("orders")'>
                    All Orders
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsOrdersTabActive("returns") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToOrdersTab("returns")'>
                    Process Returns
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsOrdersTabActive("refunds") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToOrdersTab("refunds")'>
                    Refunds
                </button>
            </div>
        }
    </div>

    <!-- Customers (expandable) -->
    <div class="an-nav-group @(customersOpen ? "an-nav-group--open" : "")">
        <button type="button"
                class="an-nav-group__header @(IsCustomersSectionActive ? "an-nav-group__header--active" : "")"
                aria-expanded="@customersOpen"
                @onclick="ToggleCustomers">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                <circle cx="9" cy="7" r="4"></circle>
                <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
            </svg>
            <span class="an-nav__label">Customers</span>
            @if (counts is not null && counts.TotalCustomers > 0)
            {
                <span class="an-nav__badge">@counts.TotalCustomers</span>
            }
            <svg class="an-nav-group__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </button>
        @if (customersOpen)
        {
            <div class="an-nav-group__children">
                <button type="button"
                        class="an-nav__subitem @(IsCustomersViewActive("list") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToCustomersView("list")'>
                    Customer List
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsCustomersViewActive("details") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToCustomersView("details")'>
                    Customer Details
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsCustomersViewActive("notes") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToCustomersView("notes")'>
                    Customer Notes
                </button>
            </div>
        }
    </div>

    <!-- Products & Inventory (expandable) -->
    <div class="an-nav-group @(productsInventoryOpen ? "an-nav-group--open" : "")">
        <button type="button"
                class="an-nav-group__header @(IsProductsSectionActive ? "an-nav-group__header--active" : "")"
                aria-expanded="@productsInventoryOpen"
                @onclick="ToggleProductsInventory">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path>
                <circle cx="7.5" cy="7.5" r=".5" fill="currentColor"></circle>
            </svg>
            <span class="an-nav__label">Products &amp; Inventory</span>
            @if (lowStockCount > 0)
            {
                <span class="an-nav__badge an-nav__badge--yellow">@lowStockCount</span>
            }
            <svg class="an-nav-group__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </button>
        @if (productsInventoryOpen)
        {
            <div class="an-nav-group__children">
                <button type="button"
                        class="an-nav__subitem @(IsProductsViewActive("catalog") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToProductsView("catalog")'>
                    Product Catalog
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsProductsViewActive("stock") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToProductsView("stock")'>
                    Stock Levels
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsProductsViewActive("low-stock") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToProductsView("low-stock")'>
                    Low Stock Alerts
                    @if (lowStockCount > 0)
                    {
                        <span class="an-nav__subitem-badge">@lowStockCount</span>
                    }
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsProductsViewActive("restock") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToProductsView("restock")'>
                    Restock Requests
                </button>
            </div>
        }
    </div>

    <!-- Content (expandable) -->
    <div class="an-nav-group @(contentOpen ? "an-nav-group--open" : "")">
        <button type="button"
                class="an-nav-group__header @(IsContentSectionActive ? "an-nav-group__header--active" : "")"
                aria-expanded="@contentOpen"
                @onclick="ToggleContent">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"></path>
                <path d="M18.375 2.625a1 1 0 0 1 3 3l-9.013 9.014a2 2 0 0 1-.853.505l-2.873.84a.5.5 0 0 1-.62-.62l.84-2.873a2 2 0 0 1 .506-.852z"></path>
            </svg>
            <span class="an-nav__label">Content</span>
            <svg class="an-nav-group__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </button>
        @if (contentOpen)
        {
            <div class="an-nav-group__children">
                <button type="button"
                        class="an-nav__subitem @(IsContentViewActive("journal") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToContentView("journal")'>
                    Journal Articles
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsContentViewActive("events") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToContentView("events")'>
                    Events
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsContentViewActive("design-history") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToContentView("design-history")'>
                    Design History
                </button>
            </div>
        }
    </div>

    <!-- Affiliates (expandable) -->
    <div class="an-nav-group @(affiliatesOpen ? "an-nav-group--open" : "")">
        <button type="button"
                class="an-nav-group__header @(IsAffiliatesSectionActive ? "an-nav-group__header--active" : "")"
                aria-expanded="@affiliatesOpen"
                @onclick="ToggleAffiliates">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m11 17 2 2a1 1 0 1 0 3-3"></path>
                <path d="m14 14 2.5 2.5a1 1 0 1 0 3-3l-3.88-3.88a3 3 0 0 0-4.24 0l-.88.88a1 1 0 1 1-3-3l2.81-2.81a5.79 5.79 0 0 1 7.06-.87l.47.28a2 2 0 0 0 1.42.25L21 4"></path>
                <path d="m21 3 1 11h-2"></path>
                <path d="M3 3 2 14l6.5 6.5a1 1 0 1 0 3-3"></path>
                <path d="M3 4h8"></path>
            </svg>
            <span class="an-nav__label">Affiliates</span>
            @if (counts is not null && counts.AffiliateCounts.Pending > 0)
            {
                <span class="an-nav__badge an-nav__badge--red">@counts.AffiliateCounts.Pending</span>
            }
            <svg class="an-nav-group__chevron" xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="m6 9 6 6 6-6"></path>
            </svg>
        </button>
        @if (affiliatesOpen)
        {
            <div class="an-nav-group__children">
                <button type="button"
                        class="an-nav__subitem @(IsAffiliatesTabActive("pending") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToAffiliatesTab("pending")'>
                    Pending Applications
                    @if (counts is not null && counts.AffiliateCounts.Pending > 0)
                    {
                        <span class="an-nav__badge an-nav__badge--red">@counts.AffiliateCounts.Pending</span>
                    }
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsAffiliatesTabActive("active") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToAffiliatesTab("active")'>
                    Active Affiliates
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsAffiliatesTabActive("payouts") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToAffiliatesTab("payouts")'>
                    Payouts
                    @if (counts is not null && counts.AffiliateCounts.PendingPayouts > 0)
                    {
                        <span class="an-nav__badge an-nav__badge--red">@counts.AffiliateCounts.PendingPayouts</span>
                    }
                </button>
                <button type="button"
                        class="an-nav__subitem @(IsAffiliatesTabActive("tiers") ? "an-nav__subitem--active" : "")"
                        @onclick='() => NavigateToAffiliatesTab("tiers")'>
                    Tier Settings
                </button>
            </div>
        }
    </div>


    <NavLink href="/admin/live-chat"
             class="an-nav__item"
             title="Live Chat"
             onclick="window.adminSidebar.close()">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
             viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path>
        </svg>
        <span class="an-nav__label">Live Chat</span>
        @if (counts is not null && counts.ActiveChats > 0)
        {
            <span class="an-nav__badge an-nav__badge--green">@counts.ActiveChats</span>
        }
    </NavLink>



    <NavLink href="/admin/tickets"
             class="an-nav__item"
             title="Support Tickets"
             onclick="window.adminSidebar.close()">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
             viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path>
            <path d="M14 2v4a2 2 0 0 0 2 2h4"></path>
            <path d="M10 9H8"></path>
            <path d="M16 13H8"></path>
            <path d="M16 17H8"></path>
        </svg>
        <span class="an-nav__label">Support Tickets</span>
        @if (openTickets > 0)
        {
            <span class="an-nav__badge an-nav__badge--yellow">@openTickets</span>
        }
    </NavLink>

    <NavLink href="/admin/analytics"
             class="an-nav__item"
             title="Analytics"
             onclick="window.adminSidebar.close()">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
             viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="22 7 13.5 15.5 8.5 10.5 2 17"></polyline>
            <polyline points="16 7 22 7 22 13"></polyline>
        </svg>
        <span class="an-nav__label">Analytics</span>
    </NavLink>

    <NavLink href="/admin/settings"
             class="an-nav__item"
             title="Settings"
             onclick="window.adminSidebar.close()">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
             viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
            <circle cx="12" cy="12" r="3"></circle>
        </svg>
        <span class="an-nav__label">Settings</span>
    </NavLink>

    <NavLink href="/admin/jobs"
             class="an-nav__item"
             title="Careers"
             onclick="window.adminSidebar.close()">
        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-briefcase">
            <path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path>
            <rect width="20" height="14" x="2" y="6" rx="2">

            </rect>
        </svg>
        <span class="an-nav__label">Careers</span>
    </NavLink>

</nav>

@code {
    [Parameter] public EventCallback OnLinkClicked { get; set; }

    private string userName = string.Empty;
    private string userInitials = "AD";
    private int openTickets = 0;
    private int lowStockCount = 0;
    private AdminBadgeCountsModel? counts;
    private bool salesOrdersOpen;
    private bool productsInventoryOpen;
    private bool customersOpen;
    private bool contentOpen;
    private bool affiliatesOpen;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider
            .GetAuthenticationStateAsync();
        var user = authState.User;

        userName = user.FindFirst("FullName")?.Value
                   ?? user.FindFirst("name")?.Value
                   ?? "Admin";

        var parts = userName.Trim()
            .Split(' ', StringSplitOptions.RemoveEmptyEntries);

        userInitials = parts.Length >= 2
            ? $"{parts[0][0]}{parts[^1][0]}".ToUpper()
            : parts[0][..Math.Min(2, parts[0].Length)].ToUpper();

        var badgeTask = RefreshBadgeCountsAsync();
        var lowStockTask = RefreshLowStockCountAsync();
        await Task.WhenAll(badgeTask, lowStockTask);

        NavigationManager.LocationChanged += OnLocationChanged;
        OrdersTabCoordinator.BadgeCountsRefreshRequested += OnBadgeCountsRefreshRequested;
        ProductsTabCoordinator.BadgeCountsRefreshRequested += OnProductsBadgeCountsRefreshRequested;
        SyncSalesOrdersGroup();
        SyncProductsInventoryGroup();
        SyncCustomersGroup();
        SyncContentGroup();
        SyncAffiliatesGroup();
    }

    private void OnBadgeCountsRefreshRequested()
    {
        _ = InvokeAsync(async () =>
        {
            BadgeCountsCache.Invalidate();
            await RefreshBadgeCountsAsync(forceRefresh: true);
            StateHasChanged();
        });
    }

    private void OnProductsBadgeCountsRefreshRequested()
    {
        _ = InvokeAsync(async () =>
        {
            LowStockCache.Invalidate();
            await RefreshLowStockCountAsync(forceRefresh: true);
            StateHasChanged();
        });
    }

    private async Task RefreshBadgeCountsAsync(bool forceRefresh = false)
    {
        counts = await BadgeCountsCache.GetCountsAsync(forceRefresh);
        if (counts != null)
            openTickets = counts.OpenTickets;
    }

    private async Task RefreshLowStockCountAsync(bool forceRefresh = false)
    {
        lowStockCount = await LowStockCache.GetCountAsync(forceRefresh);
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        SyncSalesOrdersGroup();
        SyncProductsInventoryGroup();
        SyncCustomersGroup();
        SyncContentGroup();
        SyncAffiliatesGroup();
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncSalesOrdersGroup()
    {
        if (IsSalesOrdersSectionActive)
            salesOrdersOpen = true;
    }

    private void SyncProductsInventoryGroup()
    {
        if (IsProductsSectionActive)
            productsInventoryOpen = true;
    }

    private void SyncCustomersGroup()
    {
        if (IsCustomersSectionActive)
            customersOpen = true;
    }

    private void SyncContentGroup()
    {
        if (IsContentSectionActive)
            contentOpen = true;
    }

    private void SyncAffiliatesGroup()
    {
        if (IsAffiliatesSectionActive)
            affiliatesOpen = true;
    }

    private void ToggleAffiliates()
    {
        affiliatesOpen = !affiliatesOpen;
    }

    private void NavigateToAffiliatesTab(string tab)
    {
        var normalized = AdminAffiliatesTabCoordinator.NormalizeTab(tab);
        NavigationManager.NavigateTo($"/admin/affiliates?tab={normalized}");
        AffiliatesTabCoordinator.NotifyTabChanged(normalized);
    }

    private bool IsAffiliatesSectionActive =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("admin/affiliates", StringComparison.OrdinalIgnoreCase);

    private bool IsAffiliatesTabActive(string tab)
    {
        if (!IsAffiliatesSectionActive)
            return false;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("tab", out var value) || string.IsNullOrEmpty(value))
            return tab == "pending";

        return value.ToString().Equals(tab, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleCustomers()
    {
        customersOpen = !customersOpen;
    }

    private void NavigateToCustomersView(string view)
    {
        NavigationManager.NavigateTo($"/admin/customers?view={view}");
        CustomersTabCoordinator.NotifyViewChanged(view);
    }

    private bool IsCustomersSectionActive =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("admin/customers", StringComparison.OrdinalIgnoreCase);

    private bool IsCustomersViewActive(string view)
    {
        if (!IsCustomersSectionActive)
            return false;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("view", out var value) || string.IsNullOrEmpty(value))
            return view == "list";

        return value.ToString().Equals(view, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleProductsInventory()
    {
        productsInventoryOpen = !productsInventoryOpen;
    }

    private void NavigateToProductsView(string view)
    {
        NavigationManager.NavigateTo($"/admin/products?view={view}");
        ProductsTabCoordinator.NotifyViewChanged(view);
    }

    private bool IsProductsSectionActive =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("admin/products", StringComparison.OrdinalIgnoreCase);

    private bool IsProductsViewActive(string view)
    {
        if (!IsProductsSectionActive)
            return false;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("view", out var value) || string.IsNullOrEmpty(value))
            return view == "catalog";

        return value.ToString().Equals(view, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleContent()
    {
        contentOpen = !contentOpen;
    }

    private void NavigateToContentView(string view)
    {
        NavigationManager.NavigateTo($"/admin/content?view={view}");
    }

    private bool IsContentSectionActive =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("admin/content", StringComparison.OrdinalIgnoreCase);

    private bool IsContentViewActive(string view)
    {
        if (!IsContentSectionActive)
            return false;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("view", out var value) || string.IsNullOrEmpty(value))
            return view == "journal";

        return value.ToString().Equals(view, StringComparison.OrdinalIgnoreCase);
    }

    private void ToggleSalesOrders()
    {
        salesOrdersOpen = !salesOrdersOpen;
    }

    private void NavigateToOrdersTab(string tab)
    {
        NavigationManager.NavigateTo($"/admin/orders?tab={tab}");
        OrdersTabCoordinator.NotifyTabChanged(tab);
    }

    private bool IsSalesOrdersSectionActive =>
        NavigationManager.ToBaseRelativePath(NavigationManager.Uri)
            .StartsWith("admin/orders", StringComparison.OrdinalIgnoreCase);

    private bool IsOrdersTabActive(string tab)
    {
        if (!IsSalesOrdersSectionActive)
            return false;

        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("tab", out var value) || string.IsNullOrEmpty(value))
            return tab == "orders";

        return value.ToString().Equals(tab, StringComparison.OrdinalIgnoreCase);
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= OnLocationChanged;
        OrdersTabCoordinator.BadgeCountsRefreshRequested -= OnBadgeCountsRefreshRequested;
        ProductsTabCoordinator.BadgeCountsRefreshRequested -= OnProductsBadgeCountsRefreshRequested;
    }
}
