@inject IJSRuntime JS

@code {
    [Parameter] public string[] Scripts { get; set; } = Array.Empty<string>();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || Scripts.Length == 0)
            return;

        try
        {
            await JS.InvokeVoidAsync("mwLoadScripts.ensureMany", Scripts);
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }
    }
}
