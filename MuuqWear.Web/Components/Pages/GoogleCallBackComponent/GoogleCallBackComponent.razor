@page "/auth/google-callback"
@rendermode InteractiveServer
@inject IJSRuntime JS
@inject NavigationManager NavigationManager
@inject IAuthService IAuthService
@inject AuthStateService AuthStateService
@inject CustomAuthenticationStateProvider CustomAuthStateProvider
@inject CartStateService CartStateService
@using MuuqWear.Application.Services.AuthService
@using MuuqWear.Application.Services.CartService
@using MuuqWear.Application.Shared
@using MuuqWear.Model.Authentication


<PageTitle>Signing in with Google...</PageTitle>

<div class="container py-5 text-center">
    @if (isVerifying)
    {
        <p>Signing in with Google...</p>
    }
    else if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="text-danger">@errorMessage</p>
        <a href="/login" class="mw-btn-primary mt-3">
            Back to Login
        </a>
    }
</div>

@code {

    private bool isVerifying = true;
    private string errorMessage = string.Empty;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        try
        {
            // Supabase/Google may return tokens in the hash and/or query string.
            var fragment = await JS.InvokeAsync<string>(
                "eval", "window.location.hash || ''");
            var query = await JS.InvokeAsync<string>(
                "eval", "window.location.search || ''");

            var parameters = ParseParams(fragment.TrimStart('#'));
            foreach (var pair in ParseParams(query.TrimStart('?')))
                parameters.TryAdd(pair.Key, pair.Value);

            if (parameters.TryGetValue("error", out var oauthError)
                || parameters.TryGetValue("error_description", out _))
            {
                var detail = parameters.GetValueOrDefault("error_description")
                             ?? parameters.GetValueOrDefault("error")
                             ?? "Google sign in was cancelled or denied.";
                errorMessage = Uri.UnescapeDataString(detail.Replace('+', ' '));
                isVerifying = false;
                StateHasChanged();
                return;
            }

            if (!parameters.TryGetValue("access_token", out var accessToken)
                || string.IsNullOrEmpty(accessToken))
            {
                errorMessage = parameters.Count == 0
                    ? "Invalid Google callback. Please try again."
                    : "Google sign in failed. Token missing.";
                isVerifying = false;
                StateHasChanged();
                return;
            }

            parameters.TryGetValue("refresh_token", out var refreshToken);

            var result = await IAuthService.VerifyMagicLink(
                new MagicLinkVerifyModel
                {
                    AccessToken = accessToken,
                    RefreshToken = refreshToken ?? ""
                });

            if (result.Success && result.Data != null)
            {
                if (!string.Equals(result.Data.Role, "user", StringComparison.OrdinalIgnoreCase))
                {
                    errorMessage = "Access denied. Staff accounts must use the admin portal.";
                    isVerifying = false;
                    StateHasChanged();
                    return;
                }

                await AuthNavigationHelper.PrepareAndNavigateAsync(
                    result.Data,
                    NavigationManager,
                    CustomAuthStateProvider,
                    JS,
                    "/profile");
            }
            else
            {
                errorMessage = result.Message ?? "Google sign in failed.";
                isVerifying = false;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            errorMessage = "Something went wrong. Please try again.";
            isVerifying = false;
            StateHasChanged();
            Console.WriteLine(ex.Message);
        }
    }

    private static Dictionary<string, string> ParseParams(string raw)
    {
        var result = new Dictionary<string, string>(StringComparer.OrdinalIgnoreCase);
        if (string.IsNullOrWhiteSpace(raw))
            return result;

        foreach (var part in raw.Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var pair = part.Split('=', 2);
            if (pair.Length != 2 || string.IsNullOrEmpty(pair[0]))
                continue;

            result[pair[0]] = Uri.UnescapeDataString(pair[1]);
        }

        return result;
    }
}
