@using Microsoft.AspNetCore.Components.Forms

<div class="ee-image">
    @if (!string.IsNullOrWhiteSpace(Label))
    {
        <span class="ee-image__label">@Label</span>
    }

    <div class="ee-image__row">
        @if (!string.IsNullOrEmpty(Url))
        {
            <div class="ee-image__thumb-wrap">
                <img src="@Url" alt="" class="ee-image__thumb" />
            </div>
        }
        else
        {
            <div class="ee-image__thumb-wrap ee-image__thumb-wrap--empty" aria-hidden="true">
                <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect width="18" height="18" x="3" y="3" rx="2" ry="2"></rect>
                    <circle cx="9" cy="9" r="2"></circle>
                    <path d="m21 15-3.086-3.086a2 2 0 0 0-2.828 0L6 21"></path>
                </svg>
            </div>
        }

        <div class="ee-image__controls">
            <div class="ee-image__tabs">
                <button type="button"
                        class="ee-image__tab @(tab == "url" ? "ee-image__tab--active" : "")"
                        @onclick='() => tab = "url"'>
                    URL
                </button>
                <button type="button"
                        class="ee-image__tab @(tab == "upload" ? "ee-image__tab--active" : "")"
                        @onclick='() => tab = "upload"'>
                    Upload
                </button>
            </div>

            @if (tab == "url")
            {
                <input value="@Url"
                       @onchange="OnUrlChanged"
                       placeholder="https://…"
                       class="ee-input" />
            }
            else
            {
                <label class="ee-upload">
                    <InputFile OnChange="HandleUpload"
                               accept="image/*"
                               class="ee-upload__input" />
                    <span class="ee-upload__label">
                        @if (isUploading)
                        {
                            <text>Uploading…</text>
                        }
                        else
                        {
                            <text>Choose image file</text>
                        }
                    </span>
                </label>
            }
        </div>
    </div>
</div>

@code {
    [Parameter] public string Label { get; set; } = string.Empty;
    [Parameter] public string Url { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> UrlChanged { get; set; }
    [Parameter] public Func<InputFileChangeEventArgs, Task>? OnUpload { get; set; }

    private string tab = "url";
    private bool isUploading;

    private async Task OnUrlChanged(ChangeEventArgs e)
    {
        await UrlChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);
    }

    private async Task HandleUpload(InputFileChangeEventArgs e)
    {
        if (OnUpload == null)
            return;

        isUploading = true;
        try
        {
            await OnUpload(e);
        }
        finally
        {
            isUploading = false;
        }
    }
}
