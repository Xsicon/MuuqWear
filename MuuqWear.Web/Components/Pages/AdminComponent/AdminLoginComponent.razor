@page "/admin/f8e2a947-3c1b-4d9e-b562-7a0f1e8d3c92/login"
@rendermode InteractiveServer
@using MuuqWear.Model.Authentication
@layout Components.Layout.AuthLayoutComponent.AuthLayoutComponent
@using Microsoft.AspNetCore.Hosting
@inject NavigationManager NavigationManager
@inject IWebHostEnvironment HostEnvironment


<section class="mw-auth">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">
                <div class="mw-admin-login">
                    <div class="mw-admin-login__layout">
                    <div class="mw-admin-login__card">

                        <!-- ICON -->
                        <div class="text-center mb-4">
                            <div class="mw-admin-login__icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28"
                                     viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z">
                                    </path>
                                </svg>
                            </div>
                            <h1 class="mw-admin-login__title">Admin Portal</h1>
                            <p class="mw-admin-login__subtitle">
                                Secure access for administrators only
                            </p>
                        </div>

                        <!-- FORM -->
                        <form method="post" action="/auth/staff-login" data-enhance="false">
                            <div class="mb-4">
                                <label class="mw-admin-login__label" for="admin-email">Admin Email</label>
                                <input id="admin-email"
                                       class="mw-admin-login__input"
                                       name="email"
                                       type="email"
                                       autocomplete="username"
                                       placeholder="admin@muuqwear.com"
                                       value="@loginModel.Email" />
                            </div>

                            <div class="mb-4">
                                <label class="mw-admin-login__label" for="admin-password">Admin Password</label>
                                <input id="admin-password"
                                       class="mw-admin-login__input"
                                       name="password"
                                       type="password"
                                       autocomplete="current-password"
                                       placeholder="••••••••"
                                       value="@loginModel.Password" />
                            </div>

                            @if (!string.IsNullOrEmpty(message))
                            {
                                <div class="@messageCssClass mb-3 small">
                                    @message
                                </div>
                            }

                            <button type="submit" class="mw-admin-login__btn w-100">
                                <span>Access Admin Portal</span>
                            </button>
                        </form>

                        <!-- BACK LINK -->
                        <div class="text-center mt-4">
                            <a href="/login" class="mw-admin-login__back">
                                ← Back to User Login
                            </a>
                        </div>

                    </div>

                    @if (ShowDemoAccounts)
                    {
                    <div class="mw-admin-login__demo">
                        <div class="mw-admin-login__demo-header">
                            <h2 class="mw-admin-login__demo-title">Demo accounts</h2>
                            <p class="mw-admin-login__demo-subtitle">Click a row to fill the login form. Authorization is enforced by your assigned role after sign-in.</p>
                        </div>

                        <div class="mw-admin-login__demo-table-wrap">
                            <table class="mw-admin-login__demo-table">
                                <thead>
                                    <tr>
                                        <th>Email</th>
                                        <th>Password</th>
                                        <th>Role (profile)</th>
                                        <th>Display name</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var account in DemoAccounts)
                                    {
                                        <tr class="mw-admin-login__demo-row"
                                            tabindex="0"
                                            role="button"
                                            @onclick="() => UseDemoAccount(account)"
                                            @onkeydown="(e) => HandleDemoRowKeyDown(e, account)">
                                            <td>@account.Email</td>
                                            <td><code>@account.Password</code></td>
                                            <td><span class="mw-admin-login__role-tag">@account.Role</span></td>
                                            <td>@account.DisplayName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                    }
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private sealed record AdminDemoAccount(
        string Email,
        string Password,
        string Role,
        string DisplayName);

    private static readonly AdminDemoAccount[] DemoAccounts =
    [
        new("admin@muuqwear.com", "admin123", "admin", "Admin"),
        new("ops@muuqwear.com", "ops123", "operations_manager", "Operations Manager"),
        new("support@muuqwear.com", "support123", "support_team", "Customer Support"),
        new("merch@muuqwear.com", "merch123", "merchandising", "Merchandising"),
        new("creative@muuqwear.com", "creative123", "content_team", "Creative & Content"),
        new("tech@muuqwear.com", "tech123", "technology_systems", "Technology & Systems")
    ];

    private LoginModel loginModel = new();
    private string message = string.Empty;
    private string messageCssClass = string.Empty;
    private bool ShowDemoAccounts => HostEnvironment.IsDevelopment();

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        if (!Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query).TryGetValue("error", out var error))
            return;

        messageCssClass = "text-danger";
        message = error == "denied" ? "Access denied." : "Invalid email or password.";
    }

    private void UseDemoAccount(AdminDemoAccount account)
    {
        loginModel.Email = account.Email;
        loginModel.Password = account.Password;
        message = string.Empty;
    }

    private void HandleDemoRowKeyDown(KeyboardEventArgs e, AdminDemoAccount account)
    {
        if (e.Key is "Enter" or " ")
            UseDemoAccount(account);
    }
}
