@page "/admin/f8e2a947-3c1b-4d9e-b562-7a0f1e8d3c92/login"
@rendermode InteractiveServer
@layout Components.Layout.AuthLayoutComponent.AuthLayoutComponent
@inject NavigationManager NavigationManager
@inject MuuqWear.Web.ServerAuth.StaffMfaTicket Tickets
@using MuuqWear.Web.ServerAuth
@using MuuqWear.Web.Constants


<section class="mw-auth">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-lg-10 col-xl-9">
                <div class="mw-admin-login">
                    <div class="mw-admin-login__layout">
                    <div class="mw-admin-login__card">

                        <!-- ICON -->
                        <div class="text-center mb-4">
                            <div class="mw-admin-login__icon">
                                <svg xmlns="http://www.w3.org/2000/svg" width="28" height="28"
                                     viewBox="0 0 24 24" fill="none" stroke="white"
                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z">
                                    </path>
                                </svg>
                            </div>
                            <h1 class="mw-admin-login__title">Admin Portal</h1>
                            <p class="mw-admin-login__subtitle">
                                Secure access for administrators only
                            </p>
                        </div>

                        @if (step is not null)
                        {
                            <form method="post" action="/auth/staff-login/verify" data-enhance="false">
                                <input type="hidden" name="t" value="@ticket" />

                                @if (step.Kind == StaffMfaStep.Enroll)
                                {
                                    <h2 class="mw-admin-login__step-title">Set up your authenticator app</h2>
                                    <p class="mw-admin-login__step-help">
                                        Admin access needs a code from an authenticator app such as Google Authenticator,
                                        Microsoft Authenticator or 1Password. Scan this code with the app, then enter the
                                        6-digit code it shows.
                                    </p>
                                    @if (qrDataUri is not null)
                                    {
                                        <img class="mw-admin-login__qr" src="@qrDataUri" width="200" height="200"
                                             alt="QR code to add MuuqWear Admin to your authenticator app" />
                                    }
                                    <p class="mw-admin-login__step-help mb-1">Can't scan it? Enter this key instead:</p>
                                    <code class="mw-admin-login__secret">@FormatSecret(step.SecretKey)</code>
                                }
                                else
                                {
                                    <h2 class="mw-admin-login__step-title">Enter your authenticator code</h2>
                                    <p class="mw-admin-login__step-help">
                                        Open your authenticator app and enter the 6-digit code for MuuqWear Admin.
                                    </p>
                                }

                                <div class="mb-4 mt-3">
                                    <label class="mw-admin-login__label" for="admin-code">6-digit code</label>
                                    <input id="admin-code"
                                           class="mw-admin-login__input"
                                           name="code"
                                           type="text"
                                           inputmode="numeric"
                                           pattern="[0-9 ]{6,7}"
                                           maxlength="7"
                                           autocomplete="one-time-code"
                                           autofocus
                                           required
                                           placeholder="123456" />
                                </div>

                                @if (!string.IsNullOrEmpty(message))
                                {
                                    <div class="@messageCssClass mb-3 small">@message</div>
                                }

                                <button type="submit" class="mw-admin-login__btn w-100">
                                    <span>@(step.Kind == StaffMfaStep.Enroll ? "Finish setup and sign in" : "Verify and sign in")</span>
                                </button>
                            </form>

                            <div class="text-center mt-4">
                                <a href="@AdminPortalPaths.Login" class="mw-admin-login__back">← Start over</a>
                            </div>
                        }
                        else
                        {
                        <!-- FORM -->
                        <form method="post" action="/auth/staff-login" data-enhance="false">
                            <div class="mb-4">
                                <label class="mw-admin-login__label" for="admin-email">Admin Email</label>
                                <input id="admin-email"
                                       class="mw-admin-login__input"
                                       name="email"
                                       type="email"
                                       autocomplete="username"
                                       placeholder="you@muuqwear.com" />
                            </div>

                            <div class="mb-4">
                                <label class="mw-admin-login__label" for="admin-password">Admin Password</label>
                                <input id="admin-password"
                                       class="mw-admin-login__input"
                                       name="password"
                                       type="password"
                                       autocomplete="current-password"
                                       placeholder="••••••••" />
                            </div>

                            @if (!string.IsNullOrEmpty(message))
                            {
                                <div class="@messageCssClass mb-3 small">
                                    @message
                                </div>
                            }

                            <button type="submit" class="mw-admin-login__btn w-100">
                                <span>Access Admin Portal</span>
                            </button>
                        </form>

                        <!-- BACK LINK -->
                        <div class="text-center mt-4">
                            <a href="/login" class="mw-admin-login__back">
                                ← Back to User Login
                            </a>
                        </div>
                        }

                    </div>

                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private string message = string.Empty;
    private string messageCssClass = string.Empty;

    private StaffMfaStep? step;
    private string? ticket;
    private string? qrDataUri;

    protected override void OnInitialized()
    {
        var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
        var query = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);

        string? error = query.TryGetValue("error", out var errorValue) ? errorValue.ToString() : null;
        if (query.ContainsKey("step"))
        {
            ticket = query.TryGetValue("t", out var t) ? t.ToString() : null;
            step = Tickets.Unprotect(ticket);
            if (step is null)
                error = "expired";
            else if (step.Kind == StaffMfaStep.Enroll && !string.IsNullOrWhiteSpace(step.SecretKey))
                qrDataUri = QrDataUri(StaffMfaService.OtpAuthUri(step.Email, step.SecretKey));
        }

        if (string.IsNullOrEmpty(error))
            return;

        messageCssClass = "text-danger";
        message = error switch
        {
            "denied" => "Access denied.",
            "expired" => "That sign-in step expired. Enter your email and password again.",
            "code" => "That code didn't match. Enter the current code from your app.",
            "too-many" => "Too many attempts. Wait a few minutes, then try again.",
            "unverified" => "Verify this account's email address before setting up the authenticator app.",
            "mfa-disabled" => "Authenticator sign-in isn't turned on for this Firebase project yet.",
            _ => "Invalid email or password."
        };
    }

    private static string QrDataUri(string text)
    {
        var png = QRCoder.PngByteQRCodeHelper.GetQRCode(text, QRCoder.QRCodeGenerator.ECCLevel.M, 6);
        return "data:image/png;base64," + Convert.ToBase64String(png);
    }

    private static string FormatSecret(string? secret) =>
        string.Join(' ', (secret ?? "").Chunk(4).Select(chunk => new string(chunk)));
}
