@using MuuqWear.Model.AffiliateApplication



<article class="aff-row @(ShowActiveActions && !Application.IsActive ? "aff-row--inactive" : "")">

    <div class="aff-row__avatar" aria-hidden="true">

        @AffiliateAdminDesignHelper.GetInitials(Application.FullName)

    </div>



    <div class="aff-row__body">

        <div class="aff-row__title-line">

            <span class="aff-row__name">@Application.FullName</span>

            @if (!ShowActiveActions)

            {

                <span class="aff-row__handle">@GetPrimaryHandle()</span>

                <span class="aff-row__status" style="background-color:@GetStatusBg();color:@GetStatusFg();">

                    @Application.Status.ToUpperInvariant()

                </span>

            }

            else

            {

                <span class="aff-row__handle">@GetPrimaryHandle()</span>

                <span class="aff-row__tier-badge" style="background-color:@GetTierBg();color:@GetTierFg();">

                    <span class="aff-row__tier-dot" style="background-color:@GetTierDot();"></span>

                    @AffiliateAdminDesignHelper.FormatTierLabel(Application.AffiliateTier)

                </span>

                @if (!Application.IsActive)

                {

                    <span class="aff-row__status" style="background-color:#FEE2E2;color:#991B1B;">INACTIVE</span>

                }

            }

        </div>



        @if (ShowActiveActions)

        {

            <div class="aff-row__stats">

                <div class="aff-row__stat">

                    <span class="aff-row__stat-value">@Application.ItemsSold</span>

                    <span class="aff-row__stat-label">Items sold</span>

                </div>

                <div class="aff-row__stat">

                    <span class="aff-row__stat-value">@Application.FormattedEarned</span>

                    <span class="aff-row__stat-label">Earned</span>

                </div>

                <div class="aff-row__stat">

                    <span class="aff-row__stat-value">@Application.CommissionRatePercent.ToString("0.#")%</span>

                    <span class="aff-row__stat-label">Commission</span>

                </div>

                <div class="aff-row__stat">

                    <span class="aff-row__stat-value">@Application.FormattedLastSale</span>

                    <span class="aff-row__stat-label">Last sale</span>

                </div>

                <div class="aff-row__stat">

                    <span class="aff-row__stat-value">@Application.FormattedJoinDate</span>

                    <span class="aff-row__stat-label">Joined</span>

                </div>

            </div>



            <p class="aff-row__meta">

                <span><strong>@Application.ContentNiche</strong></span>

                @if (!string.IsNullOrWhiteSpace(Application.Email))

                {

                    <span> · @Application.Email</span>

                }

            </p>

        }

        else

        {

            <p class="aff-row__meta">

                <span><strong>@AffiliateAdminDesignHelper.FormatFollowers(Application.AudienceSize)</strong> followers</span>

                <span> · @Application.ContentNiche</span>

                <span> · Applied @Application.FormattedDate</span>

            </p>



            @if (Application.SocialHandles?.Any() == true)

            {

                <div class="aff-row__socials">

                    @foreach (var social in Application.SocialHandles.Where(s => !string.IsNullOrWhiteSpace(s.Handle)))

                    {

                        <span class="aff-row__social-link">@social.Platform</span>

                    }

                </div>

            }

        }

    </div>



    <div class="aff-row__actions">

        @if (!ShowActiveActions)

        {

            var canReview = Application.Status.Equals("pending", StringComparison.OrdinalIgnoreCase)

                || Application.Status.Equals("waitlisted", StringComparison.OrdinalIgnoreCase);



            @if (canReview)

            {

                <button type="button" class="aff-row__btn aff-row__btn--ghost" disabled="@Disabled"

                        @onclick='() => OnAction.InvokeAsync((Application.Id, "view"))'>

                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>

                    View

                </button>

                <button type="button" class="aff-row__btn aff-row__btn--waitlist" disabled="@Disabled"

                        @onclick='() => OnAction.InvokeAsync((Application.Id, "waitlist"))'>

                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>

                    Waitlist

                </button>

                <button type="button" class="aff-row__btn aff-row__btn--deny" disabled="@Disabled"

                        @onclick='() => OnAction.InvokeAsync((Application.Id, "reject"))'>

                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>

                    Deny

                </button>

                <button type="button" class="aff-row__btn aff-row__btn--approve" disabled="@Disabled"

                        @onclick='() => OnAction.InvokeAsync((Application.Id, "approve"))'>

                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>

                    Approve

                </button>

                @if (ShowUndo)

                {

                    <button type="button" class="aff-row__btn aff-row__btn--ghost" disabled="@Disabled"

                            @onclick="OnUndo">

                        Undo

                    </button>

                }

            }

            else

            {

                <button type="button" class="aff-row__btn aff-row__btn--ghost" disabled="@Disabled"

                        @onclick='() => OnAction.InvokeAsync((Application.Id, "view"))'>

                    View

                </button>

            }

        }

        else

        {

            <button type="button" class="aff-row__btn aff-row__btn--ghost" disabled="@Disabled"

                    @onclick='() => OnAction.InvokeAsync((Application.Id, "view"))'>

                View Details

            </button>

            <button type="button" class="aff-row__btn @(Application.IsActive ? "aff-row__btn--deny" : "aff-row__btn--approve")"

                    disabled="@Disabled"

                    @onclick='() => OnAction.InvokeAsync((Application.Id, "toggle-active"))'>

                @(Application.IsActive ? "Deactivate" : "Activate")

            </button>

        }

    </div>

</article>



@code {

    [Parameter] public AffiliateApplicationModel Application { get; set; } = new();

    [Parameter] public EventCallback<(Guid Id, string Action)> OnAction { get; set; }

    [Parameter] public EventCallback OnUndo { get; set; }

    [Parameter] public bool ShowActiveActions { get; set; }

    [Parameter] public bool ShowUndo { get; set; }

    [Parameter] public bool Disabled { get; set; }



    private string GetPrimaryHandle() =>

        AffiliateAdminDesignHelper.GetPrimaryHandle(Application.SocialHandles);



    private string GetStatusBg() => AffiliateAdminDesignHelper.GetStatusColors(Application.Status).Bg;

    private string GetStatusFg() => AffiliateAdminDesignHelper.GetStatusColors(Application.Status).Fg;

    private string GetTierBg() => AffiliateAdminDesignHelper.GetTierTheme(Application.AffiliateTier).BgColor;

    private string GetTierFg() => AffiliateAdminDesignHelper.GetTierTheme(Application.AffiliateTier).TextColor;

    private string GetTierDot() => AffiliateAdminDesignHelper.GetTierTheme(Application.AffiliateTier).DotColor;

}


