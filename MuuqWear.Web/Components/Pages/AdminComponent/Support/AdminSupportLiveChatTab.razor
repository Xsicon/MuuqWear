@using MuuqWear.Application.Services.ChatService
@using MuuqWear.Model.Chat
@implements IDisposable
@inject IChatService ChatService

<div class="@TabShellClass">
    <div class="cs-tab-header-row">
        <div class="cs-tab-header" style="margin-bottom:0">
            <p class="cs-tab-eyebrow">Customer Support</p>
            <h2 class="cs-tab-title">Live Chat</h2>
            <p class="cs-tab-subtitle">Respond to customers in real time</p>
        </div>
        <div class="cs-tab-actions">
            <SupportKbButton OnClick="OpenKbPanel" />
        </div>
    </div>

    @if (isLoading)
    {
        <p class="cs-loading">Loading conversations…</p>
    }

    @if (!string.IsNullOrEmpty(loadError))
    {
        <p class="cs-error-banner">@loadError</p>
    }

    <div class="cs-chat-layout">
        <aside class="cs-chat-sidebar">
            <div class="cs-chat-sidebar__header">Active Conversations (@sessions.Count)</div>
            <div class="cs-chat-sidebar__list">
                @if (sessions.Count == 0)
                {
                    <div class="cs-empty" style="padding:40px 16px">
                        <svg class="cs-empty__icon" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                        <p>@(string.IsNullOrEmpty(loadError) ? "No active chats" : "Unable to load conversations")</p>
                    </div>
                }
                else
                {
                    @foreach (var s in sessions)
                    {
                        <button type="button"
                                class="cs-conv-item @(selectedSessionId == s.Id ? "cs-conv-item--active" : "")"
                                @onclick="() => SelectSession(s.Id)"
                                @key="s.Id">
                            <div class="cs-conv-item__top">
                                <span class="cs-conv-item__name">@s.CustomerName</span>
                                <div class="cs-conv-item__meta">
                                    @if (GetSidebarMessageCount(s) > 0)
                                    {
                                        <span class="cs-conv-item__msg-count @(ShouldHighlightSidebarCount(s) ? "cs-conv-item__msg-count--unread" : "")">
                                            @GetSidebarMessageCount(s)
                                        </span>
                                    }
                                    <span class="cs-conv-item__time">@GetRelativeTime(s.LastActivity)</span>
                                </div>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(s.ContactEmail))
                            {
                                <a href="mailto:@s.ContactEmail" class="cs-contact-email cs-conv-item__email" @onclick:stopPropagation="true">@s.ContactEmail</a>
                            }
                            @if (!string.IsNullOrEmpty(s.LastMessagePreview))
                            {
                                <p class="cs-conv-item__preview">@s.LastMessagePreview</p>
                            }
                            <div class="cs-conv-item__status">
                                <span class="cs-status-dot" style="background:@(IsWaiting(s) ? "#F59E0B" : "#22C55E")"></span>
                                @(IsWaiting(s) ? "waiting" : "active")
                            </div>
                        </button>
                    }
                }
            </div>
        </aside>

        @if (sessions.Count == 0 || !selectedSessionId.HasValue)
        {
            <div class="cs-chat-empty">
                <div>
                    <svg class="cs-empty__icon" xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
                    <p>No active conversations</p>
                </div>
            </div>
        }
    </div>

    @if (selectedSessionId.HasValue && selectedSession != null)
    {
        <aside class="cs-drawer cs-chat-drawer @(showKbPanel ? "cs-drawer--shifted" : "")">
            <header class="cs-drawer__header cs-chat-drawer__header">
                <div class="cs-chat-drawer__mobile-top">
                    <button type="button"
                            class="cs-chat-drawer__back"
                            aria-label="Back to conversations"
                            @onclick="DeselectSession">
                        <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
                    </button>
                    <div class="cs-chat-drawer__mobile-center">
                        <h3 class="cs-chat-drawer__mobile-name">@selectedSession.CustomerName</h3>
                        <p class="cs-chat-drawer__mobile-status">
                            @(IsWaiting(selectedSession) ? "Waiting" : "Active")
                            · @GetRelativeTime(selectedSession.LastActivity)
                        </p>
                    </div>
                    <div class="cs-chat-drawer__mobile-actions">
                        <button type="button" class="cs-chat-drawer__mobile-icon-btn" aria-label="Open knowledge base" @onclick="OpenKbPanel">
                            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                        </button>
                    </div>
                </div>

                <div class="cs-chat-drawer__desktop-only">
                <div class="cs-chat-drawer__heading">
                    <h3 class="cs-drawer__title">@selectedSession.CustomerName</h3>
                    <p class="cs-chat-drawer__subtitle">
                        @(IsWaiting(selectedSession) ? "Waiting" : "Active")
                        · last message @GetRelativeTime(selectedSession.LastActivity)
                    </p>
                    @if (!string.IsNullOrWhiteSpace(selectedSession.ContactEmail))
                    {
                        <div class="cs-chat-panel__email-row">
                            <a href="mailto:@selectedSession.ContactEmail"
                               class="cs-contact-email cs-chat-panel__email-link"
                               title="@selectedSession.ContactEmail">
                                @selectedSession.ContactEmail
                            </a>
                            <button type="button"
                                    class="cs-chat-panel__copy-btn"
                                    title="@(emailCopied ? "Copied!" : "Copy email")"
                                    aria-label="Copy customer email"
                                    @onclick="CopyCustomerEmail">
                                @if (emailCopied)
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21.801 10A10 10 0 1 1 17 3.335"/><path d="m9 11 3 3L22 4"/></svg>
                                }
                                else
                                {
                                    <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>
                                }
                            </button>
                        </div>
                    }
                    else
                    {
                        <p class="cs-chat-panel__email-missing">No email provided</p>
                    }
                </div>
                <div class="cs-ticket-drawer__header-actions">
                    <button type="button" class="cs-btn cs-btn--outline cs-btn--sm" @onclick="OpenKbPanel">
                        <svg xmlns="http://www.w3.org/2000/svg" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                        KB
                    </button>
                    @if (selectedSession.Status == "active")
                    {
                        <button type="button" class="cs-btn cs-btn--danger cs-btn--sm"
                                @onclick="CloseSelectedSession"
                                disabled="@isClosingSession">
                            @(isClosingSession ? "Closing…" : "Close Chat")
                        </button>
                    }
                    <button type="button" class="cs-icon-btn" aria-label="Close chat panel" @onclick="DeselectSession">
                        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
                    </button>
                </div>
                </div>

                @if (selectedSession.Status == "active")
                {
                    <div class="cs-chat-drawer__mobile-close-row">
                        <button type="button"
                                class="cs-chat-drawer__mobile-close-btn"
                                @onclick="CloseSelectedSession"
                                disabled="@isClosingSession">
                            @(isClosingSession ? "Closing…" : "Close Chat")
                        </button>
                    </div>
                }
            </header>

            <div class="cs-drawer__body cs-chat-drawer__body">
                @if (!string.IsNullOrEmpty(loadError))
                {
                    <p class="cs-error-banner cs-error-banner--inline cs-chat-drawer__sync-error">@loadError</p>
                }
                <div class="cs-chat-panel__messages" @ref="messagesContainerRef">
                    @if (!string.IsNullOrEmpty(messagesError))
                    {
                        <p class="cs-error-banner cs-error-banner--inline">@messagesError</p>
                    }
                    else if (isLoadingMessages)
                    {
                        <p class="cs-row__meta">Loading messages…</p>
                    }
                    else if (messagesLoadSucceeded && messages.Count == 0)
                    {
                        <p class="cs-row__meta">No messages yet.</p>
                    }
                    else
                    {
                        @foreach (var m in messages)
                        {
                            var isAgent = m.SenderType is "admin" or "agent";
                            <div class="cs-bubble-row @(isAgent ? "cs-bubble-row--agent" : "cs-bubble-row--customer")">
                                @if (!isAgent)
                                {
                                    <span class="cs-bubble-avatar" aria-hidden="true">@CustomerInitials</span>
                                }
                                <div class="cs-bubble @(isAgent ? "cs-bubble--agent" : "cs-bubble--customer")">
                                    <p class="cs-bubble__text">@m.Message</p>
                                    <span class="cs-bubble__time">@m.CreatedAt.ToLocalTime().ToString("h:mm tt")</span>
                                </div>
                            </div>
                        }
                    }
                </div>
            </div>

            <footer class="cs-drawer__footer cs-chat-drawer__footer">
                @if (!string.IsNullOrEmpty(actionError))
                {
                    <p class="cs-error-banner cs-error-banner--inline">@actionError</p>
                }
                <SupportMacrosBar @ref="macrosBar" OnApply="ApplyMacro" />
                <div class="cs-chat-panel__input">
                    <input type="text"
                           class="cs-chat-panel__input-field"
                           placeholder="Type a message…"
                           @bind="adminMessageInput"
                           @bind:event="oninput"
                           @onkeydown="HandleAdminKeyDown"
                           disabled="@(selectedSession.Status == "closed" || isSendingAdminMessage)" />
                    <button type="button"
                            class="cs-btn cs-btn--primary cs-chat-drawer__send-btn"
                            @onclick="SendAdminMessage"
                            disabled="@(selectedSession.Status == "closed" || isSendingAdminMessage || string.IsNullOrWhiteSpace(adminMessageInput))">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="m22 2-7 20-4-9-9-4Z"/><path d="M22 2 11 13"/></svg>
                        <span class="cs-chat-drawer__send-label">Send</span>
                    </button>
                </div>
            </footer>
        </aside>
    }

    @if (showKbPanel)
    {
        <button type="button" class="cs-kb-backdrop" @onclick="CloseKbPanel" aria-label="Close knowledge base panel"></button>
        <SupportKbQuickPanel OnClose="CloseKbPanel" />
    }
</div>
