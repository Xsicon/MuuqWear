@using MuuqWear.Application.Services.HelpCenterService
@using MuuqWear.Model.HelpCenter
@using MuuqWear.Web.Services

<div @onkeydown:window="HandleWindowKeyDown">
<aside class="cs-kb-panel">
    <header class="cs-kb-panel__header">
        <div>
            <p class="cs-drawer__eyebrow">Quick help</p>
            <h3 class="cs-drawer__title">Knowledge Base</h3>
        </div>
        <button type="button" class="cs-btn cs-btn--icon" @onclick="Close" aria-label="Close knowledge base panel">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
        </button>
    </header>

    <div class="cs-kb-panel__search">
        <svg class="cs-search__icon" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        <input class="cs-kb-panel__search-input"
               placeholder="Search articles while you work…"
               @bind="search"
               @bind:event="oninput" />
    </div>

    <div class="cs-kb-panel__list">
        @if (isLoading)
        {
            <div class="cs-empty" style="padding:64px 16px">
                <p>Loading articles…</p>
            </div>
        }
        else if (!string.IsNullOrEmpty(loadError))
        {
            <div class="cs-empty" style="padding:64px 16px">
                <p>@loadError</p>
            </div>
        }
        else
        {
        @for (var i = 0; i < _publishedArticles.Count; i++)
        {
            var article = _publishedArticles[i];
            if (!MatchesSearch(article))
            {
                continue;
            }

            var meta = HelpCategoryMeta.Get(article.Category);
            <button type="button"
                    class="cs-kb-panel__item"
                    @key="article.Id"
                    @onclick="@(() => OpenArticle(article))">
                <div class="cs-row__icon" style="background:@meta.Bg">
                    @((MarkupString)AdminSupportKnowledgeBaseTab.GetCategoryIconSvg(meta.IconKey, meta.Dot))
                </div>
                <div class="cs-row__body">
                    <p class="cs-row__title">@article.Title</p>
                    <p class="cs-row__meta">@article.Category</p>
                </div>
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#A9B7CC" stroke-width="2" aria-hidden="true"><path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"/><circle cx="12" cy="12" r="3"/></svg>
            </button>
        }

        @if (!HasSearchResults)
        {
            <div class="cs-empty" style="padding:64px 16px">
                <svg class="cs-empty__icon" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></svg>
                <p>No published articles match.</p>
            </div>
        }
        }
    </div>
</aside>

@if (ViewArticle != null)
{
    var viewMeta = HelpCategoryMeta.Get(ViewArticle.Category);
    <aside class="cs-kb-panel cs-kb-panel--detail">
        <header class="cs-kb-panel__header">
            <div>
                <p class="cs-drawer__eyebrow">Knowledge Base Article</p>
                <div class="cs-kb-panel__badges">
                    <span class="cs-badge" style="background:@viewMeta.Bg;color:@viewMeta.Text">@ViewArticle.Category</span>
                    <span class="cs-badge cs-badge--round" style="background:#D1FAE5;color:#065F46">Published</span>
                </div>
            </div>
            <button type="button" class="cs-btn cs-btn--icon" @onclick="CloseArticle" aria-label="Close article details">
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>
            </button>
        </header>

        <div class="cs-kb-panel__detail-body">
            <div class="cs-kb-panel__detail-title">
                <div class="cs-row__icon" style="background:@viewMeta.Bg;width:44px;height:44px;border-radius:12px">
                    @((MarkupString)AdminSupportKnowledgeBaseTab.GetCategoryIconSvg(viewMeta.IconKey, viewMeta.Dot))
                </div>
                <h3 class="cs-kb-panel__article-title">@ViewArticle.Title</h3>
            </div>

            <div class="cs-kb-panel__stats">
                <span><strong>@ViewArticle.Views.ToString("N0")</strong> views</span>
                <span><strong style="color:#22C55E">@ViewArticle.Helpful</strong> found helpful</span>
                <span>Updated @ViewArticle.LastUpdated</span>
            </div>

            <p class="cs-kb-panel__content">@ViewArticle.Content</p>
        </div>

        <footer class="cs-kb-panel__detail-footer">
            <button type="button" class="cs-btn cs-btn--outline" @onclick="OpenHelpCenter">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 7h10v10"/><path d="M7 17 17 7"/></svg>
                Open in Help Center
            </button>
        </footer>
    </aside>
}
</div>

@code {
    [Parameter] public EventCallback OnClose { get; set; }

    [Inject] private NavigationManager NavigationManager { get; set; } = default!;
    [Inject] private IHelpCenterService HelpCenterService { get; set; } = default!;

    private IReadOnlyList<HelpArticleModel> _publishedArticles = [];
    private string search = string.Empty;
    private HelpArticleModel? ViewArticle { get; set; }
    private bool isLoading = true;
    private string? loadError;

    private bool HasSearchResults =>
        _publishedArticles.Any(MatchesSearch);

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await HelpCenterService.GetPublishedArticles(null, null, 1, 100);
            if (!result.Success || result.Data == null)
            {
                loadError = AdminUiErrorHelper.FromApi(result.Message, "Failed to load knowledge base.");
                _publishedArticles = [];
                return;
            }

            _publishedArticles = result.Data.Data
                .OrderBy(a => a.Category)
                .ThenBy(a => a.Title)
                .ToList();
        }
        catch (Exception ex)
        {
            loadError = AdminUiErrorHelper.FromException(ex);
            _publishedArticles = [];
        }
        finally
        {
            isLoading = false;
        }
    }

    private bool MatchesSearch(HelpArticleModel article)
    {
        var q = search.Trim();
        if (string.IsNullOrEmpty(q))
            return true;

        return article.Title.Contains(q, StringComparison.OrdinalIgnoreCase) ||
               article.Content.Contains(q, StringComparison.OrdinalIgnoreCase) ||
               article.Category.Contains(q, StringComparison.OrdinalIgnoreCase);
    }

    private void OpenArticle(HelpArticleModel article) => ViewArticle = article;

    private void CloseArticle() => ViewArticle = null;

    private async Task Close()
    {
        ViewArticle = null;
        if (OnClose.HasDelegate)
            await OnClose.InvokeAsync();
    }

    private async Task HandleWindowKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            await Close();
    }

    private void OpenHelpCenter() =>
        NavigationManager.NavigateTo("/help", true);
}
