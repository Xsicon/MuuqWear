@page "/admin/orders"
@layout Layout.AdminLayoutComponent.AdminDashboardLayoutComponent
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using MuuqWear.Application.Services.OrderReturnService
@using MuuqWear.Application.Services.OrderService
@using MuuqWear.Application.Services.RefundService
@using MuuqWear.Model.OrderReturn
@using MuuqWear.Model.Orders
@using MuuqWear.Model.Refund
@using MuuqWear.Web.Components.Shared
@inject IOrderService OrderService
@inject IOrderReturnService OrderReturnService
@inject NavigationManager NavigationManager
@implements IDisposable
@attribute [Authorize(Roles = AdminPortalRoles.All)]

<PageTitle>Sales & Orders</PageTitle>

<div class="orders-page @(isLoadingTabContent ? "orders-page--refreshing" : "")">

    <div class="orders-header">
        <div>
            <h1 class="orders-title">Sales &amp; Orders</h1>
            <p class="orders-subtitle">@PageSubtitle</p>
        </div>
        <div class="orders-header__actions">
            <button type="button"
                    class="orders-refresh-btn"
                    disabled="@isRefreshing"
                    aria-label="Refresh list"
                    @onclick="RefreshCurrentTab">
                <svg class="orders-refresh-btn__icon @(isRefreshing ? "orders-refresh-btn__icon--spin" : "")"
                     xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path>
                    <path d="M3 3v5h5"></path>
                    <path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path>
                    <path d="M16 16h5v5"></path>
                </svg>
                @(isRefreshing ? "Refreshing..." : "Refresh")
            </button>

            <div class="orders-export-wrap">
                <button type="button"
                        class="orders-export-btn"
                        disabled="@isExporting"
                        aria-expanded="@exportMenuOpen"
                        @onclick="ToggleExportMenu">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                        <polyline points="7 10 12 15 17 10"></polyline>
                        <line x1="12" x2="12" y1="15" y2="3"></line>
                    </svg>
                    @(isExporting ? "Exporting..." : "Export")
                </button>
                @if (exportMenuOpen)
                {
                    <div class="orders-export-menu">
                        <button type="button" class="orders-export-menu__item" @onclick='() => ExportAsync("csv")'>
                            Download CSV (all filtered)
                        </button>
                        <button type="button" class="orders-export-menu__item" @onclick='() => ExportAsync("excel")'>
                            Download Excel (all filtered)
                        </button>
                        @if (activeMainTab == "orders" && selectedOrderIds.Any())
                        {
                            <button type="button" class="orders-export-menu__item orders-export-menu__item--highlight" @onclick='() => ExportAsync("csv", selectedOnly: true)'>
                                CSV — @selectedOrderIds.Count selected
                            </button>
                            <button type="button" class="orders-export-menu__item orders-export-menu__item--highlight" @onclick='() => ExportAsync("excel", selectedOnly: true)'>
                                Excel — @selectedOrderIds.Count selected
                            </button>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(exportMessage))
    {
        <p class="orders-export-note @(exportMessage.StartsWith("Export failed") || exportMessage.StartsWith("No ") ? "orders-export-note--error" : "")">
            @exportMessage
        </p>
    }

    @if (activeMainTab == "orders")
    {
        <!-- ─── STATUS FILTER TABS ─────────────────────────── -->
        <div class="orders-status-tabs">
            @foreach (var tab in StatusTabs)
            {
                <button class="orders-status-tab @(activeStatus == tab.Value ? "active" : "inactive")"
                        @onclick="() => SetStatus(tab.Value)">
                    @tab.Label
                </button>
            }
        </div>

        @if (!string.IsNullOrWhiteSpace(searchTerm))
        {
            <p class="orders-search-active">
                Showing results for “@searchTerm”
                <button type="button" class="orders-search-active__clear" @onclick="ClearSearch">Clear</button>
            </p>
        }

        <div class="orders-search">
            <svg class="orders-search__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input class="orders-search__input"
                   type="search"
                   placeholder="Search by order #, email, or customer name…"
                   value="@searchTerm"
                   @oninput="OnSearchInput"
                   @onkeydown="HandleSearchKeyDown" />
            <button type="button" class="orders-search__btn" @onclick="ApplySearch">Search</button>
        </div>

        <!-- ─── BULK ACTIONS ──────────────────────────────── -->
        <div class="orders-bulk-bar">
            <label class="orders-select-all">
                <input type="checkbox"
                       checked="@AllSelected"
                       @onchange="ToggleSelectAll" />
                <span>
                    @if (selectedOrderIds.Any())
                    {
                        @($"{selectedOrderIds.Count} selected")
                    }
                    else
                    {
                        @("Select All")
                    }
                </span>
            </label>
            @if (selectedOrderIds.Any())
            {
                <span class="orders-scope-note">Current page only</span>
            }

            <button class="@(selectedOrderIds.Any() ? "btn-process" : "btn-secondary-sm")"
                    disabled="@(!selectedOrderIds.Any())"
                    @onclick="OpenBulkModal">
                Bulk Update @(selectedOrderIds.Any()
                            ? $"({selectedOrderIds.Count})"
                            : "")
            </button>
        </div>

        <!-- ─── ORDER CARDS ───────────────────────────────── -->
        <div class="orders-list">
            @if (isLoading && !orders.Any())
            {
                <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminCardList"
                                   Count="4"
                                   AriaLabel="Loading orders" />
            }
            else if (!orders.Any())
            {
                <p class="@(string.IsNullOrEmpty(ordersError) ? "orders-empty" : "orders-error")">@(string.IsNullOrEmpty(ordersError) ? "No orders found." : ordersError)</p>
            }
            else
            {
                @foreach (var order in orders)
                {
                    <div class="order-card">

                        <!-- TOP ROW: number + badge + buttons -->
                        <div class="order-card__top">
                            <div class="order-card__left">

                                <input type="checkbox"
                                       class="order-card__checkbox"
                                       checked="@selectedOrderIds.Contains(order.Id)"
                                       @onchange="() => ToggleOrderSelection(order.Id)" />
                                <p class="order-card__number">
                                    #@order.OrderNumber
                                </p>
                                <span class="status-badge @GetStatusBadgeClass(order.Status)">
                                    @order.Status
                                </span>
                            </div>

                            <div class="order-card__actions">
                                <button type="button" class="btn-view btn-view--icon"
                                        aria-label="View order"
                                        @onclick="() => OpenViewPanel(order.Id)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                                @{
                                    var nextAction = GetNextAction(order.Status);
                                }
                                @if (nextAction != null)
                                {
                                    <button class="btn-process"
                                            @onclick="() => OpenProcessModal(order)">
                                        @nextAction.Label
                                    </button>
                                }
                            </div>

                        </div>

                        <!-- SECOND ROW: email · date · total -->
                        <p class="order-card__meta">
                            @order.Email
                            · @order.CreatedAt?.ToString("MMM dd, yyyy")
                            · $@order.Total.ToString("F2")
                        </p>

                        <!-- THIRD ROW: items summary -->
                        @if (!string.IsNullOrEmpty(order.ItemsSummary))
                        {
                            <p class="order-card__items">
                                Items: @order.ItemsSummary
                            </p>
                        }

                    </div>
                }
            }
        </div>

        <!-- ─── PAGINATION ────────────────────────────────── -->
        <PaginationComponent TItem="OrderModel"
                             TotalCount="@totalCount"
                             CurrentPage="@currentPage"
                             PageSize="@pageSize"
                             OnPageChanged="HandlePageChanged" />
    }
    else if (activeMainTab == "returns")
    {
        <!-- ─── RETURN STATUS FILTER TABS ────────────────── -->
        <div class="orders-status-tabs">
            @foreach (var tab in ReturnStatusTabs)
            {
                <button class="orders-status-tab @(activeReturnStatus == tab.Value ? "active" : "inactive")"
                        @onclick="() => SetReturnStatus(tab.Value)">
                    @tab.Label
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(returnActionError))
        {
            <p class="orders-error">@returnActionError</p>
        }

        @if (!string.IsNullOrEmpty(returnSuccessMessage))
        {
            <div class="orders-success-banner">
                <span>@returnSuccessMessage</span>
                <button type="button" class="orders-success-banner__link" @onclick="NavigateToRefundsTab">
                    Go to Refunds
                </button>
            </div>
        }

        <!-- ─── RETURN CARDS ─────────────────────────────── -->
        <div class="orders-list">
            @if (isLoadingReturns && !returns.Any())
            {
                <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminCardList"
                                   Count="4"
                                   AriaLabel="Loading returns" />
            }
            else if (!returns.Any())
            {
                <p class="@(string.IsNullOrEmpty(returnsError) ? "orders-empty" : "orders-error")">@(string.IsNullOrEmpty(returnsError) ? "No returns found." : returnsError)</p>
            }
            else
            {
                @foreach (var item in returns)
                {
                    <div class="order-card">

                        <!-- TOP ROW: return number + badge + buttons -->
                        <div class="order-card__top">
                            <div class="order-card__left">
                                <p class="order-card__number">
                                    #@item.ReturnNumber
                                </p>
                                <span class="status-badge @GetReturnBadgeClass(item.Status)">
                                    @item.Status
                                </span>
                            </div>

                            <div class="order-card__actions">
                                <button type="button" class="btn-view btn-view--icon"
                                        aria-label="View return"
                                        @onclick="() => OpenReturnViewPanel(item)">
                                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                         stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                        <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                                        <circle cx="12" cy="12" r="3"></circle>
                                    </svg>
                                </button>
                            @if (item.Status?.ToLower() == "pending")
                            {
                                    <button class="btn-process"
                                            @onclick="() => ApproveReturn(item.Id)">
                                        Approve
                                    </button>
                                    <button class="btn-deny"
                                            @onclick="() => DenyReturn(item.Id)">
                                        Deny
                                    </button>
                            }
                            </div>
                        </div>

                        @if (item.Status?.ToLower() == "approved")
                        {
                            <p class="order-card__workflow-hint">
                                Refund may be pending —
                                <button type="button" class="order-card__workflow-link" @onclick="NavigateToRefundsTab">
                                    view in Refunds
                                </button>
                            </p>
                        }

                        <!-- SECOND ROW: order number · email · date -->
                        <p class="order-card__meta">
                            Order: #@item.OrderNumber
                            · @item.Email
                            · @item.CreatedAt?.ToString("MMM dd, yyyy")
                        </p>

                        <!-- THIRD ROW: reason -->
                        <p class="order-card__items">
                            Reason: @item.Reason
                        </p>

                    </div>
                }
            }
        </div>

        <!-- ─── PAGINATION ────────────────────────────────── -->
        <PaginationComponent TItem="OrderReturnModel"
                             TotalCount="@returnsTotalCount"
                             CurrentPage="@returnsCurrentPage"
                             PageSize="@returnsPageSize"
                             OnPageChanged="HandleReturnsPageChanged" />
    }
    else if (activeMainTab == "refunds")
    {
        <!-- ─── REFUND STATUS FILTER TABS ────────────────── -->
        <div class="orders-status-tabs">
            @foreach (var tab in RefundStatusTabs)
            {
                <button class="orders-status-tab @(activeRefundStatus == tab.Value ? "active" : "inactive")"
                        @onclick="() => SetRefundStatus(tab.Value)">
                    @tab.Label
                </button>
            }
        </div>

        @if (!string.IsNullOrEmpty(refundsError))
        {
            <p class="orders-error">@refundsError</p>
        }

        <!-- ─── REFUND CARDS ─────────────────────────────── -->
        <div class="orders-list">
            @if (isLoadingRefunds && !refunds.Any())
            {
                <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminCardList"
                                   Count="4"
                                   AriaLabel="Loading refunds" />
            }
            else if (refundsTotalCount == 0 && string.IsNullOrEmpty(refundsError))
            {
                <p class="orders-empty">No refunds found.</p>
            }
            else if (!refunds.Any())
            {
                <p class="orders-empty">@(string.IsNullOrEmpty(refundsError) ? "No refunds on this page." : refundsError)</p>
            }
            else
            {
                @foreach (var item in refunds)
                {
                    <div class="order-card">
                        <div class="order-card__top">
                            <div class="order-card__left">
                                <p class="order-card__number">
                                    @item.RefundNumber
                                </p>
                                <span class="status-badge @GetRefundBadgeClass(item.Status)">
                                    @item.Status
                                </span>
                            </div>

                            @if (CanProcessRefund(item.Status))
                            {
                                <div class="order-card__actions">
                                    <button type="button" class="btn-view btn-view--icon"
                                            aria-label="View refund"
                                            @onclick="() => OpenRefundViewPanel(item)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </button>
                                    <button class="btn-process"
                                            disabled="@(processingRefundId == item.Id || isRefundProcessing)"
                                            @onclick="() => OpenRefundProcessModal(item)">
                                        @(processingRefundId == item.Id || (isRefundProcessing && processingRefund?.Id == item.Id)
                                            ? "Processing..."
                                            : "Process Refund")
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="order-card__actions">
                                    <button type="button" class="btn-view btn-view--icon"
                                            aria-label="View refund"
                                            @onclick="() => OpenRefundViewPanel(item)">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                            <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </button>
                                </div>
                            }
                        </div>

                        <p class="order-card__meta">
                            Order: @item.OrderNumber
                            · @(string.IsNullOrEmpty(item.FullName) ? item.Email : $"{item.FullName} · {item.Email}")
                            · @item.CreatedAt?.ToString("MMM dd, yyyy")
                        </p>

                        <p class="order-card__items">
                            $@item.Amount.ToString("F2")
                            @if (!string.IsNullOrEmpty(item.FailureReason))
                            {
                                <span> · @item.FailureReason</span>
                            }
                        </p>
                    </div>
                }
            }
        </div>

        <PaginationComponent TItem="RefundModel"
                             TotalCount="@refundsTotalCount"
                             CurrentPage="@refundsCurrentPage"
                             PageSize="@refundsPageSize"
                             OnPageChanged="HandleRefundsPageChanged" />
    }

</div>

<!-- ─── VIEW PANEL ────────────────────────────────────────── -->
@if (isViewPanelOpen)
{
    <div class="orders-panel-overlay" @onclick="CloseViewPanel"></div>

    <div class="orders-panel">

        <button class="orders-panel__close" @onclick="CloseViewPanel">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
        </button>

        @if (viewPanelKind == "order" && viewOrder != null)
        {
        <p class="orders-panel__eyebrow">Order Details</p>
        <h2 class="orders-panel__title">#@viewOrder.OrderNumber</h2>

        @if (isLoadingDetail)
        {
            <p style="color:#4A5C7A;font-size:14px">Loading...</p>
        }
        else if (!string.IsNullOrEmpty(viewDetailError))
        {
            <p class="orders-error">@viewDetailError</p>
        }
        else
        {
            <!-- STATUS + DATE -->
            <div class="orders-panel__section">
                <div style="display:flex;gap:13px;align-items:center;margin-bottom:8px">
                    <span class="status-badge @GetStatusBadgeClass(viewOrder.Status)">
                        @viewOrder.Status
                    </span>
                    <span style="color:#4A5C7A;font-size:12px">
                        @viewOrder.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")
                    </span>
                </div>
                <p class="orders-panel__value">@viewOrder.Email</p>
            </div>

            <!-- SHIPPING ADDRESS -->
            <div class="orders-panel__section">
                <p class="orders-panel__label">Shipping Address</p>
                <div class="process-modal__address">
                    @viewOrder.FirstName @viewOrder.LastName<br />
                    @viewOrder.Address<br />
                    @viewOrder.City, @viewOrder.PostalCode
                </div>
            </div>

            <!-- ORDER ITEMS -->
            @if (viewOrder.Items.Any())
            {
                <div class="orders-panel__section">
                    <p class="orders-panel__label">Items</p>
                    @foreach (var item in viewOrder.Items)
                    {
                        <div class="panel-item">
                            @if (!string.IsNullOrEmpty(item.ProductImageUrl))
                            {
                                <img src="@item.ProductImageUrl"
                                     class="panel-item__img"
                                     alt="@item.ProductName" />
                            }
                            else
                            {
                                <div class="panel-item__img"></div>
                            }
                            <div>
                                <p class="panel-item__name">@item.ProductName</p>
                                <p class="panel-item__meta">
                                    Size: @item.Size · Qty: @item.Quantity
                                </p>
                                <p class="panel-item__meta">
                                    $@item.Price.ToString("F2") each
                                    → $@item.ItemTotal.ToString("F2")
                                </p>
                            </div>
                        </div>
                    }
                </div>
            }

    <!-- ORDER TOTALS -->
    <div class="orders-panel__section">
        <p class="orders-panel__label">Summary</p>
        <div class="orders-panel__row">
            <span class="orders-panel__row-label">Subtotal</span>
            <span class="orders-panel__row-value">
                $@viewOrder.Subtotal.ToString("F2")
            </span>
        </div>
        <div class="orders-panel__row">
            <span class="orders-panel__row-label">Shipping</span>
            <span class="orders-panel__row-value">
                @(viewOrder.Shipping == 0
                                ? "Free"
                                : "$" + viewOrder.Shipping.ToString("F2"))
            </span>
        </div>
        <div class="orders-panel__row">
            <span class="orders-panel__row-label">Tax</span>
            <span class="orders-panel__row-value">
                $@viewOrder.Tax.ToString("F2")
            </span>
        </div>
        <div class="orders-panel__row" style="border-top:1px solid rgba(169,183,204,0.3);padding-top:8px;margin-top:4px">
            <span class="orders-panel__row-label">Total</span>
            <span class="orders-panel__row-total">
                $@viewOrder.Total.ToString("F2")
            </span>
        </div>
    </div>
        }
        }
        else if (viewPanelKind == "return" && viewReturn != null)
        {
            <p class="orders-panel__eyebrow">Return Details</p>
            <h2 class="orders-panel__title">#@viewReturn.ReturnNumber</h2>

            <div class="orders-panel__section">
                <span class="status-badge @GetReturnBadgeClass(viewReturn.Status)">@viewReturn.Status</span>
                <p class="orders-panel__value">@viewReturn.FullName · @viewReturn.Email</p>
                <p class="orders-panel__meta">Submitted @viewReturn.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")</p>
            </div>

            <div class="orders-panel__section">
                <p class="orders-panel__label">Order</p>
                <p class="orders-panel__value">#@viewReturn.OrderNumber</p>
            </div>

            <div class="orders-panel__section">
                <p class="orders-panel__label">Items to Return</p>
                <p class="orders-panel__value">@viewReturn.ItemsToReturn</p>
            </div>

            <div class="orders-panel__section">
                <p class="orders-panel__label">Reason</p>
                <p class="orders-panel__value">@viewReturn.Reason</p>
            </div>

            @if (!string.IsNullOrEmpty(viewReturn.Comments))
            {
                <div class="orders-panel__section">
                    <p class="orders-panel__label">Comments</p>
                    <p class="orders-panel__value">@viewReturn.Comments</p>
                </div>
            }

            @if (viewReturn.Status?.ToLower() == "approved")
            {
                <div class="orders-panel__section">
                    <button type="button" class="btn-process" @onclick="NavigateToRefundsTab">
                        View pending refund
                    </button>
                </div>
            }
        }
        else if (viewPanelKind == "refund" && viewRefund != null)
        {
            <p class="orders-panel__eyebrow">Refund Details</p>
            <h2 class="orders-panel__title">@viewRefund.RefundNumber</h2>

            <div class="orders-panel__section">
                <span class="status-badge @GetRefundBadgeClass(viewRefund.Status)">@viewRefund.Status</span>
                <p class="orders-panel__value">
                    @(string.IsNullOrEmpty(viewRefund.FullName) ? viewRefund.Email : $"{viewRefund.FullName} · {viewRefund.Email}")
                </p>
                <p class="orders-panel__meta">Created @viewRefund.CreatedAt?.ToString("MMM dd, yyyy · hh:mm tt")</p>
            </div>

            <div class="orders-panel__section">
                <p class="orders-panel__label">Order</p>
                <p class="orders-panel__value">@viewRefund.OrderNumber</p>
            </div>

            <div class="orders-panel__section">
                <p class="orders-panel__label">Amount</p>
                <p class="orders-panel__row-total">$@viewRefund.Amount.ToString("F2") @(viewRefund.Currency ?? "USD")</p>
            </div>

            @if (viewRefund.ProcessedAt.HasValue)
            {
                <div class="orders-panel__section">
                    <p class="orders-panel__label">Processed</p>
                    <p class="orders-panel__value">@viewRefund.ProcessedAt?.ToString("MMM dd, yyyy · hh:mm tt")</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(viewRefund.StripeRefundId))
            {
                <div class="orders-panel__section">
                    <p class="orders-panel__label">Stripe Refund ID</p>
                    <p class="orders-panel__value">@viewRefund.StripeRefundId</p>
                </div>
            }

            @if (!string.IsNullOrEmpty(viewRefund.FailureReason))
            {
                <div class="orders-panel__section">
                    <p class="orders-panel__label">Failure Reason</p>
                    <p class="orders-panel__value orders-panel__value--error">@viewRefund.FailureReason</p>
                </div>
            }

            @if (CanProcessRefund(viewRefund.Status))
            {
                <div class="orders-panel__section">
                    <button type="button" class="btn-process" @onclick="() => OpenRefundProcessModal(viewRefund)">
                        Process Refund
                    </button>
                </div>
            }
        }

    </div>
}

<!-- ─── PROCESS MODAL ──────────────────────────────────────── -->
@if (isProcessModalOpen && processingOrder != null)
{
    <div class="process-modal-overlay" @onclick="CloseProcessModal">
        <div class="process-modal" @onclick:stopPropagation="true">

            <h3 class="process-modal__title">
                @GetNextAction(processingOrder.Status)?.ModalTitle
            </h3>
            <p class="process-modal__subtitle">
                @GetNextAction(processingOrder.Status)?.ModalSubtitle
            </p>

            <!-- show address only for Pending → Processing -->
            @if (processingOrder.Status?.ToLower() == "pending")
            {
                @if (isLoadingProcessDetail)
                {
                    <p style="color:#4A5C7A;font-size:13px">Loading address...</p>
                }
                else
                {
                    <div class="process-modal__address">
                        <strong>
                            @processOrderDetail?.FirstName @processOrderDetail?.LastName
                        </strong><br />
                        @processOrderDetail?.Address<br />
                        @processOrderDetail?.City, @processOrderDetail?.PostalCode<br />
                        @processOrderDetail?.Email
                    </div>
                }
            }

            @if (!string.IsNullOrEmpty(processError))
            {
                <p style="color:#C44545;font-size:13px;margin-bottom:13px">
                    @processError
                </p>
            }

        <div class="process-modal__actions">
            <button class="btn-view w-100" @onclick="CloseProcessModal">
                Cancel
            </button>
            <button class="btn-process"
                    style="flex:1"
                    @onclick="ConfirmProcess"
                    disabled="@isProcessing">
                @(isProcessing
                                ? "Updating..."
                                : GetNextAction(processingOrder.Status)?.Label ?? "Confirm")
            </button>
        </div>

        </div>
    </div>
}

@if (isRefundProcessModalOpen && processingRefund != null)
{
    <div class="process-modal-overlay" @onclick="CloseRefundProcessModal">
        <div class="process-modal" @onclick:stopPropagation="true">

            <h3 class="process-modal__title">Process Refund</h3>
            <p class="process-modal__subtitle">
                Confirm processing refund @processingRefund.RefundNumber for order @processingRefund.OrderNumber
                ($@processingRefund.Amount.ToString("F2")). This will initiate the refund with the payment provider.
            </p>

            @if (!string.IsNullOrEmpty(refundProcessError))
            {
                <p class="orders-error orders-error--modal">@refundProcessError</p>
            }

            <div class="process-modal__actions">
                <button class="btn-view w-100" @onclick="CloseRefundProcessModal">
                    Cancel
                </button>
                <button class="btn-process"
                        style="flex:1"
                        @onclick="ConfirmProcessRefund"
                        disabled="@isRefundProcessing">
                    @(isRefundProcessing ? "Processing..." : "Confirm Refund")
                </button>
            </div>

        </div>
    </div>
}

@if (isBulkModalOpen)
{
    <div class="process-modal-overlay" @onclick="CloseBulkModal">
        <div class="process-modal" @onclick:stopPropagation="true">

            <h3 class="process-modal__title">
                Bulk Update @selectedOrderIds.Count Order@(selectedOrderIds.Count == 1 ? "" : "s")
            </h3>
            <p class="process-modal__subtitle">
                Select the new status for all @selectedOrderIds.Count
                selected order@(selectedOrderIds.Count == 1 ? "" : "s").
                This cannot be undone.
            </p>

            <!-- STATUS PICKER -->
            <div style="margin-bottom:21px">
                @foreach (var s in new[]
                            {
                        ("pending",    "Pending"),
                        ("processing", "Processing"),
                        ("shipped",    "Shipped"),
                        ("delivered",  "Delivered")
                        })
                {
                    <label style="display:flex;align-items:center;
                                                                                                                                                                                  gap:10px;padding:10px;cursor:pointer;
                                                                                                                                                                                  border:1px solid @(bulkTargetStatus == s.Item1
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            ? "#1E2A47"
                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                            : "rgba(169,183,204,0.3)");
                                  margin-bottom:8px;
                                  background:@(bulkTargetStatus == s.Item1
                                                                                                                                                                                                                                                                                                                                                                                            ? "#F4F6F9"
                                                                                                                                                                                                                                                                                                                                                                                            : "white")">
                <input type="radio"
                       name="bulkStatus"
                       value="@s.Item1"
                       checked="@(bulkTargetStatus == s.Item1)"
                       @onchange="() => bulkTargetStatus = s.Item1" />
                <span class="status-badge @GetStatusBadgeClass(s.Item1)">
                    @s.Item2
                </span>
            </label>
                        }
            </div>

            @if (!string.IsNullOrEmpty(processError))
            {
                <p style="color:#C44545;font-size:13px;margin-bottom:13px">
                    @processError
                </p>
            }

            <div class="process-modal__actions">
                <button class="btn-view" style="flex:1"
                        @onclick="CloseBulkModal">
                    Cancel
                </button>
                <button class="btn-process"
                        style="flex:1"
                        @onclick="ConfirmBulkUpdate"
                        disabled="@(isBulkUpdating || string.IsNullOrEmpty(bulkTargetStatus))">
                    @(isBulkUpdating ? "Updating..." : "Apply Update")
                </button>
            </div>

        </div>
    </div>
}

<PageReadyNotifier IsLoading="@(isLoading && !orders.Any())" />
