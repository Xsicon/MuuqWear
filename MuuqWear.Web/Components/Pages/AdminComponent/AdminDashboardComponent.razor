@page "/admin"
@using MuuqWear.Application.Shared
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using MuuqWear.Application.Interfaces
@using MuuqWear.Application.Services.AdminBadgeService
@using MuuqWear.Application.Services.AffiliateService
@using MuuqWear.Application.Services.HelpCenterService
@using MuuqWear.Application.Services.OrderService
@using MuuqWear.Application.Services.ProductService
@using MuuqWear.Model.AffiliateApplication
@using MuuqWear.Model.HelpCenter
@using MuuqWear.Model.Orders
@using MuuqWear.Model.Products
@using MuuqWear.Model.Shared
@layout Components.Layout.AdminLayoutComponent.AdminDashboardLayoutComponent
@rendermode InteractiveServer
@attribute [Authorize(Policy = AdminPortalPolicies.Overview)]
@inject IOrderService OrderService
@inject IHelpCenterService HelpService
@inject IAdminBadgeService BadgeService
@using MuuqWear.Application.Services.AdminSystemService
@using MuuqWear.Web.Services
@inject IAdminSystemService AdminSystemService
@inject AdminLowStockCacheService LowStockCache
@inject IAffiliateService AffiliateService
@using MuuqWear.Web.Helpers
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>Admin Dashboard</PageTitle>

<div class="ov-page">

    @if (isLoading)
    {
        <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminOverview"
                           AriaLabel="Loading dashboard" />
    }
    else
    {
        <!-- Welcome -->
        <header class="ov-welcome">
            <h1 class="ov-welcome__title">Welcome back, @userFirstName!</h1>
            <p class="ov-welcome__sub">@welcomeMessage</p>
        </header>

        @if (!string.IsNullOrEmpty(loadError))
        {
            <p class="ov-load-error">@loadError</p>
        }

        <!-- Stats -->
        @if (HasVisibleStats)
        {
        <div class="ov-stats">
            @if (CanSeeSection(AdminPortalSection.Orders))
            {
            <div class="ov-stat ov-stat--link">
                <a href="/admin/orders?tab=orders&status=pending" class="ov-stat__link">
                <div class="ov-stat__top">
                    <span class="ov-stat__icon ov-stat__icon--green" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>
                    </span>
                    @if (pendingOrders > 0)
                    {
                        <span class="ov-stat__trend ov-stat__trend--up">+@pendingOrders</span>
                    }
                </div>
                <p class="ov-stat__value">@pendingOrders</p>
                <p class="ov-stat__label">Active Orders</p>
                </a>
            </div>
            }

            @if (CanSeeSection(AdminPortalSection.Support))
            {
            <div class="ov-stat ov-stat--link">
                <a href="/admin/support?tab=tickets" class="ov-stat__link">
                <div class="ov-stat__top">
                    <span class="ov-stat__icon ov-stat__icon--orange" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
                    </span>
                    @if (openTickets > 0)
                    {
                        <span class="ov-stat__trend ov-stat__trend--down">@openTickets</span>
                    }
                </div>
                <p class="ov-stat__value">@openTickets</p>
                <p class="ov-stat__label">Pending Support</p>
                </a>
            </div>
            }

            @if (CanSeeSection(AdminPortalSection.Products))
            {
            <div class="ov-stat ov-stat--link">
                <a href="/admin/products?view=low-stock" class="ov-stat__link">
                <div class="ov-stat__top">
                    <span class="ov-stat__icon ov-stat__icon--red" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>
                    </span>
                    @if (lowStockCount > 0)
                    {
                        <span class="ov-stat__trend ov-stat__trend--warn">@lowStockCount</span>
                    }
                </div>
                <p class="ov-stat__value">@lowStockCount</p>
                <p class="ov-stat__label">Low Stock Items</p>
                @if (lowStockCount > 0)
                {
                    <p class="ov-stat__hint">Below @ProductStockHelper.LowStockThreshold units · View alerts</p>
                }
                </a>
            </div>
            }

            @if (CanSeeSection(AdminPortalSection.Affiliates))
            {
            <div class="ov-stat ov-stat--link">
                <a href="/admin/affiliates?tab=pending" class="ov-stat__link">
                <div class="ov-stat__top">
                    <span class="ov-stat__icon ov-stat__icon--green" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line x1="22" x2="16" y1="11" y2="11"></line></svg>
                    </span>
                    @if (pendingAffiliateApplications > 0)
                    {
                        <span class="ov-stat__trend ov-stat__trend--up">@pendingAffiliateApplications</span>
                    }
                </div>
                <p class="ov-stat__value">@pendingAffiliateApplications</p>
                <p class="ov-stat__label">Affiliate Applications</p>
                </a>
            </div>
            }

            @if (CanSeeSection(AdminPortalSection.System))
            {
            <div class="ov-stat ov-stat--link">
                <a href="/admin/system?tab=health" class="ov-stat__link">
                <div class="ov-stat__top">
                    <span class="ov-stat__icon ov-stat__icon--green" aria-hidden="true">
                        <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.801 10A10 10 0 1 1 17 3.335"></path><path d="m9 11 3 3L22 4"></path></svg>
                    </span>
                    @if (systemHealthLoaded && systemHealthHealthy)
                    {
                        <span class="ov-stat__trend ov-stat__trend--up">OK</span>
                    }
                </div>
                <p class="ov-stat__value">@systemHealthValue</p>
                <p class="ov-stat__label">System Status</p>
                </a>
            </div>
            }
        </div>
        }

        <!-- Your Access + Recent Activity -->
        <div class="ov-grid">
            <section class="ov-panel">
                <h2 class="ov-panel__title">Your Access</h2>
                <ul class="ov-access-list">
                    @foreach (var module in accessModules)
                    {
                        <li @key="module.Href">
                            <a href="@module.Href" class="ov-access-item">
                                <span class="ov-access-item__icon" aria-hidden="true">@module.Icon</span>
                                <span class="ov-access-item__text">
                                    <span class="ov-access-item__label">@module.Label</span>
                                    <span class="ov-access-item__desc">@module.Description</span>
                                </span>
                            </a>
                        </li>
                    }
                </ul>
            </section>

            <section class="ov-panel">
                <h2 class="ov-panel__title">Recent Activity</h2>
                @if (!recentActivity.Any())
                {
                    <p class="ov-empty">No recent activity.</p>
                }
                else
                {
                    <ul class="ov-activity-list">
                        @foreach (var item in recentActivity)
                        {
                            <li class="ov-activity-item" @key="item.Key">
                                <span class="ov-activity-item__icon" aria-hidden="true">@item.Icon</span>
                                <span class="ov-activity-item__text">
                                    <span class="ov-activity-item__action">@item.Action</span>
                                    <span class="ov-activity-item__time">@item.TimeDisplay</span>
                                </span>
                            </li>
                        }
                    </ul>
                }
            </section>
        </div>
    }

</div>

<PageReadyNotifier IsLoading="isLoading" />

@code {
    private bool isLoading = true;
    private string? loadError;
    private string userFirstName = "Admin";
    private string? userRole;
    private string welcomeMessage = "Welcome to the Muuqwear internal dashboard.";
    private int pendingOrders;
    private int openTickets;
    private int pendingAffiliateApplications;
    private int lowStockCount;
    private List<ProductModel> lowStockProducts = new();

    private List<AccessModule> accessModules = new();
    private List<ActivityItem> recentActivity = new();
    private string systemHealthValue = "—";
    private bool systemHealthHealthy;
    private bool systemHealthLoaded;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;
            userRole = AdminPortalUserContext.GetRole(user);
            welcomeMessage = AdminPortalRoles.GetWelcomeMessage(userRole);

            var fullName = user.FindFirst("FullName")?.Value
                           ?? user.FindFirst("name")?.Value
                           ?? "Admin";
            userFirstName = fullName.Trim().Split(' ', StringSplitOptions.RemoveEmptyEntries).FirstOrDefault() ?? "Admin";

            accessModules = BuildAccessModules(userRole);

            var loadTasks = new List<Task>();
            if (NeedsBadgeCounts)
                loadTasks.Add(LoadBadgeCounts());
            if (CanSeeSection(AdminPortalSection.Products))
                loadTasks.Add(LoadLowStockProducts());
            if (CanSeeSection(AdminPortalSection.System))
                loadTasks.Add(LoadSystemHealth());
            if (loadTasks.Count > 0)
                await Task.WhenAll(loadTasks);

            await LoadRecentActivity();
        }
        catch (Exception ex)
        {
            loadError = AdminUiErrorHelper.FromException(ex);
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task LoadSystemHealth()
    {
        var result = await AdminSystemService.GetOverviewAsync();
        systemHealthLoaded = true;

        if (result.Success && result.Data != null)
        {
            var overview = result.Data;
            systemHealthHealthy = overview.DatabaseIsHealthy && overview.StripeIsHealthy && overview.SupabaseIsHealthy;
            systemHealthValue = systemHealthHealthy ? "Healthy" : "Degraded";
        }
        else
        {
            systemHealthHealthy = false;
            systemHealthValue = "Unavailable";
        }
    }

    private async Task LoadLowStockProducts()
    {
        lowStockProducts = (await LowStockCache.GetLowStockProductsAsync()).ToList();
        lowStockCount = lowStockProducts.Count;
    }

    private async Task LoadBadgeCounts()
    {
        var badgeResult = await BadgeService.GetCounts();
        if (badgeResult.Success && badgeResult.Data != null)
        {
            pendingOrders = badgeResult.Data.PendingOrders;
            openTickets = badgeResult.Data.OpenTickets;
            pendingAffiliateApplications = badgeResult.Data.AffiliateCounts.Pending;
        }
    }

    private async Task LoadRecentActivity()
    {
        var activities = new List<ActivityItem>();

        Task<Response<PaginatedResponse<OrderModel>>>? ordersTask = null;
        Task<Response<PaginatedResponse<SupportTicketModel>>>? ticketsTask = null;
        Task<Response<List<AffiliateApplicationModel>>>? affiliatesTask = null;

        if (CanSeeSection(AdminPortalSection.Orders))
            ordersTask = OrderService.GetAllOrders(null, null, 1, 3);
        if (CanSeeSection(AdminPortalSection.Support))
            ticketsTask = HelpService.GetAllTickets(null, 1, 3);
        if (CanSeeSection(AdminPortalSection.Affiliates))
            affiliatesTask = AffiliateService.GetAllApplications("pending");

        var pendingTasks = new List<Task>();
        if (ordersTask != null)
            pendingTasks.Add(ordersTask);
        if (ticketsTask != null)
            pendingTasks.Add(ticketsTask);
        if (affiliatesTask != null)
            pendingTasks.Add(affiliatesTask);
        if (pendingTasks.Count > 0)
            await Task.WhenAll(pendingTasks);

        if (ordersTask is not null)
        {
            var ordersResult = await ordersTask;
            if (ordersResult.Success && ordersResult.Data?.Data != null)
            {
                foreach (var order in ordersResult.Data.Data)
                {
                    activities.Add(new ActivityItem
                    {
                        Key = $"order-{order.Id}",
                        Action = $"New order #{order.OrderNumber}",
                        TimeDisplay = FormatRelativeTime(order.CreatedAt),
                        SortAt = order.CreatedAt ?? DateTime.MinValue,
                        Icon = OrderIcon()
                    });
                }
            }
        }

        if (ticketsTask is not null)
        {
            var ticketsResult = await ticketsTask;
            if (ticketsResult.Success && ticketsResult.Data?.Data != null)
            {
                foreach (var ticket in ticketsResult.Data.Data)
                {
                    activities.Add(new ActivityItem
                    {
                        Key = $"ticket-{ticket.Id}",
                        Action = $"Support ticket {ticket.TicketNumber}",
                        TimeDisplay = FormatRelativeTime(ticket.CreatedAt),
                        SortAt = ticket.CreatedAt ?? DateTime.MinValue,
                        Icon = TicketIcon()
                    });
                }
            }
        }

        if (affiliatesTask is not null)
        {
            var affiliatesResult = await affiliatesTask;
            if (affiliatesResult.Success && affiliatesResult.Data != null)
            {
                foreach (var app in affiliatesResult.Data.Take(2))
                {
                    activities.Add(new ActivityItem
                    {
                        Key = $"affiliate-{app.Id}",
                        Action = $"Affiliate application from {app.FullName}",
                        TimeDisplay = FormatRelativeTime(app.SubmittedAt),
                        SortAt = app.SubmittedAt,
                        Icon = AffiliateIcon()
                    });
                }
            }
        }

        if (CanSeeSection(AdminPortalSection.Products))
        {
            foreach (var product in lowStockProducts.Take(3))
            {
                activities.Add(new ActivityItem
                {
                    Key = $"lowstock-{product.Id}",
                    Action = $"Low stock alert: {product.Name}",
                    TimeDisplay = $"{ProductStockHelper.GetEffectiveStock(product)} unit{(ProductStockHelper.GetEffectiveStock(product) == 1 ? "" : "s")} left",
                    SortAt = DateTime.UtcNow.AddMinutes(-ProductStockHelper.GetEffectiveStock(product)),
                    Icon = LowStockIcon()
                });
            }
        }

        recentActivity = activities
            .OrderByDescending(a => a.SortAt)
            .Take(5)
            .ToList();
    }

    private bool CanSeeSection(string section) =>
        AdminPortalRoles.CanAccess(userRole, section);

    private bool NeedsBadgeCounts =>
        CanSeeSection(AdminPortalSection.Orders)
        || CanSeeSection(AdminPortalSection.Support)
        || CanSeeSection(AdminPortalSection.Affiliates);

    private bool HasVisibleStats =>
        CanSeeSection(AdminPortalSection.Orders)
        || CanSeeSection(AdminPortalSection.Support)
        || CanSeeSection(AdminPortalSection.Products)
        || CanSeeSection(AdminPortalSection.Affiliates)
        || CanSeeSection(AdminPortalSection.System);

    private static List<AccessModule> BuildAccessModules(string? role)
    {
        var modulesBySection = new Dictionary<string, AccessModule>(StringComparer.OrdinalIgnoreCase)
        {
            [AdminPortalSection.Orders] = new("Sales & Orders", "Full order management", "/admin/orders?tab=orders", OrdersAccessIcon()),
            [AdminPortalSection.Customers] = new("Customers", "Customer database access", "/admin/customers", CustomersAccessIcon()),
            [AdminPortalSection.Products] = new("Products & Inventory", "Complete product control", "/admin/products?view=catalog", ProductsAccessIcon()),
            [AdminPortalSection.Content] = new("Content", "Content management system", "/admin/content", ContentAccessIcon()),
            [AdminPortalSection.Affiliates] = new("Affiliate Program", "Affiliate management", "/admin/affiliates", AffiliatesAccessIcon()),
            [AdminPortalSection.Support] = new("Customer Support", "Support system access", "/admin/support?tab=tickets", SupportAccessIcon()),
            [AdminPortalSection.Careers] = new("Career Management", "Job posting & hiring", "/admin/careers?tab=postings", CareersAccessIcon()),
            [AdminPortalSection.System] = new("System & Technology", "System administration", "/admin/system?tab=health", SystemAccessIcon()),
        };

        return AdminPortalRoles.GetSections(role)
            .Where(section => !section.Equals(AdminPortalSection.Overview, StringComparison.OrdinalIgnoreCase))
            .Where(modulesBySection.ContainsKey)
            .Select(section => modulesBySection[section])
            .ToList();
    }

    private static string FormatRelativeTime(DateTime? utc)
    {
        if (utc is null) return "Recently";
        var diff = DateTime.UtcNow - utc.Value.ToUniversalTime();
        if (diff.TotalMinutes < 1) return "Just now";
        if (diff.TotalMinutes < 60) return $"{(int)diff.TotalMinutes} min ago";
        if (diff.TotalHours < 24) return $"{(int)diff.TotalHours} hr ago";
        if (diff.TotalDays < 7) return $"{(int)diff.TotalDays} days ago";
        return utc.Value.ToLocalTime().ToString("MMM d, yyyy");
    }

    private sealed class AccessModule(string label, string description, string href, RenderFragment icon)
    {
        public string Label { get; } = label;
        public string Description { get; } = description;
        public string Href { get; } = href;
        public RenderFragment Icon { get; } = icon;
    }

    private sealed class ActivityItem
    {
        public string Key { get; set; } = string.Empty;
        public string Action { get; set; } = string.Empty;
        public string TimeDisplay { get; set; } = string.Empty;
        public DateTime SortAt { get; set; }
        public RenderFragment Icon { get; set; } = _ => { };
    }

    private static RenderFragment OrderIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>;
    private static RenderFragment TicketIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>;
    private static RenderFragment AffiliateIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line x1="22" x2="16" y1="11" y2="11"></line></svg>;
    private static RenderFragment LowStockIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><line x1="12" x2="12" y1="8" y2="12"></line><line x1="12" x2="12.01" y1="16" y2="16"></line></svg>;

    private static RenderFragment OrdersAccessIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="8" cy="21" r="1"></circle><circle cx="19" cy="21" r="1"></circle><path d="M2.05 2.05h2l2.66 12.42a2 2 0 0 0 2 1.58h9.78a2 2 0 0 0 1.95-1.57l1.65-7.43H5.12"></path></svg>;
    private static RenderFragment CustomersAccessIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><path d="M22 21v-2a4 4 0 0 0-3-3.87"></path><path d="M16 3.13a4 4 0 0 1 0 7.75"></path></svg>;
    private static RenderFragment ProductsAccessIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.586 2.586A2 2 0 0 0 11.172 2H4a2 2 0 0 0-2 2v7.172a2 2 0 0 0 .586 1.414l8.704 8.704a2.426 2.426 0 0 0 3.42 0l6.58-6.58a2.426 2.426 0 0 0 0-3.42z"></path></svg>;
    private static RenderFragment ContentAccessIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z"></path><path d="M14 2v4a2 2 0 0 0 2 2h4"></path></svg>;
    private static RenderFragment AffiliatesAccessIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path><circle cx="9" cy="7" r="4"></circle><line x1="19" x2="19" y1="8" y2="14"></line><line x1="22" x2="16" y1="11" y2="11"></line></svg>;
    private static RenderFragment SupportAccessIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>;
    private static RenderFragment CareersAccessIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="14" x="2" y="6" rx="2"></rect><path d="M16 20V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"></path></svg>;
    private static RenderFragment SystemAccessIcon() => @<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="8" x="2" y="2" rx="2"></rect><rect width="20" height="8" x="2" y="14" rx="2"></rect><line x1="6" x2="6.01" y1="6" y2="6"></line><line x1="6" x2="6.01" y1="18" y2="18"></line></svg>;
}
