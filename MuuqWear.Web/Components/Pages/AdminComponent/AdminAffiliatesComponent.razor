@page "/admin/affiliates"
@layout Layout.AdminLayoutComponent.AdminDashboardLayoutComponent
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "admin")]
@implements IDisposable

<PageTitle>Affiliate Program</PageTitle>

@if (isLoading && !hasLoadedOnce)
{
    <div class="affiliates-page">
        <div class="affiliates-tabs-ref" role="tablist" aria-label="Affiliate sections">
            @foreach (var tab in TabViews)
            {
                <button type="button"
                        role="tab"
                        class="affiliates-tabs-ref__item affiliates-tabs-ref__item--disabled"
                        disabled>
                    @tab.Label
                </button>
            }
        </div>
        <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminAffiliateTab"
                           Count="5"
                           AriaLabel="Loading affiliates" />
    </div>
}
else
{
<div class="affiliates-page @(isLoadingTabContent ? "affiliates-page--refreshing" : "")">
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="affiliates-error">@errorMessage</p>
    }

    <div class="affiliates-tabs-ref" role="tablist" aria-label="Affiliate sections">
        @foreach (var tab in TabViews)
        {
            <button type="button"
                    role="tab"
                    aria-selected="@(activeTab == tab.Tab)"
                    class="affiliates-tabs-ref__item @(activeTab == tab.Tab ? "affiliates-tabs-ref__item--active" : "")"
                    @onclick="() => SwitchTab(tab.Tab)">
                @tab.Label
                @if (tab.Tab is "pending" or "active" or "payouts")
                {
                    var count = GetTabCount(tab.Tab);
                    @if (count > 0 || tab.Tab != "payouts")
                    {
                        <span class="affiliates-tabs-ref__count">@count</span>
                    }
                }
            </button>
        }
    </div>

    @if (activeTab == "pending")
    {
        <div class="aff-tab-header">
            <p class="aff-tab-eyebrow">Affiliate Program</p>
            <h2 class="aff-tab-title">Pending Applications <span class="aff-tab-title-muted">(@PendingReviewCount pending)</span></h2>
        </div>

        <div class="aff-stat-grid aff-stat-grid--3">
            <div class="aff-stat-card" style="background:#FEF3C7;border-color:#F59E0B30">
                <div class="aff-stat-card__icon" style="background:#F59E0B22;color:#F59E0B">@PendingReviewCount</div>
                <div><p class="aff-stat-card__value">@PendingReviewCount</p><p class="aff-stat-card__label">Awaiting Review</p></div>
            </div>
            <div class="aff-stat-card" style="background:#EDE9FE;border-color:#6366F130">
                <div class="aff-stat-card__icon" style="background:#6366F122;color:#6366F1">@WaitlistedCount</div>
                <div><p class="aff-stat-card__value">@WaitlistedCount</p><p class="aff-stat-card__label">Waitlisted</p></div>
            </div>
            <div class="aff-stat-card" style="background:#EEF1F8;border-color:#1E2A4730">
                <div class="aff-stat-card__icon" style="background:#1E2A4722;color:#1E2A47">@ApplicationsThisMonth</div>
                <div><p class="aff-stat-card__value">@ApplicationsThisMonth</p><p class="aff-stat-card__label">Total This Month</p></div>
            </div>
        </div>

        <div class="aff-toolbar">
            <div class="aff-search">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input placeholder="Search by name, handle, niche…" @bind="pendingSearch" @bind:event="oninput" />
            </div>
            <div class="aff-pill-group">
                @foreach (var filter in new[] { ("all", "All"), ("pending", "Pending"), ("waitlisted", "Waitlisted"), ("approved", "Approved"), ("denied", "Denied") })
                {
                    <button type="button" class="aff-pill @(pendingStatusFilter == filter.Item1 ? "aff-pill--active" : "")"
                            @onclick="() => SetPendingFilter(filter.Item1)">@filter.Item2</button>
                }
            </div>
        </div>

        <div class="aff-list">
            @if (IsCurrentTabLoading && !FilteredPendingApplications.Any())
            {
                <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminAffiliateRows"
                                   Count="4"
                                   AriaLabel="Loading applications" />
            }
            else if (!FilteredPendingApplications.Any())
            {
                <div class="aff-empty"><p>No applications match your filters.</p></div>
            }
            else
            {
                @foreach (var application in FilteredPendingApplications)
                {
                    <AffiliateRowComponent Application="@application"
                                           OnAction="HandleAction"
                                           ShowUndo="@(undoApplicationId == application.Id)"
                                           OnUndo="() => UndoLastApplicationActionAsync(application.Id)"
                                           Disabled="@isActionInProgress" />
                }
            }
        </div>
    }
    else if (activeTab == "active")
    {
        <div class="aff-tab-header">
            <p class="aff-tab-eyebrow">Affiliate Program</p>
            <h2 class="aff-tab-title">Active Affiliates (@ActiveAffiliateCountDisplay/@MaxActiveAffiliates)</h2>
        </div>

        <div class="aff-stat-grid aff-stat-grid--dynamic">
            @foreach (var card in GetTierStatCards())
            {
                var theme = AffiliateAdminDesignHelper.GetTierTheme(card.Key);
                <div class="aff-tier-stat" style="background:@theme.BgColor;border-color:@(theme.DotColor)30">
                    <p class="aff-tier-stat__value" style="color:@theme.TextColor">@card.Count</p>
                    <p class="aff-tier-stat__label" style="color:@theme.TextColor">@card.Label</p>
                </div>
            }
        </div>

        <div class="aff-stat-grid aff-stat-grid--2 aff-stat-grid--compact">
            <div class="aff-stat-card aff-stat-card--plain">
                <div class="aff-stat-card__icon aff-stat-card__icon--blue">$</div>
                <div><p class="aff-stat-card__value">$@TotalCommissionsPaid.ToString("N0")</p><p class="aff-stat-card__label">Total commissions paid</p></div>
            </div>
            <div class="aff-stat-card aff-stat-card--plain">
                <div class="aff-stat-card__icon aff-stat-card__icon--green">#</div>
                <div><p class="aff-stat-card__value">@TotalItemsSold.ToString("N0")</p><p class="aff-stat-card__label">Total items sold</p></div>
            </div>
        </div>

        <div class="aff-toolbar">
            <div class="aff-search">
                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
                <input placeholder="Search affiliates…" @bind="activeSearch" @bind:event="oninput" />
            </div>
            <div class="aff-pill-group">
                <button type="button" class="aff-pill @(activeTierFilter == "All" ? "aff-pill--active" : "")" @onclick='() => activeTierFilter = "All"'>All</button>
                @foreach (var option in GetTierFilterOptions())
                {
                    <button type="button" class="aff-pill @(activeTierFilter == option.Key || activeTierFilter == option.Label ? "aff-pill--active" : "")"
                            @onclick="() => activeTierFilter = option.Key">@option.Label</button>
                }
                <button type="button" class="aff-pill @(activeShowInactiveOnly ? "aff-pill--active aff-pill--danger" : "")"
                        @onclick="() => activeShowInactiveOnly = !activeShowInactiveOnly">
                    @(activeShowInactiveOnly ? "Showing Inactive" : "Show Inactive")
                </button>
            </div>
        </div>

        <div class="aff-list">
            @if (IsCurrentTabLoading && !FilteredActiveApplications.Any())
            {
                <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminAffiliateRows"
                                   Count="4"
                                   AriaLabel="Loading affiliates" />
            }
            else if (!FilteredActiveApplications.Any())
            {
                <div class="aff-empty"><p>No affiliates match your filters.</p></div>
            }
            else
            {
                @foreach (var application in FilteredActiveApplications)
                {
                    <AffiliateRowComponent Application="@application"
                                           OnAction="HandleAction"
                                           ShowActiveActions="true"
                                           Disabled="@isActionInProgress" />
                }
            }
        </div>
    }
    else if (activeTab == "payouts")
    {
        <div class="aff-tab-header aff-tab-header--row">
            <div>
                <p class="aff-tab-eyebrow">Affiliate Program</p>
                <h2 class="aff-tab-title">Payouts</h2>
            </div>
            @if (payoutView == "pending" && pendingPayouts.Any())
            {
                <button type="button" class="aff-btn-primary" @onclick="() => showProcessAllConfirm = true">
                    Process All (@pendingPayouts.Count) — $@TotalPendingPayoutAmount.ToString("N0")
                </button>
            }
        </div>

        <div class="aff-pill-group aff-pill-group--spaced">
            <button type="button" class="aff-pill @(payoutView == "pending" ? "aff-pill--active" : "")" @onclick='() => SetPayoutView("pending")'>Pending (@pendingPayouts.Count)</button>
            <button type="button" class="aff-pill @(payoutView == "history" ? "aff-pill--active" : "")" @onclick='() => SetPayoutView("history")'>History</button>
        </div>

        @if (payoutView == "pending")
        {
            <div class="aff-stat-grid aff-stat-grid--3">
                <div class="aff-stat-card aff-stat-card--stack" style="background:#FEF3C7;border-color:#F59E0B30">
                    <p class="aff-stat-card__eyebrow" style="color:#F59E0B">Pending Payout</p>
                    <p class="aff-stat-card__value-lg">$@TotalPendingPayoutAmount.ToString("N0")</p>
                    <p class="aff-stat-card__sub">@PendingPayoutCountDisplay affiliates</p>
                </div>
                <div class="aff-stat-card aff-stat-card--stack" style="background:#D1FAE5;border-color:#22C55E30">
                    <p class="aff-stat-card__eyebrow" style="color:#22C55E">Processed This Month</p>
                    <p class="aff-stat-card__value-lg">$@ProcessedThisMonthAmount.ToString("N0")</p>
                    <p class="aff-stat-card__sub">@ProcessedThisMonthCount transactions</p>
                </div>
                <div class="aff-stat-card aff-stat-card--stack" style="background:#EDE9FE;border-color:#6366F130">
                    <p class="aff-stat-card__eyebrow" style="color:#6366F1">Total Disbursed YTD</p>
                    <p class="aff-stat-card__value-lg">$@TotalDisbursedYtd.ToString("N0")</p>
                    <p class="aff-stat-card__sub">@DateTime.UtcNow.Year</p>
                </div>
            </div>

            <div class="aff-list">
                @if (IsCurrentTabLoading && !pendingPayouts.Any())
                {
                    <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminAffiliateRows"
                                       Count="4"
                                       AriaLabel="Loading payouts" />
                }
                else if (!pendingPayouts.Any())
                {
                    <div class="aff-empty"><p>No pending payouts to process</p></div>
                }
                else
                {
                    @foreach (var payout in pendingPayouts)
                    {
                        var theme = AffiliateAdminDesignHelper.GetTierTheme(payout.AffiliateTier);
                        var isProcessing = processingPayoutCode == payout.AffiliateCode;
                        <article class="aff-payout-row">
                            <div class="aff-payout-row__avatar">@AffiliateAdminDesignHelper.GetInitials(payout.AffiliateName)</div>
                            <div class="aff-payout-row__body">
                                <div class="aff-payout-row__title">
                                    <span class="aff-payout-row__name">@payout.AffiliateName</span>
                                    <span class="aff-row__tier-badge" style="background-color:@theme.BgColor;color:@theme.TextColor">
                                        <span class="aff-row__tier-dot" style="background-color:@theme.DotColor"></span>
                                        @FormatTierLabel(payout.AffiliateTier)
                                    </span>
                                </div>
                                <p class="aff-payout-row__meta">@payout.FormattedPaymentMethod · Due @payout.FormattedDate</p>
                            </div>
                            <p class="aff-payout-row__amount">@payout.FormattedAmount</p>
                            <button type="button" class="aff-btn-primary aff-btn-primary--sm" disabled="@isProcessing"
                                    @onclick="() => OpenPayoutConfirm(payout)">
                                @(isProcessing ? "Processing…" : "Process")
                            </button>
                        </article>
                    }
                }
            </div>
        }
        else
        {
            <div class="aff-list">
                @if (IsCurrentTabLoading && !payoutHistory.Any())
                {
                    <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminAffiliateRows"
                                       Count="4"
                                       AriaLabel="Loading payout history" />
                }
                else if (!payoutHistory.Any())
                {
                    <div class="aff-empty"><p>No payout history yet</p></div>
                }
                else
                {
                    @foreach (var batch in payoutHistory)
                    {
                        var theme = AffiliateAdminDesignHelper.GetTierTheme("bronze");
                        <article class="aff-payout-row">
                            <div class="aff-payout-row__avatar">@AffiliateAdminDesignHelper.GetInitials(batch.AffiliateName)</div>
                            <div class="aff-payout-row__body">
                                <div class="aff-payout-row__title">
                                    <span class="aff-payout-row__name">@batch.AffiliateName</span>
                                    <span class="aff-payout-row__processed">Processed</span>
                                </div>
                                <p class="aff-payout-row__meta">@batch.FormattedPaymentMethod · @batch.FormattedDate · @batch.ReferralCount referral@(batch.ReferralCount == 1 ? "" : "s")</p>
                            </div>
                            <p class="aff-payout-row__amount">@batch.FormattedAmount</p>
                        </article>
                    }
                }
            </div>

            @if (payoutHistoryTotalPages > 1)
            {
                <div class="affiliates-payout-pagination">
                    <button type="button" class="affiliates-payout-pagination__btn" disabled="@(!payoutHistoryHasPrevious || isLoading)" @onclick="() => GoToPayoutHistoryPage(payoutHistoryPage - 1)">Previous</button>
                    <span class="affiliates-payout-pagination__label">Page @payoutHistoryPage of @payoutHistoryTotalPages</span>
                    <button type="button" class="affiliates-payout-pagination__btn" disabled="@(!payoutHistoryHasNext || isLoading)" @onclick="() => GoToPayoutHistoryPage(payoutHistoryPage + 1)">Next</button>
                </div>
            }
        }
    }
    else if (activeTab == "tiers")
    {
        <div class="aff-tab-header aff-tab-header--row">
            <div>
                <p class="aff-tab-eyebrow">Affiliate Program</p>
                <h2 class="aff-tab-title">Tier Settings</h2>
                <p class="aff-tab-subtitle">Configure commission rates, thresholds, and perks for each affiliate tier</p>
            </div>
            <button type="button" class="aff-btn-ghost" @onclick="() => showTierResetConfirm = true">Reset to Defaults</button>
        </div>

        @if (tierHasUnsavedChanges)
        {
            <div class="aff-alert">
                You have unsaved changes. Commission rate changes take effect at the next billing cycle.
            </div>
        }

        @if (IsCurrentTabLoading && !affiliateTiers.Any())
        {
            <div class="aff-tier-grid">
                @for (var i = 0; i < 3; i++)
                {
                    <MwSkeleton Variant="MwSkeleton.SkeletonVariant.Block" Height="320px" Class="aff-tier-sk-card" />
                }
            </div>
        }
        else if (!affiliateTiers.Any())
        {
            <div class="aff-empty"><p>No tier settings found. Run the API migration and seed, then refresh.</p></div>
        }
        else
        {
            <div class="aff-tier-grid">
                @foreach (var tier in affiliateTiers)
                {
                    var theme = AffiliateAdminDesignHelper.GetTierTheme(tier.Slug);
                    var edit = tierEdits.GetValueOrDefault(tier.Slug);
                    if (edit == null) continue;
                    var isEditing = editingTierSlug == tier.Slug;
                    var displayPerks = isEditing
                        ? edit.Perks
                        : (tier.Perks?.Count > 0 ? tier.Perks : AffiliateAdminDesignHelper.GetDefaultPerks(tier.Slug));
                    var capacityCount = tier.CurrentAffiliateCount;
                    var maxCap = isEditing ? edit.MaxAffiliates : tier.MaxAffiliates;
                    var capacityLabel = maxCap.HasValue ? $"{capacityCount} / {maxCap}" : $"{capacityCount} / ∞";
                    var capacitySubtext = maxCap.HasValue
                        ? (capacityCount >= maxCap ? "At capacity" : $"{maxCap.Value - capacityCount} slots remaining")
                        : "Unlimited";

                    <article class="aff-tier-card @(isEditing ? "aff-tier-card--editing" : "")" style="border-color:@(isEditing ? theme.Color : "#EEF1F6")">
                        <div class="aff-tier-card__header" style="background:@theme.BgColor">
                            <div class="aff-tier-card__heading">
                                <div class="aff-tier-card__icon" style="background:@(theme.Color)22;color:@theme.Color">★</div>
                                <div>
                                    <h3 style="color:@theme.TextColor">@tier.DisplayName</h3>
                                    <p style="color:@theme.TextColor">@(tier.ItemsSoldThreshold <= 0 ? "Entry level" : $"{tier.ItemsSoldThreshold}+ items sold")</p>
                                </div>
                            </div>
                            @if (!isEditing)
                            {
                                <button type="button" class="aff-tier-card__edit" style="border-color:@(theme.Color)60;color:@theme.TextColor" @onclick="() => StartTierEdit(tier.Slug)">Edit</button>
                            }
                            else
                            {
                                <div class="aff-tier-card__edit-actions">
                                    <button type="button" class="aff-tier-card__edit" style="border-color:@(theme.Color)60;color:@theme.TextColor" @onclick="CancelTierEdit">Cancel</button>
                                    <button type="button" class="aff-tier-card__save" style="background:@theme.Color" disabled="@edit.IsSaving" @onclick="SaveEditingTierAsync">Save</button>
                                </div>
                            }
                        </div>

                        <div class="aff-tier-card__body">
                            <div class="aff-tier-card__fields">
                                <div>
                                    <label>Commission Rate</label>
                                    @if (isEditing)
                                    {
                                        <div class="aff-tier-input-wrap">
                                            <input type="number" min="0" max="100" step="0.01" @bind="edit.CommissionRatePercent" @bind:event="oninput" @bind:after="MarkTierDirty" />
                                            <span>%</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="aff-tier-card__big" style="color:@theme.Color">@tier.CommissionRatePercent.ToString("0.#")%</p>
                                    }
                                </div>
                                <div>
                                    <label>Audience Discount</label>
                                    @if (isEditing)
                                    {
                                        <div class="aff-tier-input-wrap">
                                            <input type="number" min="0" max="100" step="0.01" @bind="edit.ReferralDiscountPercent" @bind:event="oninput" @bind:after="MarkTierDirty" />
                                            <span>%</span>
                                        </div>
                                    }
                                    else
                                    {
                                        <p class="aff-tier-card__big" style="color:@theme.Color">@tier.ReferralDiscountPercent.ToString("0.#")%</p>
                                    }
                                </div>
                            </div>

                            <div>
                                <label>Minimum Items to Qualify</label>
                                @if (isEditing)
                                {
                                    <input class="aff-tier-field" type="number" min="0" step="1" @bind="edit.ItemsSoldThreshold" @bind:event="oninput" @bind:after="MarkTierDirty" />
                                }
                                else
                                {
                                    <p class="aff-tier-card__text">@(tier.ItemsSoldThreshold <= 0 ? "No minimum" : $"{tier.ItemsSoldThreshold} items")</p>
                                }
                            </div>

                            <div>
                                <label>Quarterly Bonus</label>
                                @if (isEditing)
                                {
                                    <div class="aff-tier-input-wrap">
                                        <input type="number" min="0" max="100" step="0.01" @bind="edit.QuarterlyBonusPercent" @bind:event="oninput" @bind:after="MarkTierDirty" />
                                        <span>%</span>
                                    </div>
                                }
                                else
                                {
                                    <p class="aff-tier-card__text">@(tier.QuarterlyBonusPercent > 0 ? $"{tier.QuarterlyBonusPercent:0.#}%" : "None")</p>
                                }
                            </div>

                            <div>
                                <div class="aff-tier-card__capacity-head">
                                    <label>Capacity</label>
                                    <span>@capacityLabel</span>
                                </div>
                                @if (isEditing)
                                {
                                    <input class="aff-tier-field" type="number" min="0" step="1" placeholder="Unlimited"
                                           @bind="edit.MaxAffiliates" @bind:event="oninput" @bind:after="MarkTierDirty" />
                                    <p class="aff-tier-card__text aff-tier-card__text--muted">Leave empty for unlimited</p>
                                }
                                else
                                {
                                    <p class="aff-tier-card__text aff-tier-card__text--muted">@capacitySubtext</p>
                                }
                            </div>

                            <div>
                                <label>Perks &amp; Benefits</label>
                                @if (isEditing)
                                {
                                    <ul class="aff-tier-perks aff-tier-perks--editable">
                                        @for (var perkIndex = 0; perkIndex < edit.Perks.Count; perkIndex++)
                                        {
                                            var idx = perkIndex;
                                            <li>
                                                <span style="color:@theme.Color">✓</span>
                                                <span class="aff-tier-perk-text">@edit.Perks[idx]</span>
                                                <button type="button" class="aff-tier-perk-remove" @onclick="() => RemoveTierPerk(tier.Slug, idx)">×</button>
                                            </li>
                                        }
                                    </ul>
                                    <div class="aff-tier-perk-add">
                                        <input placeholder="Add a perk…" @bind="edit.NewPerk" @bind:event="oninput" />
                                        <button type="button" class="aff-tier-card__edit" style="border-color:@(theme.Color)60;color:@theme.TextColor"
                                                @onclick="() => AddTierPerk(tier.Slug)">Add</button>
                                    </div>
                                }
                                else
                                {
                                    <ul class="aff-tier-perks">
                                        @foreach (var perk in displayPerks)
                                        {
                                            <li><span style="color:@theme.Color">✓</span> @perk</li>
                                        }
                                    </ul>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(edit.Error))
                            {
                                <p class="aff-tier-card__error">@edit.Error</p>
                            }
                        </div>
                    </article>
                }
            </div>

            <div class="aff-tier-progression">
                <h4>Tier Progression</h4>
                <div class="aff-tier-progression__track">
                    @foreach (var (tier, index) in affiliateTiers.Select((t, i) => (t, i)))
                    {
                        var theme = AffiliateAdminDesignHelper.GetTierTheme(tier.Slug);
                        <div class="aff-tier-progression__step">
                            <div class="aff-tier-progression__dot" style="background:@theme.BgColor;color:@theme.TextColor;border-color:@theme.Color">@(index + 1)</div>
                            <p style="color:@theme.TextColor">@tier.DisplayName</p>
                            <p class="aff-tier-progression__meta">@tier.CommissionRatePercent.ToString("0.#")%</p>
                            <p class="aff-tier-progression__meta">@(tier.ItemsSoldThreshold <= 0 ? "Start" : $"{tier.ItemsSoldThreshold}+ items")</p>
                        </div>
                        @if (index < affiliateTiers.Count - 1)
                        {
                            <div class="aff-tier-progression__line"></div>
                        }
                    }
                </div>
            </div>
        }
    }
</div>
}

@if (!string.IsNullOrEmpty(toastMessage))
{
    <div class="aff-toast">@toastMessage</div>
}

@if (showProcessAllConfirm)
{
    <div class="aff-modal-overlay" @onclick="() => showProcessAllConfirm = false">
        <div class="aff-modal aff-modal--confirm" @onclick:stopPropagation="true">
            <h3>Process all pending payouts?</h3>
            <p>This will disburse $@TotalPendingPayoutAmount.ToString("N0") to @pendingPayouts.Count affiliates. This action cannot be undone.</p>
            <div class="aff-modal__actions">
                <button type="button" class="aff-btn-ghost" @onclick="() => showProcessAllConfirm = false">Cancel</button>
                <button type="button" class="aff-btn-primary" @onclick="ProcessAllPayoutsAsync">Confirm</button>
            </div>
        </div>
    </div>
}

@if (showTierResetConfirm)
{
    <div class="aff-modal-overlay" @onclick="() => showTierResetConfirm = false">
        <div class="aff-modal aff-modal--confirm" @onclick:stopPropagation="true">
            <h3>Reset all tiers to defaults?</h3>
            <p>This will discard unsaved form changes and reload values from the server.</p>
            <div class="aff-modal__actions">
                <button type="button" class="aff-btn-ghost" @onclick="() => showTierResetConfirm = false">Cancel</button>
                <button type="button" class="aff-btn-primary" @onclick="ConfirmResetTiersAsync">Confirm</button>
            </div>
        </div>
    </div>
}

@if (showViewModal && selectedApplication != null)
{
    <div class="affiliates-modal-overlay" @onclick="CloseViewModal">
        <div class="affiliates-modal" @onclick:stopPropagation="true">
            <div class="affiliates-modal__header">
                <h2>Application Details</h2>
                <button type="button" class="affiliates-modal__close" @onclick="CloseViewModal" aria-label="Close">×</button>
            </div>

            <div class="affiliates-modal__body">
                <div class="affiliates-modal__section">
                    <h3>Personal Information</h3>
                    <p><strong>Name:</strong> @selectedApplication.FullName</p>
                    <p><strong>Email:</strong> @selectedApplication.Email</p>
                    <p><strong>Status:</strong> <span class="affiliates-status-badge affiliates-status-badge--@selectedApplication.Status.ToLowerInvariant()">@selectedApplication.Status</span></p>
                    <p><strong>Applied:</strong> @selectedApplication.FormattedDate</p>
                </div>

                <div class="affiliates-modal__section">
                    <h3>Social Media</h3>
                    @if (selectedApplication.SocialHandles != null && selectedApplication.SocialHandles.Any())
                    {
                        @foreach (var social in selectedApplication.SocialHandles)
                        {
                            <p><strong>@social.Platform:</strong> @social.Handle</p>
                        }
                    }
                    else
                    {
                        <p>No social handles provided</p>
                    }
                    <p><strong>Total Audience:</strong> @selectedApplication.AudienceSize.ToString("N0") followers</p>
                </div>

                <div class="affiliates-modal__section">
                    <h3>Content Information</h3>
                    <p><strong>Niche:</strong> @selectedApplication.ContentNiche</p>
                    @if (!string.IsNullOrEmpty(selectedApplication.PortfolioUrl))
                    {
                        <p><strong>Portfolio:</strong> <a href="@selectedApplication.PortfolioUrl" target="_blank" rel="noopener noreferrer">@selectedApplication.PortfolioUrl</a></p>
                    }
                </div>

                @if (!string.IsNullOrEmpty(selectedApplication.WhyMuuqwear))
                {
                    <div class="affiliates-modal__section">
                        <h3>Why Muuqwear?</h3>
                        <p>@selectedApplication.WhyMuuqwear</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(selectedApplication.AdminNotes))
                {
                    <div class="affiliates-modal__section">
                        <h3>Admin Notes</h3>
                        <p>@selectedApplication.AdminNotes</p>
                    </div>
                }
            </div>
        </div>
    </div>
}

@if (payoutToConfirm != null)
{
    <div class="affiliates-modal-overlay" @onclick="ClosePayoutConfirm">
        <div class="affiliates-modal affiliates-modal--confirm" @onclick:stopPropagation="true">
            <div class="affiliates-modal__header">
                <h2>Confirm payout</h2>
                <button type="button" class="affiliates-modal__close" @onclick="ClosePayoutConfirm" aria-label="Close">×</button>
            </div>
            <div class="affiliates-modal__body">
                <p>
                    Process <strong>@payoutToConfirm.FormattedAmount</strong> payout for
                    <strong>@payoutToConfirm.AffiliateName</strong>?
                </p>
                <p class="affiliates-modal__hint">
                    This marks @payoutToConfirm.ReferralCount pending referral@(payoutToConfirm.ReferralCount == 1 ? "" : "s") as paid. This action cannot be undone.
                </p>
                <div class="affiliates-modal__actions">
                    <button type="button" class="affiliates-modal__btn affiliates-modal__btn--ghost" @onclick="ClosePayoutConfirm">
                        Cancel
                    </button>
                    <button type="button"
                            class="affiliates-modal__btn affiliates-modal__btn--confirm"
                            disabled="@(!string.IsNullOrEmpty(processingPayoutCode))"
                            @onclick="ConfirmProcessPayoutAsync">
                        Process Payout
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<PageReadyNotifier IsLoading="@(isLoading && !hasLoadedOnce)" />
