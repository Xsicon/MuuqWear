@page "/admin/customers"
@layout Layout.AdminLayoutComponent.AdminDashboardLayoutComponent
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using Microsoft.AspNetCore.Authorization
@using MuuqWear.Model.Customer
@using MuuqWear.Web.Components.Shared
@using MuuqWear.Web.Helpers
@attribute [Authorize(Policy = AdminPortalPolicies.Customers)]

<PageTitle>Customers</PageTitle>

<div class="customers-page @(isLoadingTabContent ? "customers-page--refreshing" : "")">

    <div class="customers-header">
        <div>
            <h1 class="customers-header__title">@GetSectionTitle()</h1>
            <p class="customers-header__subtitle">
                @GetPageSubtitle()
                @if (totalCount > 0)
                {
                    <span> · @totalCount total</span>
                }
            </p>
        </div>
        @if (activeView == "list")
        {
            <div class="customers-header__actions">
                <div class="customers-export-wrap">
                    <button type="button"
                            class="btn-primary customers-export-btn"
                            disabled="@isExporting"
                            aria-expanded="@exportMenuOpen"
                            @onclick="ToggleExportMenu">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="7 10 12 15 17 10"></polyline>
                            <line x1="12" x2="12" y1="15" y2="3"></line>
                        </svg>
                        @(isExporting ? "Exporting…" : "Export")
                    </button>
                    @if (exportMenuOpen)
                    {
                        <div class="customers-export-menu">
                            <button type="button" class="customers-export-menu__item" @onclick='() => ExportAsync("csv")'>
                                Download CSV
                            </button>
                            <button type="button" class="customers-export-menu__item" @onclick='() => ExportAsync("excel")'>
                                Download Excel
                            </button>
                        </div>
                    }
                </div>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(exportMessage))
    {
        <p class="customers-export-note @(exportMessage.StartsWith("Export failed") || exportMessage.StartsWith("No ") ? "customers-export-note--error" : "")">
            @exportMessage
        </p>
    }

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <p class="customers-error">@errorMessage</p>
    }

    <div class="customers-search-row">
        <div class="customers-search">
            <svg class="customers-search__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input class="customers-search__input"
                   type="search"
                   placeholder="Search by name or email…"
                   value="@searchQuery"
                   @oninput="HandleSearchInput"
                   @onkeydown="HandleSearchKeyDown" />
        </div>

        @if (activeView == "list" || activeView == "details")
        {
            <label class="customers-status-filter">
                <span class="customers-status-filter__label">Status</span>
                <select class="customers-status-filter__select"
                        value="@statusFilter"
                        @onchange="HandleStatusFilterChanged">
                    <option value="">All</option>
                    <option value="active">Active</option>
                    <option value="suspended">Suspended</option>
                </select>
            </label>
        }
    </div>

    @if (activeView == "list")
    {
        <div class="customers-table-card">
            <div class="customers-table-card__header">
                <h2 class="customers-table-card__title">Customer List (@totalCount)</h2>
            </div>

            <div class="customers-table-card__body">
                @if (isLoading && !customers.Any())
                {
                    <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminTable"
                                       Count="8"
                                       Columns="8"
                                       AriaLabel="Loading customers" />
                }
                else if (!customers.Any())
                {
                    <p class="customers-empty">No customers found.</p>
                }
                else
                {
                    <div class="customers-table-scroll">
                        <table class="customers-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Orders</th>
                                    <th>Total Spent</th>
                                    <th>Joined</th>
                                    <th>Last Order</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in customers)
                                {
                                    <tr @key="customer.Id">
                                        <td class="customers-table__name">
                                            @(string.IsNullOrWhiteSpace(customer.FullName) ? "—" : customer.FullName)
                                        </td>
                                        <td class="customers-table__muted">@customer.Email</td>
                                        <td>@customer.OrderCount</td>
                                        <td class="customers-table__spent">@customer.TotalSpent.ToString("C")</td>
                                        <td class="customers-table__muted">@FormatDate(customer.CreatedAt)</td>
                                        <td class="customers-table__muted">@FormatDate(customer.LastOrderAt)</td>
                                        <td>
                                            <span class="customers-status-badge @(CustomerAccountStatusHelper.IsSuspended(customer) ? "customers-status-badge--suspended" : "customers-status-badge--active")">
                                                @(CustomerAccountStatusHelper.IsSuspended(customer) ? "Suspended" : "Active")
                                            </span>
                                        </td>
                                        <td>
                                            <button type="button"
                                                    class="customers-view-btn"
                                                    title="View customer"
                                                    aria-label="View @customer.FullName"
                                                    @onclick="() => OpenCustomerDetailWithNotes(customer)">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                                                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                                    <path d="M2.062 12.348a1 1 0 0 1 0-.696 10.75 10.75 0 0 1 19.876 0 1 1 0 0 1 0 .696 10.75 10.75 0 0 1-19.876 0"></path>
                                                    <circle cx="12" cy="12" r="3"></circle>
                                                </svg>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }
    else if (activeView == "details")
    {
        <div class="customers-details-layout">
            <div class="customers-details-list">
                <div class="customers-table-card">
                    <div class="customers-table-card__header">
                        <h2 class="customers-table-card__title">Select Customer</h2>
                    </div>
                    <div class="customers-table-card__body customers-table-card__body--compact">
                        @if (isLoading && !customers.Any())
                        {
                            <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminTable"
                                               Count="6"
                                               Columns="3"
                                               AriaLabel="Loading customers" />
                        }
                        else if (!customers.Any())
                        {
                            <p class="customers-empty">No customers found.</p>
                        }
                        else
                        {
                            <ul class="customers-details-picker">
                                @foreach (var customer in customers)
                                {
                                    <li @key="customer.Id">
                                        <button type="button"
                                                class="customers-details-picker__item @(selectedCustomerForDetails?.Id == customer.Id ? "customers-details-picker__item--active" : "")"
                                                @onclick="() => SelectCustomerForDetailsWithNotes(customer)">
                                            <span class="customers-details-picker__name">
                                                @(string.IsNullOrWhiteSpace(customer.FullName) ? "—" : customer.FullName)
                                            </span>
                                            <span class="customers-details-picker__email">@customer.Email</span>
                                            <span class="customers-details-picker__meta">
                                                @customer.OrderCount orders · @customer.TotalSpent.ToString("C")
                                            </span>
                                        </button>
                                    </li>
                                }
                            </ul>
                        }
                    </div>
                </div>

                <PaginationComponent TItem="CustomerModel"
                                     TotalCount="@totalCount"
                                     CurrentPage="@currentPage"
                                     PageSize="@pageSize"
                                     OnPageChanged="HandlePageChanged" />
            </div>

            <div class="customers-details-panel">
                @if (selectedCustomerForDetails is null)
                {
                    <div class="customers-details-panel__empty">
                        <p>Select a customer to view their profile.</p>
                    </div>
                }
                else
                {
                    <p class="customers-panel__eyebrow">Customer Profile</p>
                    <h2 class="customers-panel__title">
                        @(string.IsNullOrWhiteSpace(selectedCustomerForDetails.FullName)
                            ? "Customer"
                            : selectedCustomerForDetails.FullName)
                    </h2>

                    <div class="customers-panel__section">
                        <p class="customers-panel__label">Email</p>
                        <p class="customers-panel__value">@(selectedCustomerForDetails.Email ?? "—")</p>
                    </div>

                    <div class="customers-panel__section">
                        <p class="customers-panel__label">Orders</p>
                        <p class="customers-panel__value">@selectedCustomerForDetails.OrderCount</p>
                    </div>

                    <div class="customers-panel__section">
                        <p class="customers-panel__label">Total Spent</p>
                        <p class="customers-panel__value customers-panel__value--emphasis">
                            @selectedCustomerForDetails.TotalSpent.ToString("C")
                        </p>
                    </div>

                    <div class="customers-panel__section">
                        <p class="customers-panel__label">Joined</p>
                        <p class="customers-panel__value">@FormatDate(selectedCustomerForDetails.CreatedAt)</p>
                    </div>

                    <div class="customers-panel__section">
                        <p class="customers-panel__label">Last Order</p>
                        <p class="customers-panel__value">@FormatDate(selectedCustomerForDetails.LastOrderAt)</p>
                    </div>

                    <AdminCustomerAccountPanel Customer="selectedCustomerForDetails"
                                               IsBusy="isAccountActionBusy"
                                               ShowSuspendForm="showSuspendForm"
                                               SuspendDurationDays="suspendDurationDays"
                                               SuspendReason="suspendReason"
                                               AccountActionError="@accountActionError"
                                               SuspendRequested="SuspendActiveCustomerAsync"
                                               ReactivateRequested="ReactivateActiveCustomerAsync"
                                               ShowSuspendFormRequested="BeginSuspendForm"
                                               CancelSuspendRequested="CancelSuspendForm"
                                               SuspendDurationDaysChanged="SetSuspendDurationDays"
                                               SuspendReasonChanged="SetSuspendReason" />

                    <div class="customers-panel__actions">
                        <button type="button"
                                class="btn-primary"
                                disabled="@string.IsNullOrWhiteSpace(selectedCustomerForDetails.Email)"
                                @onclick="ViewCustomerOrders">
                            View Orders
                        </button>
                    </div>

                    <CustomerNotesThreadComponent Notes="@activeCustomerNotes"
                                                  IsLoading="@isNotesLoading"
                                                  IsSaving="@isNotesSaving"
                                                  ErrorMessage="@notesErrorMessage"
                                                  OnAddNote="HandleAddNoteAsync" />
                }
            </div>
        </div>
    }
    else
    {
        <div class="customers-table-card">
            <div class="customers-table-card__header">
                <h2 class="customers-table-card__title">Internal Notes (@totalCount)</h2>
            </div>

            <div class="customers-table-card__body">
                @if (isLoading && !customers.Any())
                {
                    <MwSkeletonSection Layout="MwSkeletonSection.SkeletonLayout.AdminTable"
                                       Count="8"
                                       Columns="5"
                                       AriaLabel="Loading customers" />
                }
                else if (!customers.Any())
                {
                    <p class="customers-empty">No customers found.</p>
                }
                else
                {
                    <div class="customers-table-scroll">
                        <table class="customers-table">
                            <thead>
                                <tr>
                                    <th>Name</th>
                                    <th>Email</th>
                                    <th>Notes</th>
                                    <th>Latest Note</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var customer in customers)
                                {
                                    <tr @key="customer.Id">
                                        <td class="customers-table__name">
                                            @(string.IsNullOrWhiteSpace(customer.FullName) ? "—" : customer.FullName)
                                        </td>
                                        <td class="customers-table__muted">@customer.Email</td>
                                        <td>
                                            @if (customer.NoteCount > 0)
                                            {
                                                <span class="customers-notes-count">@customer.NoteCount</span>
                                            }
                                            else
                                            {
                                                <span class="customers-table__muted">0</span>
                                            }
                                        </td>
                                        <td>
                                            @if (customer.NoteCount > 0 && !string.IsNullOrWhiteSpace(customer.LatestNotePreview))
                                            {
                                                <div class="customers-notes-cell">
                                                    <p class="customers-notes-cell__author">
                                                        @CustomerNoteFormatter.FormatAuthorLabel(
                                                            customer.LatestNoteAuthorName,
                                                            customer.LatestNoteAuthorRole)
                                                    </p>
                                                    <p class="customers-notes-cell__preview">@customer.LatestNotePreview</p>
                                                    <p class="customers-notes-cell__meta">@FormatNoteTimestamp(customer.LatestNoteAt)</p>
                                                </div>
                                            }
                                            else
                                            {
                                                <p class="customers-notes-cell__empty">No internal notes yet.</p>
                                            }
                                        </td>
                                        <td>
                                            <button type="button"
                                                    class="btn-secondary customers-notes-open-btn"
                                                    @onclick="() => OpenNotesPanel(customer)">
                                                View Notes
                                            </button>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    }

    @if (activeView != "details")
    {
        <PaginationComponent TItem="CustomerModel"
                             TotalCount="@totalCount"
                             CurrentPage="@currentPage"
                             PageSize="@pageSize"
                             OnPageChanged="HandlePageChanged" />
    }
</div>

@if (isDetailPanelOpen && selectedCustomer != null && activeView == "list")
{
    <div class="customers-panel-overlay" @onclick="CloseCustomerDetail"></div>
    <aside class="customers-panel" aria-label="Customer details">
        <button type="button" class="customers-panel__close" @onclick="CloseCustomerDetail" aria-label="Close">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
        </button>

        <p class="customers-panel__eyebrow">Customer Details</p>
        <h2 class="customers-panel__title">
            @(string.IsNullOrWhiteSpace(selectedCustomer.FullName) ? "Customer" : selectedCustomer.FullName)
        </h2>

        <div class="customers-panel__section">
            <p class="customers-panel__label">Email</p>
            <p class="customers-panel__value">@(selectedCustomer.Email ?? "—")</p>
        </div>

        <div class="customers-panel__section">
            <p class="customers-panel__label">Orders</p>
            <p class="customers-panel__value">@selectedCustomer.OrderCount</p>
        </div>

        <div class="customers-panel__section">
            <p class="customers-panel__label">Total Spent</p>
            <p class="customers-panel__value customers-panel__value--emphasis">
                @selectedCustomer.TotalSpent.ToString("C")
            </p>
        </div>

        <div class="customers-panel__section">
            <p class="customers-panel__label">Joined</p>
            <p class="customers-panel__value">@FormatDate(selectedCustomer.CreatedAt)</p>
        </div>

        <div class="customers-panel__section">
            <p class="customers-panel__label">Last Order</p>
            <p class="customers-panel__value">@FormatDate(selectedCustomer.LastOrderAt)</p>
        </div>

        <AdminCustomerAccountPanel Customer="selectedCustomer"
                                   IsBusy="isAccountActionBusy"
                                   ShowSuspendForm="showSuspendForm"
                                   SuspendDurationDays="suspendDurationDays"
                                   SuspendReason="suspendReason"
                                   AccountActionError="@accountActionError"
                                   SuspendRequested="SuspendActiveCustomerAsync"
                                   ReactivateRequested="ReactivateActiveCustomerAsync"
                                   ShowSuspendFormRequested="BeginSuspendForm"
                                   CancelSuspendRequested="CancelSuspendForm"
                                   SuspendDurationDaysChanged="SetSuspendDurationDays"
                                   SuspendReasonChanged="SetSuspendReason" />

        <div class="customers-panel__actions">
            <button type="button"
                    class="btn-primary"
                    disabled="@string.IsNullOrWhiteSpace(selectedCustomer.Email)"
                    @onclick="ViewCustomerOrders">
                View Orders
            </button>
            <button type="button" class="btn-secondary" @onclick="CloseCustomerDetail">
                Close
            </button>
        </div>

        <CustomerNotesThreadComponent Notes="@activeCustomerNotes"
                                      IsLoading="@isNotesLoading"
                                      IsSaving="@isNotesSaving"
                                      ErrorMessage="@notesErrorMessage"
                                      OnAddNote="HandleAddNoteAsync" />
    </aside>
}

@if (isNotesPanelOpen && notesPanelCustomer != null)
{
    <div class="customers-panel-overlay" @onclick="CloseNotesPanel"></div>
    <aside class="customers-panel customers-panel--wide" aria-label="Customer internal notes">
        <button type="button" class="customers-panel__close" @onclick="CloseNotesPanel" aria-label="Close">
            <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M18 6 6 18"></path>
                <path d="m6 6 12 12"></path>
            </svg>
        </button>

        <p class="customers-panel__eyebrow">Customer Notes</p>
        <h2 class="customers-panel__title">
            @(string.IsNullOrWhiteSpace(notesPanelCustomer.FullName) ? "Customer" : notesPanelCustomer.FullName)
        </h2>
        <p class="customers-panel__value customers-panel__value--sub">@notesPanelCustomer.Email</p>

        <CustomerNotesThreadComponent Notes="@activeCustomerNotes"
                                      IsLoading="@isNotesLoading"
                                      IsSaving="@isNotesSaving"
                                      ErrorMessage="@notesErrorMessage"
                                      OnAddNote="HandleAddNoteAsync" />

        <div class="customers-panel__actions">
            <button type="button" class="btn-secondary" @onclick="CloseNotesPanel">
                Close
            </button>
        </div>
    </aside>
}

@if (showToast)
{
    <div class="customers-toast @(toastSuccess ? "customers-toast--success" : "customers-toast--error")">
        @toastMessage
    </div>
}

<PageReadyNotifier IsLoading="@(isLoading && !hasLoadedOnce)" />
