<div class="st-tab">
    <div class="st-tab-header">
        <p class="st-tab-eyebrow">System &amp; Technology</p>
        <h2 class="st-tab-title">Sync Tools</h2>
        <p class="st-tab-subtitle">Manually trigger data synchronization</p>
    </div>

    @if (!string.IsNullOrEmpty(toast))
    {
        <p class="st-toast @(toastIsError ? "st-toast--error" : "")">@toast</p>
    }

    <div class="st-card-grid st-card-grid--2">
        @foreach (var tool in syncTools)
        {
            <article class="st-card" @key="tool.Id">
                <h3 class="st-card__title">@tool.Label</h3>
                <p class="st-card__meta">@tool.Description</p>
                <button class="st-btn st-btn--primary st-btn--block"
                        disabled="@isRunning"
                        @onclick="() => RunSync(tool.Id)">
                    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 0 0-9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"></path><path d="M3 3v5h5"></path><path d="M3 12a9 9 0 0 0 9 9 9.75 9.75 0 0 0 6.74-2.74L21 16"></path><path d="M16 16h5v5"></path></svg>
                    @(isRunning && runningToolId == tool.Id ? "Running..." : "Run Sync")
                </button>
            </article>
        }
    </div>
</div>
