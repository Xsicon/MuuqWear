@page "/admin/products"
@layout Layout.AdminLayoutComponent.AdminDashboardLayoutComponent
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using MuuqWear.Application.Services.ProductService
@using MuuqWear.Application.Services.CategoryService
@using MuuqWear.Model.Products
@using MuuqWear.Application.Shared
@using Microsoft.AspNetCore.Authorization
@using MuuqWear.Web.Components.Shared
@inject IProductService ProductService
@inject ICategoryService CategoryService
@implements IDisposable
@attribute [Authorize(Roles = "admin")]

<PageTitle>Products &amp; Inventory</PageTitle>

@if (isLoading && !isFormOpen)
{
    <p class="mw-section-loading">Loading products...</p>
}

@if (!isFormOpen)
{
    <div class="products-page">

        <div class="products-header">
            <div>
                <h1 class="products-header__title">Products &amp; Inventory</h1>
                <p class="products-header__subtitle">@PageSubtitle</p>
            </div>
            <div class="products-header__actions">
                @if (ShowCatalogActions)
                {
                    <button type="button" class="btn-primary" @onclick="OpenAddForm">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M5 12h14"></path>
                            <path d="M12 5v14"></path>
                        </svg>
                        Add New Product
                    </button>
                    <button type="button" class="btn-secondary" disabled title="Coming soon">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                             viewBox="0 0 24 24" fill="none" stroke="currentColor"
                             stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                            <polyline points="17 8 12 3 7 8"></polyline>
                            <line x1="12" x2="12" y1="3" y2="15"></line>
                        </svg>
                        Import CSV
                    </button>
                    <div class="products-export-wrap">
                        <button type="button"
                                class="btn-secondary products-export-btn"
                                @onclick="ToggleExportMenu"
                                disabled="@isExporting">
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14"
                                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
                                <polyline points="7 10 12 15 17 10"></polyline>
                                <line x1="12" x2="12" y1="15" y2="3"></line>
                            </svg>
                            @(isExporting ? "Exporting..." : "Export")
                        </button>
                        @if (exportMenuOpen)
                        {
                            <div class="products-export-menu">
                                <button type="button" class="products-export-menu__item" @onclick='() => ExportAsync("csv")'>
                                    Download CSV (all filtered)
                                </button>
                                <button type="button" class="products-export-menu__item" @onclick='() => ExportAsync("excel")'>
                                    Download Excel (all filtered)
                                </button>
                                @if (selectedProductIds.Any())
                                {
                                    <button type="button" class="products-export-menu__item products-export-menu__item--highlight" @onclick='() => ExportAsync("csv", selectedOnly: true)'>
                                        CSV — @selectedProductIds.Count selected
                                    </button>
                                    <button type="button" class="products-export-menu__item products-export-menu__item--highlight" @onclick='() => ExportAsync("excel", selectedOnly: true)'>
                                        Excel — @selectedProductIds.Count selected
                                    </button>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        @if (!string.IsNullOrEmpty(exportMessage))
        {
            <p class="products-export-note @(exportMessage.StartsWith("Export failed") || exportMessage.StartsWith("No ") ? "products-export-note--error" : "")">
                @exportMessage
            </p>
        }

        @if (!string.IsNullOrEmpty(ViewContextLabel))
        {
            <p class="products-view-context">@ViewContextLabel</p>
        }

        @if (LowStockCount > 0 && activeFilter != "OutOfStock" && activeView == "catalog")
        {
            <button type="button" class="low-stock-banner" @onclick="NavigateToLowStockView">
                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
                    <path d="M12 9v4"></path>
                    <path d="M12 17h.01"></path>
                </svg>
                @LowStockCount product@(LowStockCount == 1 ? "" : "s") below threshold (@ProductStockHelper.LowStockThreshold units)
                <span class="low-stock-banner__link">View alerts →</span>
            </button>
        }

        @if (ShowCategoryFilters)
        {
        <div class="products-filters">
            <button type="button"
                    class="products-filter-tab @(activeFilter == "All" ? "active" : "inactive")"
                    @onclick='() => SetFilter("All")'>
                All
            </button>
            @foreach (var cat in Categories)
            {
                <button type="button"
                        class="products-filter-tab @(activeFilter == cat.Id.ToString() ? "active" : "inactive")"
                        @onclick="() => SetFilter(cat.Id.ToString())">
                    @cat.Name
                </button>
            }
            <button type="button"
                    class="products-filter-tab @(activeFilter == "LowStock" ? "active" : "inactive")"
                    @onclick='() => SetFilter("LowStock")'>
                Low Stock
            </button>
            <button type="button"
                    class="products-filter-tab @(activeFilter == "OutOfStock" ? "active" : "inactive")"
                    @onclick='() => SetFilter("OutOfStock")'>
                Out of Stock
            </button>
        </div>
        }

        <div class="products-search">
            <svg class="products-search__icon" xmlns="http://www.w3.org/2000/svg" width="16" height="16"
                 viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <circle cx="11" cy="11" r="8"></circle>
                <path d="m21 21-4.3-4.3"></path>
            </svg>
            <input class="products-search__input"
                   type="search"
                   placeholder="Search products by name or description…"
                   value="@searchQuery"
                   @oninput="HandleSearchInput"
                   @onkeydown="HandleSearchKeyDown" />
        </div>

        <div class="products-bulk-bar">
            <label class="products-select-all">
                <input type="checkbox"
                       checked="@AllProductsSelected"
                       @onchange="ToggleSelectAllProducts" />
                <span>
                    @if (selectedProductIds.Any())
                    {
                        @($"{selectedProductIds.Count} selected")
                    }
                    else
                    {
                        @("Select All")
                    }
                </span>
            </label>
            @if (selectedProductIds.Any())
            {
                <span class="products-scope-note">Current page only</span>
            }

            <button type="button"
                    class="@(selectedProductIds.Any() ? "btn-process" : "btn-secondary-sm")"
                    disabled="@(!selectedProductIds.Any())"
                    @onclick="OpenBulkModal">
                Bulk Update @(selectedProductIds.Any()
                            ? $"({selectedProductIds.Count})"
                            : "")
            </button>
        </div>

        <div class="products-list">
            @if (isLoading)
            {
                <p class="products-empty">Loading...</p>
            }
            else if (!FilteredProducts.Any())
            {
                <p class="products-empty">No products found.</p>
            }
            else
            {
                @foreach (var item in FilteredProducts)
                {
                    <div class="product-card @(StockFocusLayout ? "product-card--stock-focus" : "")" @key="item.Id">
                        <div class="product-card__top">
                            <div class="product-card__name-row">
                                <input type="checkbox"
                                       class="product-card__checkbox"
                                       checked="@selectedProductIds.Contains(item.Id)"
                                       @onchange="() => ToggleProductSelection(item.Id)" />
                                <p class="product-card__name">@item.Name</p>
                                @if (ProductStockHelper.IsOutOfStock(item))
                                {
                                    <span class="stock-badge stock-badge--out">Out of Stock</span>
                                }
                                else if (ProductStockHelper.IsLowStock(item))
                                {
                                    <span class="stock-badge stock-badge--low">Low Stock</span>
                                }
                                else
                                {
                                    <span class="stock-badge stock-badge--in">In Stock</span>
                                }
                            </div>

                            <div class="product-card__actions">
                                @if (ShowCatalogActions)
                                {
                                    <button type="button" class="btn-secondary"
                                            @onclick="() => OpenEditForm(item)">
                                        Edit
                                    </button>
                                }
                                <button type="button"
                                        class="@(StockFocusLayout || ProductStockHelper.IsOutOfStock(item) ? "btn-primary" : "btn-secondary")"
                                        @onclick="() => OpenStockModal(item)">
                                    @(ProductStockHelper.IsOutOfStock(item) ? "Restock" : "Update Stock")
                                </button>
                            </div>
                        </div>

                        @if (ShowProductMetaDetails)
                        {
                            <p class="product-card__meta">
                                @if (!string.IsNullOrEmpty(item.Sku))
                                {
                                    <span>SKU: @item.Sku · </span>
                                }
                                <span>Price: @item.Price.ToString("C") · </span>
                                <span>
                                    @(Categories.FirstOrDefault(c => c.Id == item.CategoryId)?.Name
                                        ?? "Uncategorised")
                                </span>
                            </p>
                        }
                        else
                        {
                            <p class="product-card__meta product-card__meta--stock">
                                @if (!string.IsNullOrEmpty(item.Sku))
                                {
                                    <span>SKU: @item.Sku · </span>
                                }
                                <span class="product-card__total-stock">
                                    Total stock: <strong>@ProductStockHelper.GetEffectiveStock(item)</strong> units
                                </span>
                            </p>
                        }

                        @if (item.SizeStock.Any())
                        {
                            <div class="product-card__sizes @(StockFocusLayout ? "product-card__sizes--emphasis" : "")">
                                @foreach (var s in item.SizeStock)
                                {
                                    var pillClass = s.Quantity == 0
                                        ? "size-pill size-pill--out"
                                        : s.Quantity < ProductStockHelper.LowStockThreshold
                                            ? "size-pill size-pill--low"
                                            : "size-pill size-pill--normal";

                                    <span class="size-pill-row">
                                        <span class="size-pill-row__label">@s.Size</span>
                                        <span class="@pillClass">@s.Quantity</span>
                                    </span>
                                }
                            </div>
                        }
                        else if (StockFocusLayout)
                        {
                            <p class="product-card__no-sizes">No size breakdown — total stock only.</p>
                        }
                    </div>
                }
            }
        </div>

        <PaginationComponent TItem="ProductModel"
                             TotalCount="_totalCount"
                             CurrentPage="_currentPage"
                             PageSize="_pageSize"
                             OnPageChanged="HandlePageChanged" />

    </div>
}
else
{
    <!-- ADD / EDIT FORM VIEW -->
    <section class="mw-product-form">

        <!-- HEADER -->
        <div class="mw-product-form__header">
            <div class="d-flex align-items-center gap-3">
                <button class="mw-back-btn" @onclick="CloseForm">
                    ← Back
                </button>
                <h3 class="mw-admin-heading mb-0">
                    @(isEditMode ? "Edit Product" : "Add New Product")
                </h3>
            </div>
            <div class="d-flex gap-2">

                @if (isEditMode)
                {
                    <button class="mw-btn-danger"
                            @onclick="() => OpenDeleteModal(new ProductModel
                            { Id = editingProductId,Name = newProduct.Name})">
                Delete
            </button>
                        }
                <button class="mw-btn-secondary" @onclick="CloseForm">Cancel</button>
                <button class="mw-btn-primary" @onclick="SaveProduct" disabled="@isSaving">
                    @(isSaving ? "Saving..." : (isEditMode ? "Update Product" : "Add Product"))
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(errorMessage))
        {
            <div class="alert alert-danger mt-3">@errorMessage</div>
        }

        <div class="row g-4 mt-1">

            <!-- LEFT COLUMN -->
            <div class="col-12 col-lg-7">

                <!-- GENERAL INFORMATION -->
                <div class="mw-form-card mb-4">
                    <h6 class="mw-form-card__title">General Information</h6>

                    <div class="mb-3">
                        <label class="mw-form-label">Name Product</label>
                        <input class="mw-admin-input w-100"
                               placeholder="e.g. Puffer Jacket"
                               @bind="newProduct.Name" />
                    </div>

                    <div class="mb-3">
                        <label class="mw-form-label">Description Product</label>
                        <textarea class="mw-admin-input w-100"
                                  rows="4"
                                  placeholder="Describe the product..."
                                  @bind="newProduct.Description"></textarea>
                    </div>

                    <div class="mb-3">
                        <label class="mw-form-label">Size</label>
                        <p class="mw-form-hint">Pick Available Size</p>
                        <div class="mw-size-selector">
                            @foreach (var size in AvailableSizes)
                            {
                                <button class="mw-size-btn @(SelectedSizes.Contains(size) ? "active" : "")"
                                        @onclick="() => ToggleSize(size)">
                                    @size
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="mw-form-label">Colors</label>
                        <p class="mw-form-hint">Pick Available Colors</p>
                        <div class="d-flex gap-2 flex-wrap">
                            @foreach (var color in AvailableColors)
                            {
                                <button class="mw-admin-color-btn @(SelectedColors.Contains(color) ? "active" : "")"
                                        style="background-color: @color; border: 2px solid @(SelectedColors.Contains(color) ? "#1E2A47" : "#E5E7EB")"
                                        @onclick="() => ToggleColor(color)">
                                    @if (SelectedColors.Contains(color))
                                    {
                                        <svg class="mw-admin-color-icon" viewBox="0 0 24 24" aria-hidden="true">
                                            <polyline points="20 6 9 17 4 12"
                                                      fill="none"
                                                      stroke="@MuuqWearUtils.GetContrastIconColor(color)"
                                                      stroke-width="3"
                                                      stroke-linecap="round"
                                                      stroke-linejoin="round" />
                                        </svg>
                                    }
                                </button>
                            }
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="mw-form-label">Gender</label>
                        <p class="mw-form-hint">Pick Available Gender</p>
                        <div class="mw-gender-selector">
                            @foreach (var gender in AvailableGenders)
                            {
                                <label class="mw-gender-option">
                                    <input type="radio"
                                           name="gender"
                                           value="@gender"
                                           checked="@(newProduct.Gender == gender)"
                                           @onchange="() => newProduct.Gender = gender" />
                                    <span>@gender</span>
                                </label>
                            }
                        </div>
                    </div>
                </div>

                <!-- PRICING AND STOCK -->
                <div class="mw-form-card">
                    <h6 class="mw-form-card__title">Pricing And Stock</h6>

                    <div class="row g-3">
                        <div class="col-6">
                            <label class="mw-form-label">Base Pricing</label>
                            <div class="mw-input-prefix">
                                <span>$</span>
                                <input type="number"
                                       class="mw-admin-input w-100"
                                       placeholder="0.00"
                                       @bind="newProduct.Price" />
                            </div>
                        </div>
                        @if (isEditMode)
                        {
                            <div class="col-6">
                                <label class="mw-form-label">Stock</label>
                                <p class="mw-form-hint" style="margin-top:8px">
                                    Managed per size via Update Stock
                                </p>
                            </div>
                        }
                        else
                        {
                            <!-- show stock field only when adding new product -->
                            <div class="col-6">
                                <label class="mw-form-label">Stock</label>
                                <input type="number"
                                       class="mw-admin-input w-100"
                                       placeholder="0"
                                       @bind="newProduct.Stock" />
                            </div>
                        }
                        <div class="col-6">
                            <label class="mw-form-label">Badge</label>
                            <select class="mw-admin-input w-100" @bind="newProduct.Badge">
                                <option value="">None</option>
                                <option value="NEW">NEW</option>
                                <option value="SALE">SALE</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="mw-form-label">Status</label>
                            <select class="mw-admin-input w-100" @bind="newProduct.IsActive">
                                <option value="true">Active</option>
                                <option value="false">Inactive</option>
                            </select>
                        </div>
                    </div>

                    <div class="mt-3">
                        <label class="mw-form-label">Sections</label>
                        <div class="d-flex gap-4 mt-1">
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input"
                                       id="isNewArrival"
                                       @bind="newProduct.IsNewArrival" />
                                <label class="form-check-label" for="isNewArrival">New Arrival</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input"
                                       id="isFeatured"
                                       @bind="newProduct.IsFeatured" />
                                <label class="form-check-label" for="isFeatured">Featured</label>
                            </div>
                            <div class="form-check">
                                <input type="checkbox" class="form-check-input"
                                       id="isBestSeller"
                                       @bind="newProduct.IsBestSeller" />
                                <label class="form-check-label" for="isBestSeller">Best Seller</label>
                            </div>
                        </div>
                    </div>
                </div>

            </div>

            <!-- RIGHT COLUMN -->
            <div class="col-12 col-lg-5">



                <!-- IMAGE UPLOAD -->
                <div class="mw-form-card mb-4">
                    <h6 class="mw-form-card__title">Upload Image</h6>

                    <!-- IMAGE PREVIEW -->
                    <div class="mw-image-preview">
                        @if (!string.IsNullOrEmpty(newProduct.ImageUrl))
                        {
                            <img src="@newProduct.ImageUrl" class="mw-image-preview__img" />
                        }
                        else
                        {
                            <div class="mw-image-preview__placeholder">
                                <span>No image selected</span>
                            </div>
                        }
                    </div>

                    <!-- IMAGE SOURCE -->
                    <div class="mt-3">
                        <label class="mw-form-label">Image Source</label>
                        <select class="mw-admin-input w-100 mb-2" @bind="imageSource">
                            <option value="url">Paste URL</option>
                            <option value="upload">Upload File</option>
                        </select>

                        @if (imageSource == "url")
                        {
                            <input class="mw-admin-input w-100"
                                   placeholder="https://images.unsplash.com/..."
                                   @bind="newProduct.ImageUrl" />
                        }
                        else
                        {
                            <InputFile OnChange="HandleImageUpload" class="mw-file-input" />
                            @if (isUploading)
                            {
                                <p class="text-muted mt-1 small">Uploading...</p>
                            }
                        }
                    </div>
                </div>

                <!-- CATEGORY -->
                <div class="mw-form-card">
                    <h6 class="mw-form-card__title">Category</h6>

                    <div class="mb-3">
                        <label class="mw-form-label">Product Category</label>
                        <select class="mw-admin-input w-100" @bind="newProduct.CategoryId">
                            <option value="">Select Category</option>
                            @foreach (var cat in Categories)
                            {
                                <option value="@cat.Id">@cat.Name</option>
                            }
                        </select>
                    </div>

                    <!-- ADD CATEGORY -->
                    <div class="mw-add-category">
                        <input class="mw-admin-input flex-grow-1"
                               placeholder="New category name..."
                               @bind="newCategoryName" />
                        <button class="mw-btn-primary"
                                @onclick="AddCategory"
                                disabled="@isAddingCategory">
                            @(isAddingCategory ? "Adding..." : "Add Category")
                        </button>
                    </div>

                    @if (!string.IsNullOrEmpty(categoryError))
                    {
                        <p class="text-danger small mt-1">@categoryError</p>
                    }
                </div>

                <!-- PRODUCT IMAGES -->
                @if (isEditMode && editingProductId != Guid.Empty)
                {
                    <div class="mw-form-card mt-4">
                        <h6 class="mw-form-card__title">Product Images</h6>
                        <p class="mw-form-hint">
                            Add multiple images for product detail page
                        </p>

                        <!-- EXISTING IMAGES -->
                        @if (editingProductImages.Any())
                        {
                            <div class="mw-product-images-grid mb-3">
                                @foreach (var img in editingProductImages.OrderBy(i => i.SortOrder))
                                {
                                    <div class="mw-product-image-item" @key="img.Id">

                                        <!-- IMAGE PREVIEW -->
                                        <img src="@img.ImageUrl" class="mw-product-image-thumb" />

                                        <!-- SORT ORDER -->
                                        <input type="number"
                                               class="mw-admin-input w-100 mt-1"
                                               placeholder="Order"
                                               value="@img.SortOrder"
                                               @onchange="async e => await UpdateImageOrder(img, e)" />

                                        <!-- DELETE BUTTON -->
                                        <button class="mw-btn-danger w-100 mt-1"
                                                @onclick="() => DeleteImage(img.Id)">
                                            Remove
                                        </button>

                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <p class="text-muted small mb-3">No additional images yet.</p>
                        }

                        <!-- ADD NEW IMAGE -->
                        <div class="mb-2">
                            <label class="mw-form-label">Add Image URL</label>
                            <div class="d-flex gap-2">
                                <input class="mw-admin-input flex-grow-1"
                                       placeholder="https://images.unsplash.com/..."
                                       @bind="newImageUrl" />
                                <button class="mw-btn-primary"
                                        @onclick="AddImageUrl"
                                        disabled="@isAddingImage">
                                    @(isAddingImage ? "Adding..." : "Add")
                                </button>
                            </div>
                        </div>

                        <!-- OR UPLOAD FILE -->
                        <div>
                            <label class="mw-form-label">Or Upload Image</label>
                            <InputFile OnChange="HandleAdditionalImageUpload" />
                            @if (isUploadingAdditional)
                            {
                                <p class="text-muted small mt-1">Uploading...</p>
                            }
                        </div>

                        @if (!string.IsNullOrEmpty(imageError))
                        {
                            <p class="text-danger small mt-2">@imageError</p>
                        }
                    </div>
                }

            </div>
        </div>
    </section>
}

<!-- DELETE MODAL — unchanged -->
@if (isDeleteModalOpen)
{
    <div class="mw-modal-overlay" @onclick="CloseDeleteModal">
        <div class="mw-modal" style="max-width:400px;"
             @onclick:stopPropagation="true">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5>Delete Product</h5>
                <button class="mw-close-btn" @onclick="CloseDeleteModal">✕</button>
            </div>
            <p>
                Are you sure you want to delete
                <strong>@deletingProductName</strong>?
            </p>
            <p class="text-danger small">This action cannot be undone.</p>
            <div class="d-flex gap-2 mt-3">
                <button class="mw-btn-secondary w-100"
                        @onclick="CloseDeleteModal">
                    Cancel
                </button>
                <button class="mw-btn-danger w-100"
                        @onclick="ConfirmDelete"
                        disabled="@isDeleting">
                    @(isDeleting ? "Deleting..." : "Delete")
                </button>
            </div>
        </div>
    </div>
}

@if (isStockModalOpen && stockProduct != null)
{
    <div class="products-bulk-modal-overlay" @onclick="CloseStockModal">
        <div class="products-stock-modal" @onclick:stopPropagation="true">
            <div class="products-stock-modal__header">
                <h3 class="products-stock-modal__title">Update Stock — @stockProduct.Name</h3>
                <button type="button" class="products-stock-modal__close" @onclick="CloseStockModal" aria-label="Close">✕</button>
            </div>

            @if (!string.IsNullOrEmpty(stockError))
            {
                <p class="products-stock-modal__error">@stockError</p>
            }

            <div class="products-stock-modal__sizes">
                @foreach (var size in editingSizeStock)
                {
                    <div class="products-stock-modal__row">
                        <span class="products-stock-modal__size-label">@size.Size</span>
                        <input type="number"
                               class="mw-admin-input products-stock-modal__input"
                               min="0"
                               value="@size.Quantity"
                               @onchange="e => size.Quantity = int.TryParse(e.Value?.ToString(), out var q) ? Math.Max(0, q) : 0" />
                        <span class="products-stock-modal__hint">
                            @(size.Quantity == 0
                                ? "Out of stock"
                                : size.Quantity < ProductStockHelper.LowStockThreshold
                                    ? "Low stock"
                                    : "In stock")
                        </span>
                    </div>
                }
            </div>

            <div class="products-stock-modal__total">
                <span>Total Stock</span>
                <strong>@editingSizeStock.Sum(s => s.Quantity)</strong>
            </div>

            <div class="products-stock-modal__actions">
                <button type="button" class="btn-secondary" @onclick="CloseStockModal">Cancel</button>
                <button type="button" class="btn-primary" @onclick="SaveSizeStock" disabled="@isUpdatingStock">
                    @(isUpdatingStock ? "Saving..." : "Save Stock")
                </button>
            </div>
        </div>
    </div>
}

@if (isBulkModalOpen)
{
    <div class="products-bulk-modal-overlay" @onclick="CloseBulkModal">
        <div class="products-bulk-modal" @onclick:stopPropagation="true">
            <h3 class="products-bulk-modal__title">
                Bulk Update @selectedProductIds.Count Product@(selectedProductIds.Count == 1 ? "" : "s")
            </h3>
            <p class="products-bulk-modal__subtitle">
                Choose how to apply the quantity to each size of the selected products.
                Products without size breakdown use total stock instead.
            </p>

            <div class="products-bulk-modal__modes">
                <label class="products-bulk-modal__mode @(bulkStockMode == "set" ? "products-bulk-modal__mode--active" : "")">
                    <input type="radio"
                           name="bulkStockMode"
                           value="set"
                           checked="@(bulkStockMode == "set")"
                           @onchange='() => bulkStockMode = "set"' />
                    <span>Set each size to</span>
                </label>
                <label class="products-bulk-modal__mode @(bulkStockMode == "add" ? "products-bulk-modal__mode--active" : "")">
                    <input type="radio"
                           name="bulkStockMode"
                           value="add"
                           checked="@(bulkStockMode == "add")"
                           @onchange='() => bulkStockMode = "add"' />
                    <span>Add to each size</span>
                </label>
            </div>

            <div class="products-bulk-modal__quantity">
                <label for="bulkQuantity">@(bulkStockMode == "set" ? "Quantity per size" : "Units to add per size")</label>
                <input id="bulkQuantity"
                       type="number"
                       class="mw-admin-input"
                       min="0"
                       value="@bulkQuantity"
                       @onchange="e => bulkQuantity = int.TryParse(e.Value?.ToString(), out var q) ? Math.Max(0, q) : 0" />
            </div>

            @if (!string.IsNullOrEmpty(bulkError))
            {
                <p class="products-bulk-modal__error">@bulkError</p>
            }

            <div class="products-bulk-modal__actions">
                <button type="button" class="btn-secondary" @onclick="CloseBulkModal">
                    Cancel
                </button>
                <button type="button"
                        class="btn-primary"
                        @onclick="ConfirmBulkUpdate"
                        disabled="@isBulkUpdating">
                    @(isBulkUpdating ? "Updating..." : "Apply Update")
                </button>
            </div>
        </div>
    </div>
}




