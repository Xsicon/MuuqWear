@using Microsoft.AspNetCore.Http
@using Microsoft.AspNetCore.Hosting
@using MuuqWear.Client
@using MuuqWear.Client.Layout
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IHttpContextAccessor HttpContextAccessor
@inject IWebHostEnvironment HostEnv

@{
    var adminTheme = ResolveAdminTheme();
    var serverHost = StaffPaths.IsServerOwned(HttpContextAccessor.HttpContext?.Request.Path.Value);
    var hostedShopper = !serverHost && HostEnv.IsDevelopment();
}

<!DOCTYPE html>
<html lang="en" data-admin-theme="@adminTheme" data-mw-host="@(serverHost ? "server" : "wasm")" data-mw-auth="@ShopperAuthHint()">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <style>
        /* First paint before scoped CSS / Google Fonts: keep the header from exploding. */
        .mw-logo { display: flex; align-items: center; gap: 8px; flex-shrink: 0; }
        .mw-logo__img { width: 32px; height: 32px; max-width: 32px; object-fit: contain; display: block; flex-shrink: 0; }
        .mw-header { position: sticky; top: 0; z-index: 1000; background: #fff; }
        .mw-header__inner { display: flex; align-items: center; justify-content: space-between; height: 64px; max-width: 1280px; margin: 0 auto; padding: 0 16px; box-sizing: border-box; }
        .mw-mobile-nav:not(.mw-mobile-nav--open) { display: none !important; }
        .mw-mobile-nav.mw-mobile-nav--open { display: block; }
        html[data-mw-auth="in"] .mw-header-guest { display: none !important; }
        html:not([data-mw-auth="in"]) .mw-header-member { display: none !important; }
        .mw-profile-dropdown:has(.mw-header-auth-ready) .mw-header-member-fallback { display: none !important; }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&amp;family=Playfair+Display:ital,wght@0,400;0,700;0,800;1,400;1,700;1,800&amp;display=swap" rel="stylesheet" />
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('admin-theme');
                if (theme !== 'dark' && theme !== 'light') {
                    var match = document.cookie.match(/(?:^|;\s*)admin-theme=(dark|light)/);
                    theme = match ? match[1] : null;
                }
                if (theme === 'dark' || theme === 'light') {
                    document.documentElement.setAttribute('data-admin-theme', theme);
                    localStorage.setItem('admin-theme', theme);
                }
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css?v=20261023a" />
    <link rel="stylesheet" href="MuuqWear.Web.styles.css" />
    <link rel="stylesheet" href="lib/swiper/swiper-bundle.min.css" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#1E2A47" />
    @if (serverHost)
    {
        <HeadOutlet />
    }
    else if (hostedShopper)
    {
        <HeadOutlet @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: true))" />
    }
    <script>
        (function () {
            var brand = "MuuqWear";
            function apply() {
                var text = (document.title || "").trim();
                var prefix = new RegExp("^" + brand + "\\s*[\\-\\u2014\\u2013]\\s*", "i");
                var suffix = new RegExp("\\s*[\\-\\u2014\\u2013]\\s*" + brand + "\\s*$", "i");
                var page = text.replace(prefix, "").replace(suffix, "").trim();
                var next = page && page.toLowerCase() !== brand.toLowerCase()
                    ? brand + " - " + page
                    : brand;
                if (document.title !== next) document.title = next;
            }
            apply();
            new MutationObserver(apply).observe(document.head, {
                childList: true,
                subtree: true,
                characterData: true
            });
        })();
    </script>
</head>
<body>
    @if (serverHost)
    {
        <Routes />
    }
    else if (hostedShopper)
    {
        @* Dev: InteractiveWASM from the host. Client Standalone is forced off so it does not also mount #app. *@
        <ShopperRoutes @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: true))" />
    }
    else
    {
        <div id="app"></div>
    }
    <script src="lib/swiper/swiper-bundle.min.js"></script>
    <script src="js/carousel.js"></script>
    <script src="js/site.js?v=20261022a"></script>
    <script src="js/firebase-auth.js?v=20261029off"></script>
    <script src="js/chat-scroll.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="js/blazor-boot.js?v=20261029cat"></script>
    <script src="js/image-load.js"></script>


</body>
</html>

@code {
    private string ResolveAdminTheme()
    {
        if (HttpContextAccessor.HttpContext?.Request.Cookies.TryGetValue("admin-theme", out var theme) == true
            && theme is "dark" or "light")
        {
            return theme;
        }

        return "light";
    }

    private string ShopperAuthHint()
    {
        var user = HttpContextAccessor.HttpContext?.User;
        return user?.Identity?.IsAuthenticated == true ? "in" : "out";
    }
}
