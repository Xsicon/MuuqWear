@using Microsoft.AspNetCore.Http
@using MuuqWear.Client
@using MuuqWear.Client.Layout
@using static Microsoft.AspNetCore.Components.Web.RenderMode
@inject IHttpContextAccessor HttpContextAccessor

@{
    var adminTheme = ResolveAdminTheme();
    var serverHost = StaffPaths.IsServerOwned(HttpContextAccessor.HttpContext?.Request.Path.Value);
}

<!DOCTYPE html>
<html lang="en" data-admin-theme="@adminTheme" data-mw-host="@(serverHost ? "server" : "wasm")">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <script>
        (function () {
            try {
                var theme = localStorage.getItem('admin-theme');
                if (theme !== 'dark' && theme !== 'light') {
                    var match = document.cookie.match(/(?:^|;\s*)admin-theme=(dark|light)/);
                    theme = match ? match[1] : null;
                }
                if (theme === 'dark' || theme === 'light') {
                    document.documentElement.setAttribute('data-admin-theme', theme);
                    localStorage.setItem('admin-theme', theme);
                }
            } catch (e) { }
        })();
    </script>
    <link rel="stylesheet" href="bootstrap/bootstrap.min.css" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="MuuqWear.Web.styles.css" />
    <link rel="stylesheet" href="MuuqWear.Client.styles.css" />
    <link rel="stylesheet" href="lib/swiper/swiper-bundle.min.css" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="manifest.webmanifest" />
    <meta name="theme-color" content="#1E2A47" />
    @if (serverHost)
    {
        <HeadOutlet />
    }
    else
    {
        <HeadOutlet @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: true))" />
    }
    <script>
        (function () {
            var brand = "MuuqWear";
            function apply() {
                var text = (document.title || "").trim();
                var prefix = new RegExp("^" + brand + "\\s*[\\-\\u2014\\u2013]\\s*", "i");
                var suffix = new RegExp("\\s*[\\-\\u2014\\u2013]\\s*" + brand + "\\s*$", "i");
                var page = text.replace(prefix, "").replace(suffix, "").trim();
                var next = page && page.toLowerCase() !== brand.toLowerCase()
                    ? brand + " - " + page
                    : brand;
                if (document.title !== next) document.title = next;
            }
            apply();
            new MutationObserver(apply).observe(document.head, {
                childList: true,
                subtree: true,
                characterData: true
            });
        })();
    </script>
</head>
<body>
    @if (serverHost)
    {
        <Routes />
    }
    else
    {
        <ShopperRoutes @rendermode="@(new InteractiveWebAssemblyRenderMode(prerender: true))" />
    }
    <script src="lib/swiper/swiper-bundle.min.js"></script>
    <script src="js/carousel.js"></script>
    <script src="js/site.js?v=20261022a"></script>
    <script src="js/firebase-auth.js?v=20261021f"></script>
    <script src="js/chat-scroll.js"></script>
    <script src="_framework/blazor.web.js" autostart="false"></script>
    <script src="js/blazor-boot.js?v=20261022a"></script>
    <script src="js/image-load.js"></script>


</body>
</html>

@code {
    private string ResolveAdminTheme()
    {
        if (HttpContextAccessor.HttpContext?.Request.Cookies.TryGetValue("admin-theme", out var theme) == true
            && theme is "dark" or "light")
        {
            return theme;
        }

        return "light";
    }
}
