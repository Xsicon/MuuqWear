{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "emulators": {
    "auth": {
      "port": 9099,
      "host": "127.0.0.1"
    },
    "firestore": {
      "port": 8080,
      "host": "127.0.0.1"
    },
    "functions": {
      "port": 5001,
      "host": "127.0.0.1"
    },
    "storage": {
      "port": 9199,
      "host": "127.0.0.1"
    },
    "ui": {
      "enabled": true,
      "port": 4000,
      "host": "127.0.0.1"
    },
    "singleProjectMode": true
  },
  "hosting": {
    "site": "muuqwear-6e2e0",
    "public": "hosting-wwwroot",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/_framework/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "**/*.@(js|css|webp|woff2)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "rewrites": [
      { "source": "/admin/**", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/muuqsimo/**", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/order-confirmed/**", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/_blazor/**", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/auth/**", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/__/auth/**", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/logout", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/api/**", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/community", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/help", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/careers", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/affiliate", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/shipping-return", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/design-history", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/partner-store", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "/error", "run": { "serviceId": "muuqwear-web", "region": "europe-west2" } },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
