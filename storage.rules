rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    match /products/{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /site/{path=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
