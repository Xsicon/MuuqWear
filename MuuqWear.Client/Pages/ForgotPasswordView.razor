@page "/forgot-password"
@layout ShopperAuthLayout
@implements IDisposable
@using MuuqWear.Application.Services.AuthService
@using MuuqWear.Application.Shared
@using MuuqWear.Model.Authentication
@inject IAuthService IAuthService
@inject NavigationManager NavigationManager
@inject IConfiguration Configuration

<PageTitle>Forgot Password</PageTitle>

<section class="mw-auth">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-12 col-sm-10 col-md-6 col-lg-4 mt-5">
                <div class="mw-auth-card text-center">
                    <a href="/">
                        <img href="/" src="/images/muuqwearlogo.png" class="mw-auth-logo mb-3" />
                    </a>
                    <h2 class="mw-auth-title">Forgot Password</h2>
                    <p class="mw-auth-subtitle mb-4">
                        Enter your email and we'll send you
                        a link to reset your password.
                    </p>

                    @if (!emailSent)
                    {
                        <div class="mb-3">
                            <input class="form-control mw-input"
                                   type="email"
                                   autocomplete="email"
                                   placeholder="Enter your email"
                                   @bind="email"
                                   @bind:event="oninput" />
                        </div>

                        <button type="button"
                                class="mw-btn-primary w-100"
                                @onclick="HandleForgotPassword"
                                disabled="@(isSubmitting || IsRateLimited)">
                            @if (isSubmitting)
                            {
                                <span class="mw-btn-spinner"></span>
                                <span>Sending...</span>
                            }
                            else if (IsRateLimited)
                            {
                                <span>Wait @cooldownSecondsRemaining s</span>
                            }
                            else
                            {
                                <span>Send Reset Link</span>
                            }
                        </button>

                        @if (!string.IsNullOrEmpty(errorMessage))
                        {
                            <div class="@errorMessageCssClass">
                                <span>@errorMessage</span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="mw-reset-success">
                            <div class="mw-reset-success__icon">✉</div>
                            <h6 class="mt-3 fw-bold">Check your email</h6>
                            <p class="mw-auth-subtitle">
                                If an account exists, a reset link was sent to
                                <strong>@email</strong>.
                            </p>
                            <p class="small text-muted mt-2">
                                Didn't receive it?
                                @if (IsRateLimited)
                                {
                                    <span>You can resend in @cooldownSecondsRemaining s.</span>
                                }
                                else
                                {
                                    <button class="mw-link-btn"
                                            @onclick="ResendEmail"
                                            disabled="@isSubmitting">
                                        Click to resend
                                    </button>
                                }
                            </p>
                        </div>
                    }

                    <p class="text-center mt-4 small">
                        Remember your password?
                        <a href="/login" class="mw-link">Sign in</a>
                    </p>

                </div>
            </div>
        </div>
    </div>
</section>

@code {
    private const int ClientCooldownSeconds = 60;

    private string email = string.Empty;
    private bool isSubmitting;
    private bool emailSent;
    private string errorMessage = string.Empty;
    private string errorMessageCssClass = "text-danger mt-3";
    private DateTime? nextAllowedAt;
    private int cooldownSecondsRemaining;
    private System.Threading.Timer? cooldownTimer;

    private bool IsRateLimited =>
        nextAllowedAt.HasValue && DateTime.UtcNow < nextAllowedAt.Value;

    private async Task HandleForgotPassword()
    {
        if (IsRateLimited)
            return;

        if (string.IsNullOrWhiteSpace(email))
        {
            errorMessage = "Please enter your email";
            return;
        }

        if (!MuuqWearUtils.IsValidEmail(email))
        {
            errorMessage = "Please enter a valid email address";
            return;
        }

        isSubmitting = true;
        errorMessage = string.Empty;
        StateHasChanged();

        var redirectTo = BuildResetRedirectUrl();
        var result = await IAuthService.SendPasswordReset(
            new ForgotPasswordModel
            {
                Email = email.Trim(),
                RedirectTo = redirectTo
            });

        // Enumeration-safe UX: show success unless the server explicitly rate-limits.
        if (result.Success
            || !result.Message.Contains("too many", StringComparison.OrdinalIgnoreCase))
        {
            emailSent = true;
            StartCooldown();
        }
        else
        {
            errorMessage = result.Message;
            StartCooldown();
        }

        isSubmitting = false;
    }

    private async Task ResendEmail()
    {
        if (IsRateLimited)
            return;

        errorMessage = string.Empty;
        await HandleForgotPassword();
    }

    private string BuildResetRedirectUrl()
    {
        var frontendBase = Configuration["FrontendBaseUrl"];
        if (!string.IsNullOrWhiteSpace(frontendBase)
            && Uri.TryCreate(frontendBase.Trim().TrimEnd('/'), UriKind.Absolute, out var configured))
        {
            return $"{configured.GetLeftPart(UriPartial.Authority)}/auth/reset-password";
        }

        var origin = NavigationManager.BaseUri.TrimEnd('/');
        return $"{origin}/auth/reset-password";
    }

    private void StartCooldown()
    {
        nextAllowedAt = DateTime.UtcNow.AddSeconds(ClientCooldownSeconds);
        cooldownSecondsRemaining = ClientCooldownSeconds;
        cooldownTimer?.Dispose();
        cooldownTimer = new System.Threading.Timer(_ =>
        {
            if (!nextAllowedAt.HasValue)
                return;

            var remaining = (int)Math.Ceiling((nextAllowedAt.Value - DateTime.UtcNow).TotalSeconds);
            if (remaining <= 0)
            {
                cooldownSecondsRemaining = 0;
                nextAllowedAt = null;
                cooldownTimer?.Dispose();
                cooldownTimer = null;
            }
            else
            {
                cooldownSecondsRemaining = remaining;
            }

            _ = InvokeAsync(StateHasChanged);
        }, null, TimeSpan.FromSeconds(1), TimeSpan.FromSeconds(1));
    }

    public void Dispose()
    {
        cooldownTimer?.Dispose();
    }
}
