@page "/verify-2fa"
@layout ShopperAuthLayout
@using MuuqWear.Application.Services.AuthService;
@using MuuqWear.Client.Auth
@inject IAuthService IAuthService;
@inject FirebaseSession FirebaseSession
@inject NavigationManager NavigationManager;
@inject AuthStateService AuthStateService
@inject IJSRuntime JS


@using MuuqWear.Application.Shared
@using MuuqWear.Model.Authentication

<section class="mw-auth">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-12 col-sm-10 col-md-6 col-lg-4">

                <div class="mw-auth-card text-center mw-auth-panel">

                    <img src="/images/muuqwearlogo.png" class="mw-auth-logo mb-3" />

                    <h2 class="mw-auth-title">Confirm your email</h2>

                    @if (string.IsNullOrEmpty(Email))
                    {
                        <p class="mw-auth-subtitle mb-4">
                            Create your account first, then we will send a confirmation link.
                        </p>
                        <a href="/register" class="mw-btn-primary w-100 d-inline-block">Go to register</a>
                    }
                    else
                    {
                    <p class="mw-auth-subtitle mb-4">
                        We sent a confirmation link to @Email.
                        Open it to finish creating your account.
                    </p>

                    <div class="@messageCssClass mb-3">
                        <span>@message</span>
                    </div>

                    <button type="button" class="mw-btn-primary w-100" disabled="@isResending" @onclick="ResendCode">
                        @(isResending ? "Sending..." : "Resend confirmation email")
                    </button>

                    <p class="mt-4 small">
                        Used the wrong email?
                        <a href="/register" class="mw-link">Edit details</a>
                    </p>
                    <p class="small">
                        Already confirmed?
                        <a href="/login" class="mw-link">Sign in</a>
                    </p>
                    }

                </div>

            </div>

        </div>

    </div>

</section>

@code {
    [Parameter]
    [SupplyParameterFromQuery]
    public string? Email { get; set; }

    string message = string.Empty;
    string messageCssClass = string.Empty;
    private bool isResending;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;

        if (string.IsNullOrEmpty(Email))
            Email = await AuthStateService.GetPendingEmailAsync();
        if (string.IsNullOrEmpty(Email))
        {
            try
            {
                Email = await JS.InvokeAsync<string?>("sessionStorage.getItem", SignupPending.StorageKey);
            }
            catch (JSException) { }
        }

        if (string.IsNullOrEmpty(Email))
            return;

        await AuthStateService.SetPendingEmailAsync(Email);
        StateHasChanged();
    }

    private async Task ResendCode()
    {
        if (string.IsNullOrWhiteSpace(Email) || isResending)
            return;

        isResending = true;
        message = string.Empty;
        StateHasChanged();

        var result = await FirebaseSession.SendEmailVerificationAsync();
        message = result.Ok
            ? "Confirmation email sent. Check your inbox."
            : result.Message ?? "Unable to send the confirmation email.";
        messageCssClass = result.Ok ? "text-success" : "text-danger";
        isResending = false;
    }
}
