@page "/wasm-smoke"
@rendermode InteractiveWebAssembly

<PageTitle>WASM smoke</PageTitle>

<section style="max-width:40rem;margin:3rem auto;padding:1.5rem;font-family:Segoe UI,sans-serif;">
    <p style="letter-spacing:.08em;text-transform:uppercase;font-size:.75rem;color:#4A5C7A;">Public app</p>
    <h1 style="margin:0 0 1rem;">WebAssembly is running</h1>
    <p>@PublicAppInfo.Slice</p>
    <p>This page rendered in the browser at <strong>@renderedAt</strong>.</p>
    <p><a href="/admin">Open admin</a> (still Blazor Server).</p>
</section>

@code {
    private string renderedAt = string.Empty;

    protected override void OnInitialized()
    {
        renderedAt = DateTime.Now.ToString("yyyy-MM-dd HH:mm:ss");
    }
}
