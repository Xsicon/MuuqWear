@page "/about"
@using MuuqWear.Model.Site

<PageTitle>About — MuuqWear</PageTitle>

<div class="about">
    <section class="about-hero">
        <div class="about-hero__text">
            <p class="about-eyebrow">Our story</p>
            <h1 class="about-hero__title">Our story</h1>
            <p class="about-hero__lede">@PageCopy.AboutStory</p>
        </div>
    </section>

    <section class="about-craft">
        <div class="about-craft__inner">
            <div class="about-craft__text">
                <p class="about-eyebrow">How we work</p>
                <h2 class="about-craft__title">How we work</h2>
                <p class="about-craft__body">@PageCopy.AboutWork</p>
            </div>
        </div>
    </section>

    <section class="about-quote">
        <div class="about-quote__inner">
            <p class="about-eyebrow">Our promise</p>
            <ul class="about-promise">
                <li>@PageCopy.AboutPromiseOne</li>
                <li>@PageCopy.AboutPromiseTwo</li>
                <li>@PageCopy.AboutPromiseThree</li>
            </ul>
        </div>
    </section>
</div>
