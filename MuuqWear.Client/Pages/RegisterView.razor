@page "/register"
@layout ShopperAuthLayout
@using MuuqWear.Model
@using MuuqWear.Model.Site
@using MuuqWear.Application.Services.AuthService;
@using MuuqWear.Client.Auth
@inject IJSRuntime JS
@inject IAuthService IAuthService;
@inject FirebaseSession FirebaseSession
@inject NavigationManager NavigationManager;
@inject AuthStateService AuthStateService
@inject IConfiguration Config


<PageTitle>Register</PageTitle>

<section class="mw-auth">

    <div class="container">

        <div class="row justify-content-center">

            <div class="col-12 col-md-8 col-lg-5">

                <div class="mw-auth-card">

                    <!-- LOGO -->
                    <div class="text-center mb-4">
                        <a href="/">
                        <img src="/images/muuqwearlogo.png" class="mw-auth-logo mb-3" />
                        </a>
                        @if (!showConfirm)
                        {
                            <h2 class="mw-auth-title mt-3">@PageCopy.SignUp</h2>
                            <p class="mw-auth-subtitle">
                                Join MuuqWear and explore premium essentials
                            </p>
                        }
                    </div>

                    @if (wasmReady)
                    {
                        <span id="mw-register-ready" hidden></span>
                    }
                    @if (writesFrozen)
                    {
                        <p class="text-danger text-center">@PageCopy.WritesPaused</p>
                    }
                    @if (showConfirm)
                    {
                    <div class="mw-auth-panel text-center" @key="confirmEmail">
                        <h2 class="mw-auth-title mt-3">Confirm your email</h2>
                        <p class="mw-auth-subtitle mb-4">
                            We sent a confirmation link@(string.IsNullOrEmpty(confirmEmail) ? "" : $" to {confirmEmail}").
                            Open it to finish creating your account.
                        </p>
                        <div class="@messageCssClass mb-3">
                            <span>@message</span>
                        </div>
                        <button type="button" class="mw-btn-primary w-100" disabled="@isBusy" @onclick="ResendConfirmation">
                            @(isBusy ? "Sending..." : "Resend confirmation email")
                        </button>
                        <p class="mt-4 small">
                            Used the wrong email?
                            <button type="button" class="mw-link-btn" @onclick="BackToForm">Edit details</button>
                        </p>
                        <p class="small mb-0">
                            Already confirmed?
                            <a href="/login" class="mw-link">Sign in</a>
                        </p>
                    </div>
                    }
                    else
                    {
                    <!-- FORM -->
                    <EditForm EditContext="registerContext" OnValidSubmit="HandleRegister" FormName="shopper-register" class="mw-auth-panel">

                        <DataAnnotationsValidator />

                        <!-- NAME -->
                        <div class="mb-3">
                            <label class="mw-label">Full Name</label>
                            <InputText class="form-control mw-input"
                                       @bind-Value="registerModel.FullName" />
                            <ValidationMessage For="@(() => registerModel.FullName)" />
                        </div>

                        <!-- EMAIL -->
                        <div class="mb-3">
                            <label class="mw-label">Email</label>
                            <InputText class="form-control mw-input"
                                       @bind-Value="registerModel.Email" />
                            <ValidationMessage For="@(() => registerModel.Email)" />
                        </div>

                        <!-- PASSWORD -->
                        <div class="mb-3">
                            <label class="mw-label">Password</label>
                            <input type="password"
                                   class="form-control mw-input @PasswordFieldClass"
                                   value="@registerModel.Password"
                                   @oninput="OnPasswordInput" />
                            <ValidationMessage For="@(() => registerModel.Password)" />

                            @* show meter only when user starts typing *@
                            @if (!string.IsNullOrEmpty(registerModel.Password))
                            {
                                <div class="mw-strength-bar">
                                    <div class="mw-strength-segment @(StrengthLevel >= 1 ? "active" : "")"
                                         style="@(StrengthLevel >= 1 ? $"background:{StrengthColor}" : "")">
                                    </div>
                                    <div class="mw-strength-segment @(StrengthLevel >= 2 ? "active" : "")"
                                         style="@(StrengthLevel >= 2 ? $"background:{StrengthColor}" : "")">
                                    </div>
                                    <div class="mw-strength-segment @(StrengthLevel >= 3 ? "active" : "")"
                                         style="@(StrengthLevel >= 3 ? $"background:{StrengthColor}" : "")">
                                    </div>
                                    <div class="mw-strength-segment @(StrengthLevel >= 4 ? "active" : "")"
                                         style="@(StrengthLevel >= 4 ? $"background:{StrengthColor}" : "")">
                                    </div>
                                </div>
                            }
                        </div>

                        <!-- CONFIRM PASSWORD -->
                        <div class="mb-4">
                            <label class="mw-label">Confirm Password</label>
                            <InputText type="password"
                                       class="form-control mw-input"
                                       @bind-Value="registerModel.ConfirmPassword" />
                            <ValidationMessage For="@(() => registerModel.ConfirmPassword)" />
                        </div>

                        <!-- SUBMIT -->
                        <button type="button" class="mw-btn-primary w-100" disabled="@isBusy" @onclick="SubmitRegister">
                            @(isBusy ? "Creating account..." : "Create Account")
                        </button>
                        <div class="@messageCssClass">
                            <span>@message</span>
                        </div>

                    </EditForm>
                    }

                    @if (!showConfirm)
                    {
                    <p class="text-center mt-4 small">
                        Already have an account?
                        <a href="/login" class="mw-link">Sign in</a>
                    </p>
                    }

                </div>

            </div>

        </div>

    </div>

</section>

