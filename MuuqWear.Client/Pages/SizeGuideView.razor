@page "/size-guide"
@using MuuqWear.Model.Products

<PageTitle>Size Guide — MuuqWear</PageTitle>

<section class="mw-sg-hero">
    <div class="container">
        <div class="row align-items-center g-4">
            <div class="col-12 col-md-7">
                <p class="mw-sg-label">Size Guide</p>
                <h1 class="mw-sg-title">Find your size</h1>
                <p class="mw-sg-desc">@SizeGuideData.Intro</p>
                <p class="mw-sg-desc">@SizeGuideData.FitNote</p>
                <button class="mw-sg-measure-btn" type="button" @onclick="OpenMeasurePanel">
                    How to measure
                </button>
            </div>
        </div>
    </div>
</section>

<section class="mw-sg-toggle-section">
    <div class="container">
        <div class="mw-sg-toggle">
            <span class="mw-sg-toggle-label @(!useCm ? "active" : "")">Inches</span>
            <button class="mw-sg-toggle-switch @(useCm ? "on" : "")"
                    type="button"
                    @onclick="ToggleUnit"
                    role="switch"
                    aria-checked="@useCm"
                    aria-label="Switch between inches and centimeters">
                <span class="mw-sg-toggle-thumb"></span>
            </button>
            <span class="mw-sg-toggle-label @(useCm ? "active" : "")">Centimeters</span>
        </div>
    </div>
</section>

<section class="mw-sg-tables">
    <div class="container">
        <div class="mw-sg-table-card mw-sg-chart">
            <h2 class="mw-sg-table-title">@(useCm ? "International size chart (cm)" : "US size chart (inches)")</h2>
            <p class="mw-sg-desc">@(useCm ? "Height in cm, weight in kg, garment measurements in cm." : "Height in feet/inches, weight in lbs, garment measurements in inches.")</p>
            <div class="mw-sg-chart__scroll">
                <table class="mw-sg-table">
                    <thead>
                        <tr>
                            <th>Size</th>
                            <th>Numeric</th>
                            <th>Height</th>
                            <th>Weight</th>
                            <th>Length</th>
                            <th>Chest</th>
                            <th>Bottom</th>
                            <th>Sleeve</th>
                            <th>Cuff</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var row in CurrentRows)
                        {
                            <tr>
                                <td class="mw-sg-size-cell">@row.Size</td>
                                <td>@row.Numeric</td>
                                <td>@row.Height</td>
                                <td>@row.Weight</td>
                                <td>@row.Length</td>
                                <td>@row.Chest</td>
                                <td>@row.Bottom</td>
                                <td>@row.Sleeve</td>
                                <td>@row.Cuff</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="mw-sg-notes">
            <h2 class="mw-sg-table-title">Fit notes</h2>
            <ul>
                @foreach (var note in SizeGuideData.FitNotes)
                {
                    <li>@note</li>
                }
            </ul>
            <p>@SizeGuideData.Help</p>
        </div>
    </div>
</section>

<div class="mw-sg-panel-overlay @(isPanelOpen ? "open" : "")" @onclick="CloseMeasurePanel">
    <div class="mw-sg-panel" @onclick:stopPropagation="true">
        <div class="mw-sg-panel-header">
            <h2 class="mw-sg-panel-title">How to measure</h2>
            <button class="mw-sg-panel-close" type="button" @onclick="CloseMeasurePanel" aria-label="Close">✕</button>
        </div>
        <div class="mw-sg-panel-body">
            @foreach (var guide in SizeGuideData.MeasurementGuides)
            {
                <div class="mw-sg-measure-item">
                    <h3 class="mw-sg-measure-title">@guide.Title</h3>
                    <p class="mw-sg-measure-desc">@guide.Description</p>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private bool useCm;
    private bool isPanelOpen;
    private List<GarmentSizeRow> CurrentRows => useCm ? SizeGuideData.Centimeters : SizeGuideData.Inches;
    private void ToggleUnit() => useCm = !useCm;
    private void OpenMeasurePanel() => isPanelOpen = true;
    private void CloseMeasurePanel() => isPanelOpen = false;
}
