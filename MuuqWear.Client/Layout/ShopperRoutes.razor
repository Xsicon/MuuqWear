@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(ClientAssemblyMarker).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(ShopperLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(ShopperLayout)">
            <PageTitle>Not found</PageTitle>
            <section class="container py-5 text-center">
                <h1 class="h3">That page is not here</h1>
                <p class="text-muted">The link may be old, or it belongs to a staff screen.</p>
                <a href="/">Back to home</a>
            </section>
        </LayoutView>
    </NotFound>
</Router>
