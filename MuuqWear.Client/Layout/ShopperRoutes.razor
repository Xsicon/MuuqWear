@using Microsoft.AspNetCore.Components.Routing

<Router AppAssembly="typeof(ClientAssemblyMarker).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="routeData" DefaultLayout="typeof(ShopperLayout)" />
    </Found>
    <NotFound>
        <LayoutView Layout="typeof(ShopperLayout)">
            <ShopperNotFound />
        </LayoutView>
    </NotFound>
</Router>
