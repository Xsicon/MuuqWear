@using MuuqWear.Model.Orders

<div class="mw-orders-list">
    @if (!Orders.Any())
    {
        <p class="mw-orders-list__empty">No orders yet.</p>
    }
    else
    {
        @foreach (var order in Orders)
        {
            var itemCount = order.Items?.Count ?? 0;
            <div class="mw-orders-list-item">
                <div class="mw-orders-list-item__main">
                    <p class="mw-orders-list-item__id">@order.OrderNumber</p>
                    <p class="mw-orders-list-item__meta">
                        @order.CreatedAt?.ToString("MMM d, yyyy")
                        @if (itemCount > 0)
                        {
                            <span> · @itemCount @(itemCount == 1 ? "item" : "items")</span>
                        }
                    </p>
                </div>
                <div class="mw-orders-list-item__aside">
                    <p class="mw-orders-list-item__price">$@order.Total.ToString("F2")</p>
                    <p class="mw-orders-list-item__status @OrderStatusDisplay.CssClass(order.Status)">
                        @OrderStatusDisplay.Format(order.Status)
                    </p>
                </div>
            </div>
        }
    }
</div>

@code {
    [Parameter] public List<OrderModel> Orders { get; set; } = new();
}
